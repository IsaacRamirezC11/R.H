Option Explicit

'==========================================================
' EXPORTAR BASE DE ACCESS A EXCEL
'
' TABLA:
'   AHORRO_SOLIDARIO
'
' ARCHIVO GENERADO:
'   baseExpo(fecha).xlsx
'
' EJEMPLO:
'   baseExpo(25-08-2026).xlsx
'
' EL ARCHIVO CONTIENE:
'   - TODOS LOS CAMPOS
'   - TODOS LOS REGISTROS
'   - INCLUYENDO EL ID
'
' NO EXPORTA FORMULAS NI DROPDOWNS.
' EXPORTA DIRECTAMENTE LOS DATOS DE ACCESS.
'
' CORRECCION DE FECHAS:
'   - Detecta campos Date/Time de Access.
'   - Convierte correctamente las fechas.
'   - Si Access entrega una fecha como texto,
'     se interpreta como DD/MM/YYYY.
'   - Las columnas de fecha se muestran como DD/MM/YYYY.
'   - Evita que aparezcan numeros seriales como 46327.
'
'==========================================================


Public Sub ExportarBaseAccess()

    Dim cn As Object
    Dim rs As Object

    Dim wbExpo As Workbook
    Dim wsExpo As Worksheet

    Dim ruta As String
    Dim nombreArchivo As String
    Dim archivoCompleto As String

    Dim fila As Long
    Dim columna As Long

    Dim fechaArchivo As String
    Dim valor As Variant

    Dim cantidadRegistros As Long
    Dim cantidadCampos As Long

    Dim respuesta As VbMsgBoxResult

    Dim i As Long

    Dim camposFecha As Object
    Dim nombreCampo As String


    On Error GoTo ErrorHandler


    '======================================================
    ' COMPROBAR QUE EL ARCHIVO PRINCIPAL ESTE GUARDADO
    '======================================================

    If ThisWorkbook.Path = "" Then

        MsgBox _
            "Primero debes guardar el archivo de Excel." & _
            vbCrLf & vbCrLf & _
            "El archivo exportado se guardará en la misma carpeta.", _
            vbExclamation, _
            "EXPORTAR BASE"

        Exit Sub

    End If


    '======================================================
    ' CONFIRMAR EXPORTACION
    '======================================================

    respuesta = _
        MsgBox( _
            "Se exportará toda la información de la base de datos." & _
            vbCrLf & vbCrLf & _
            "Tabla: AHORRO_SOLIDARIO" & _
            vbCrLf & _
            "Destino: misma carpeta del archivo actual." & _
            vbCrLf & vbCrLf & _
            "¿Deseas continuar?", _
            vbYesNo + _
            vbQuestion + _
            vbDefaultButton1, _
            "EXPORTAR BASE")


    If respuesta <> vbYes Then

        Exit Sub

    End If


    '======================================================
    ' DESACTIVAR EXCEL
    '======================================================

    Application.ScreenUpdating = False

    Application.EnableEvents = False

    Application.DisplayAlerts = False

    Application.StatusBar = _
        "Preparando exportación..."


    '======================================================
    ' ABRIR CONEXION A ACCESS
    '
    ' UTILIZA LA MISMA FUNCION QUE YA TIENES
    ' EN TU PROYECTO.
    '======================================================

    Set cn = AbrirConexionAccess()


    If cn Is Nothing Then

        GoTo Salir

    End If


    '======================================================
    ' CONSULTAR TODA LA TABLA
    '======================================================

    Set rs = _
        cn.Execute( _
            "SELECT * FROM [AHORRO_SOLIDARIO]")


    '======================================================
    ' COMPROBAR SI HAY DATOS
    '======================================================

    If rs.EOF Then

        MsgBox _
            "La tabla AHORRO_SOLIDARIO no contiene registros.", _
            vbInformation, _
            "EXPORTAR BASE"

        GoTo Salir

    End If


    '======================================================
    ' CREAR NUEVO LIBRO DE EXCEL
    '======================================================

    Set wbExpo = _
        Workbooks.Add(xlWBATWorksheet)


    Set wsExpo = _
        wbExpo.Worksheets(1)


    wsExpo.Name = "AHORRO_SOLIDARIO"


    '======================================================
    ' CREAR DICCIONARIO DE CAMPOS DE FECHA
    '
    ' Access:
    '
    ' 7 = adDate
    '
    ' También se consideran campos cuyo nombre contiene
    ' FECHA, por si la fecha está almacenada como texto.
    '======================================================

    Set camposFecha = _
        CreateObject("Scripting.Dictionary")

    camposFecha.CompareMode = 1


    '======================================================
    ' ESCRIBIR ENCABEZADOS
    '======================================================

    cantidadCampos = rs.Fields.Count


    For columna = 0 To cantidadCampos - 1

        nombreCampo = _
            Trim$( _
                CStr( _
                    rs.Fields(columna).Name))


        wsExpo.Cells(1, columna + 1).Value = _
            nombreCampo


        '--------------------------------------------------
        ' DETECTAR CAMPOS DATE/TIME DE ACCESS
        '
        ' Tipo 7 = Date
        '--------------------------------------------------

        If rs.Fields(columna).Type = 7 Then

            camposFecha(CStr(columna + 1)) = True

        ElseIf InStr( _
                    1, _
                    UCase$(nombreCampo), _
                    "FECHA", _
                    vbTextCompare) > 0 Then

            '------------------------------------------------
            ' SI EL CAMPO SE LLAMA FECHA PERO ACCESS LO
            ' ENTREGA COMO TEXTO, TAMBIEN LO TRATAMOS
            ' COMO FECHA.
            '------------------------------------------------

            camposFecha(CStr(columna + 1)) = True

        End If

    Next columna


    '======================================================
    ' ESCRIBIR DATOS
    '======================================================

    fila = 2

    cantidadRegistros = 0


    Do While Not rs.EOF


        For columna = 0 To cantidadCampos - 1


            '================================================
            ' OBTENER VALOR
            '================================================

            If IsNull( _
                rs.Fields(columna).Value) Then

                valor = ""

            Else

                valor = _
                    rs.Fields(columna).Value

            End If


            '================================================
            ' ESCRIBIR VALOR
            '================================================

            If IsError(valor) Then

                wsExpo.Cells( _
                    fila, _
                    columna + 1).Value = ""


            ElseIf camposFecha.Exists( _
                        CStr(columna + 1)) Then

                '================================================
                ' CAMPO DE FECHA
                '
                ' SI ES UNA FECHA REAL DE ACCESS:
                '     SE CONSERVA COMO FECHA.
                '
                ' SI VIENE COMO TEXTO:
                '     SE CONVIERTE EXPLICITAMENTE COMO
                '     DD/MM/YYYY.
                '================================================

                If Trim$(CStr(valor)) = "" Then

                    wsExpo.Cells( _
                        fila, _
                        columna + 1).Value = ""


                ElseIf VarType(valor) = vbDate Then

                    wsExpo.Cells( _
                        fila, _
                        columna + 1).Value = _
                            CDate(valor)


                Else

                    Dim fechaConvertida As Variant

                    fechaConvertida = _
                        ConvertirFechaAccess(valor)


                    If IsDate(fechaConvertida) Then

                        wsExpo.Cells( _
                            fila, _
                            columna + 1).Value = _
                                CDate(fechaConvertida)

                    Else

                        '----------------------------------------
                        ' SI NO SE PUDO CONVERTIR,
                        ' SE CONSERVA EL VALOR ORIGINAL.
                        '----------------------------------------

                        wsExpo.Cells( _
                            fila, _
                            columna + 1).Value = _
                                valor

                    End If

                End If


            Else

                '================================================
                ' CAMPO NORMAL
                '================================================

                wsExpo.Cells( _
                    fila, _
                    columna + 1).Value = _
                        valor

            End If


        Next columna


        cantidadRegistros = _
            cantidadRegistros + 1


        fila = fila + 1


        '--------------------------------------------------
        ' ACTUALIZAR ESTADO
        '--------------------------------------------------

        If cantidadRegistros Mod 100 = 0 Then

            Application.StatusBar = _
                "Exportando registro " & _
                cantidadRegistros & "..."

            DoEvents

        End If


        rs.MoveNext


    Loop


    '======================================================
    ' FORMATO DE FECHAS
    '
    ' TODAS LAS COLUMNAS DETECTADAS COMO FECHA SE
    ' MOSTRARAN COMO:
    '
    ' DD/MM/YYYY
    '
    ' EJEMPLO:
    '
    ' 01/08/2026
    ' 08/11/2026
    ' 03/01/2017
    '
    ' Y NO:
    '
    ' 08/01/2026
    ' 46327
    ' 46260
    '======================================================

    Dim claveFecha As Variant
    Dim columnaFecha As Long


    For Each claveFecha In camposFecha.Keys

        columnaFecha = _
            CLng(claveFecha)


        wsExpo.Columns(columnaFecha).NumberFormat = _
            "dd/mm/yyyy"

    Next claveFecha


    '======================================================
    ' FORMATO BASICO
    '
    ' SOLO PARA FACILITAR LA LECTURA.
    ' NO MODIFICA LOS DATOS.
    '======================================================

    With wsExpo

        .Rows(1).Font.Bold = True

        .Rows(1).AutoFilter

        .Cells.EntireColumn.AutoFit

    End With


    '======================================================
    ' GENERAR NOMBRE
    '
    ' EJEMPLO:
    '
    ' baseExpo(25-08-2026).xlsx
    '======================================================

    fechaArchivo = _
        Format(Date, "dd-mm-yyyy")


    nombreArchivo = _
        "baseExpo(" & _
        fechaArchivo & _
        ").xlsx"


    ruta = _
        ThisWorkbook.Path & "\"


    archivoCompleto = _
        ruta & nombreArchivo


    '======================================================
    ' SI YA EXISTE, CREAR NOMBRE ALTERNATIVO
    '
    ' baseExpo(25-08-2026).xlsx
    ' baseExpo(25-08-2026)_1.xlsx
    ' baseExpo(25-08-2026)_2.xlsx
    '======================================================

    i = 1


    Do While Dir(archivoCompleto) <> ""

        archivoCompleto = _
            ruta & _
            "baseExpo(" & _
            fechaArchivo & _
            ")_" & _
            i & _
            ".xlsx"


        i = i + 1

    Loop


    '======================================================
    ' GUARDAR XLSX
    '======================================================

    Application.StatusBar = _
        "Guardando archivo..."


    wbExpo.SaveAs _
        Filename:=archivoCompleto, _
        FileFormat:=xlOpenXMLWorkbook


    '======================================================
    ' CERRAR ARCHIVO EXPORTADO
    '======================================================

    wbExpo.Close _
        SaveChanges:=False


    Set wbExpo = Nothing

    Set wsExpo = Nothing


    '======================================================
    ' MENSAJE FINAL
    '======================================================

    MsgBox _
        "EXPORTACION COMPLETADA CORRECTAMENTE." & _
        vbCrLf & vbCrLf & _
        "Registros exportados: " & _
        cantidadRegistros & _
        vbCrLf & _
        "Campos exportados: " & _
        cantidadCampos & _
        vbCrLf & vbCrLf & _
        "Archivo:" & _
        vbCrLf & _
        nombreArchivo & _
        vbCrLf & vbCrLf & _
        "Ubicación:" & _
        vbCrLf & _
        ruta, _
        vbInformation, _
        "EXPORTAR BASE"


Salir:

    On Error Resume Next


    If Not rs Is Nothing Then

        rs.Close

    End If


    If Not cn Is Nothing Then

        cn.Close

    End If


    Set rs = Nothing

    Set cn = Nothing

    Set camposFecha = Nothing


    Application.StatusBar = False

    Application.DisplayAlerts = True

    Application.EnableEvents = True

    Application.ScreenUpdating = True

    Exit Sub


ErrorHandler:

    On Error Resume Next


    If Not wbExpo Is Nothing Then

        wbExpo.Close _
            SaveChanges:=False

    End If


    Application.StatusBar = False

    Application.DisplayAlerts = True

    Application.EnableEvents = True

    Application.ScreenUpdating = True


    MsgBox _
        "ERROR AL EXPORTAR LA BASE." & _
        vbCrLf & vbCrLf & _
        "Número: " & Err.Number & _
        vbCrLf & _
        "Descripción: " & Err.Description, _
        vbCritical, _
        "ERROR DE EXPORTACION"


End Sub


'==========================================================
' CONVERTIR FECHA DE ACCESS
'
' ESTA FUNCION EVITA QUE VBA/EXCEL INTERPRETE:
'
' 01/08/2026
'
' COMO:
'
' 08/01/2026
'
' LA FECHA SE INTERPRETA COMO:
'
' DIA / MES / AÑO
'
'==========================================================

Private Function ConvertirFechaAccess( _
    ByVal valor As Variant) As Variant


    Dim texto As String

    Dim partes As Variant

    Dim dia As Long
    Dim mes As Long
    Dim anio As Long

    Dim fechaTexto As String

    Dim posicionEspacio As Long
    Dim posicionT As Long


    On Error GoTo NoEsFecha


    '======================================================
    ' SI YA ES UNA FECHA REAL
    '======================================================

    If VarType(valor) = vbDate Then

        ConvertirFechaAccess = _
            CDate(valor)

        Exit Function

    End If


    '======================================================
    ' CONVERTIR A TEXTO
    '======================================================

    texto = _
        Trim$( _
            CStr(valor))


    If texto = "" Then

        ConvertirFechaAccess = ""

        Exit Function

    End If


    '======================================================
    ' QUITAR HORA
    '
    ' EJEMPLO:
    '
    ' 01/08/2026 00:00:00
    '
    ' QUEDA:
    '
    ' 01/08/2026
    '======================================================

    posicionEspacio = _
        InStr(1, texto, " ")


    If posicionEspacio > 0 Then

        texto = _
            Left$( _
                texto, _
                posicionEspacio - 1)

    End If


    posicionT = _
        InStr(1, texto, "T")


    If posicionT > 0 Then

        texto = _
            Left$( _
                texto, _
                posicionT - 1)

    End If


    '======================================================
    ' CAMBIAR GUIONES POR /
    '======================================================

    texto = _
        Replace( _
            texto, _
            "-", _
            "/")


    '======================================================
    ' SEPARAR
    '======================================================

    partes = _
        Split(texto, "/")


    If UBound(partes) <> 2 Then

        GoTo NoEsFecha

    End If


    '======================================================
    ' DETECTAR FORMATO
    '
    ' NORMAL:
    '
    ' DD/MM/YYYY
    '
    ' TAMBIEN SOPORTA:
    '
    ' YYYY/MM/DD
    '======================================================

    If Len(Trim$(partes(0))) = 4 Then

        '----------------------------------------------
        ' YYYY/MM/DD
        '----------------------------------------------

        anio = _
            CLng(Trim$(partes(0)))

        mes = _
            CLng(Trim$(partes(1)))

        dia = _
            CLng(Trim$(partes(2)))


    Else

        '----------------------------------------------
        ' DD/MM/YYYY
        '----------------------------------------------

        dia = _
            CLng(Trim$(partes(0)))

        mes = _
            CLng(Trim$(partes(1)))

        anio = _
            CLng(Trim$(partes(2)))

    End If


    '======================================================
    ' VALIDAR
    '======================================================

    If dia < 1 Or dia > 31 Then

        GoTo NoEsFecha

    End If


    If mes < 1 Or mes > 12 Then

        GoTo NoEsFecha

    End If


    If anio < 1900 Or anio > 2100 Then

        GoTo NoEsFecha

    End If


    '======================================================
    ' CREAR FECHA SIN INTERPRETACION REGIONAL
    '======================================================

    ConvertirFechaAccess = _
        DateSerial( _
            anio, _
            mes, _
            dia)


    Exit Function


NoEsFecha:

    ConvertirFechaAccess = valor


End Function



