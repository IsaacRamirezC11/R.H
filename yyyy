'====================================================
' AGREGAR NUEVO NOMBRE AL DESPLEGABLE REVISO
'====================================================

AgregarNombreReviso ws.Cells(fila, 36)

'========================================================
' AGREGAR NOMBRE NUEVO AL DESPLEGABLE DE REVISO
'========================================================

Private Sub AgregarNombreReviso(ByVal celda As Range)

    Dim formulaLista As String
    Dim listaActual As String
    Dim nombreNuevo As String
    Dim nombres() As String
    Dim i As Long
    Dim existe As Boolean
    Dim nuevaLista As String

    On Error GoTo Salir

    nombreNuevo = Trim(UCase(CStr(celda.Value)))

    If nombreNuevo = "" Then Exit Sub

    '-----------------------------------------------
    ' OBTENER LA LISTA ACTUAL DEL DESPLEGABLE
    '-----------------------------------------------

    With celda.Validation

        If .Type <> xlValidateList Then Exit Sub

        formulaLista = .Formula1

    End With

    '-----------------------------------------------
    ' SOLO FUNCIONA SI LOS NOMBRES ESTÁN ESCRITOS
    ' DIRECTAMENTE EN EL ORIGEN DE LA VALIDACIÓN
    '-----------------------------------------------

    If Left(formulaLista, 1) = "=" Then Exit Sub

    listaActual = formulaLista

    '-----------------------------------------------
    ' SEPARAR LOS NOMBRES
    '-----------------------------------------------

    nombres = Split(listaActual, ",")

    '-----------------------------------------------
    ' COMPROBAR SI YA EXISTE
    '-----------------------------------------------

    For i = LBound(nombres) To UBound(nombres)

        If Trim(UCase(nombres(i))) = nombreNuevo Then

            existe = True
            Exit For

        End If

    Next i

    If existe Then Exit Sub

    '-----------------------------------------------
    ' AGREGAR EL NUEVO NOMBRE
    '-----------------------------------------------

    If listaActual <> "" Then
        nuevaLista = listaActual & "," & nombreNuevo
    Else
        nuevaLista = nombreNuevo
    End If

    '-----------------------------------------------
    ' ACTUALIZAR EL DESPLEGABLE
    '-----------------------------------------------

    With celda.Validation

        .Delete

        .Add Type:=xlValidateList, _
             AlertStyle:=xlValidAlertStop, _
             Operator:=xlBetween, _
             Formula1:=nuevaLista

        .IgnoreBlank = True
        .InCellDropdown = True
        .ShowInput = True
        .ShowError = True

    End With

Salir:

End Sub