import os
from openpyxl import load_workbook

ARCHIVO_BASE = "Ahorro Solidario Actual_1641_Correcto(36).xlsx"
ARCHIVO_NORMALIZACION = "normalizacion_rh_v3_3_FINAL.xlsx"
ARCHIVO_SALIDA = "Ahorro Solidario Actual_1641_Correcto(36)_NORMALIZADO.xlsx"

HOJA_BASE = None
HOJA_RESULTADOS = "RESULTADOS"
ESPACIOS_NO_ENCONTRADO = "   "


def buscar_columna(ws, nombre):
    for celda in ws[1]:
        if str(celda.value).strip().upper() == nombre.upper():
            return celda.column
    raise ValueError(f'No se encontró "{nombre}" en "{ws.title}".')


def limpiar(valor):
    if valor is None:
        return ""
    return str(valor).strip().upper()


def hom_valido(valor):
    return limpiar(valor) not in {
        "", "-", "--", "#N/D", "#N/A", "N/A", "NA",
        "NAN", "NONE", "NULL", "0", "0.0"
    }


def nivel_valido(valor):
    texto = limpiar(valor).replace(" ", "")
    return (
        len(texto) == 3
        and sum(c.isalpha() for c in texto) == 2
        and sum(c.isdigit() for c in texto) == 1
    )


def ur_valida(valor):
    texto = limpiar(valor)
    if texto.endswith(".0") and texto[:-2].isdigit():
        texto = texto[:-2]
    return texto.isdigit() and len(texto) == 3


def preparar_ur(valor):
    texto = limpiar(valor)
    if texto.endswith(".0") and texto[:-2].isdigit():
        texto = texto[:-2]
    if texto.isdigit() and len(texto) < 3:
        texto = texto.zfill(3)
    return texto


def no_encontrado(valor):
    return valor is None or str(valor) == ESPACIOS_NO_ENCONTRADO or limpiar(valor) == ""


def main():
    print("=" * 70)
    print("       APLICADOR DIRECTO - AHORRO SOLIDARIO V2")
    print("=" * 70)

    if not os.path.exists(ARCHIVO_BASE):
        raise FileNotFoundError(f"No se encontró: {ARCHIVO_BASE}")
    if not os.path.exists(ARCHIVO_NORMALIZACION):
        raise FileNotFoundError(f"No se encontró: {ARCHIVO_NORMALIZACION}")

    print("\n[1/5] Abriendo base principal...")
    wb_base = load_workbook(ARCHIVO_BASE, read_only=False, data_only=False)

    print("[2/5] Abriendo resultados...")
    wb_norm = load_workbook(
        ARCHIVO_NORMALIZACION,
        read_only=True,
        data_only=True
    )

    ws_base = wb_base[
        wb_base.sheetnames[0] if HOJA_BASE is None else HOJA_BASE
    ]
    ws_resultados = wb_norm[HOJA_RESULTADOS]

    print(f"      Hoja principal: {ws_base.title}")

    print("[3/5] Localizando columnas...")

    base_cols = {
        "HOM": buscar_columna(ws_base, "HOM"),
        "Nivel": buscar_columna(ws_base, "Nivel"),
        "UR": buscar_columna(ws_base, "UR"),
    }

    result_cols = {
        "FILA_EXCEL": buscar_columna(ws_resultados, "FILA_EXCEL"),
        "HOM_ENCONTRADA": buscar_columna(ws_resultados, "HOM_ENCONTRADA"),
        "NIVEL_ENCONTRADO": buscar_columna(ws_resultados, "NIVEL_ENCONTRADO"),
        "UR_ENCONTRADA": buscar_columna(ws_resultados, "UR_ENCONTRADA"),
    }

    print("[4/5] Aplicando resultados...")
    print("      No encontrado = exactamente 3 espacios.")

    procesadas = 0
    hom_ok = nivel_ok = ur_ok = 0
    hom_nf = nivel_nf = ur_nf = 0

    for fila in ws_resultados.iter_rows(min_row=2, values_only=True):
        fila_excel = fila[result_cols["FILA_EXCEL"] - 1]
        if fila_excel is None:
            continue

        fila_excel = int(fila_excel)
        procesadas += 1

        if procesadas % 100 == 0:
            print(f"      Procesadas: {procesadas:,}", flush=True)

        # ---------- HOM ----------
        celda = ws_base.cell(fila_excel, base_cols["HOM"])
        if not hom_valido(celda.value):
            encontrado = fila[result_cols["HOM_ENCONTRADA"] - 1]

            if no_encontrado(encontrado):
                celda.value = ESPACIOS_NO_ENCONTRADO
                hom_nf += 1
            else:
                nuevo = str(encontrado).split(" / ")[0].strip()
                if nuevo:
                    celda.value = nuevo.upper()
                    hom_ok += 1
                else:
                    celda.value = ESPACIOS_NO_ENCONTRADO
                    hom_nf += 1

        # ---------- NIVEL ----------
        celda = ws_base.cell(fila_excel, base_cols["Nivel"])
        if not nivel_valido(celda.value):
            encontrado = fila[result_cols["NIVEL_ENCONTRADO"] - 1]

            if no_encontrado(encontrado):
                celda.value = ESPACIOS_NO_ENCONTRADO
                nivel_nf += 1
            else:
                nuevo = str(encontrado).split(" / ")[0].strip()
                if nivel_valido(nuevo):
                    celda.value = nuevo.upper()
                    nivel_ok += 1
                else:
                    celda.value = ESPACIOS_NO_ENCONTRADO
                    nivel_nf += 1

        # ---------- UR ----------
        celda = ws_base.cell(fila_excel, base_cols["UR"])
        if not ur_valida(celda.value):
            encontrado = fila[result_cols["UR_ENCONTRADA"] - 1]

            if no_encontrado(encontrado):
                celda.value = ESPACIOS_NO_ENCONTRADO
                ur_nf += 1
            else:
                nuevo = preparar_ur(
                    str(encontrado).split(" / ")[0].strip()
                )
                if ur_valida(nuevo):
                    celda.value = nuevo
                    ur_ok += 1
                else:
                    celda.value = ESPACIOS_NO_ENCONTRADO
                    ur_nf += 1

    print("\n[5/5] Guardando copia final...")
    wb_base.save(ARCHIVO_SALIDA)
    wb_base.close()
    wb_norm.close()

    print("\n" + "=" * 70)
    print("                 TERMINADO")
    print("=" * 70)
    print(f"Filas procesadas:       {procesadas:,}")
    print(f"HOM actualizadas:       {hom_ok:,}")
    print(f"HOM no encontradas:     {hom_nf:,}")
    print(f"Nivel actualizados:     {nivel_ok:,}")
    print(f"Nivel no encontrados:   {nivel_nf:,}")
    print(f"UR actualizadas:        {ur_ok:,}")
    print(f"UR no encontradas:      {ur_nf:,}")
    print()
    print(f"Archivo generado:")
    print(ARCHIVO_SALIDA)
    print()
    print("SOLO se modificaron HOM, Nivel y UR.")
    print("Los campos sin coincidencia contienen exactamente 3 espacios.")
    print("La base original no fue sobrescrita.")
    print("=" * 70)


if __name__ == "__main__":
    try:
        main()
    except PermissionError:
        print("\nERROR: cierra los archivos de Excel antes de ejecutar.")
    except Exception as error:
        print("\nERROR:")
        print(error)
