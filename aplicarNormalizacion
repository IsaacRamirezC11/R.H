import os
import re
from openpyxl import load_workbook

# ==========================================================
# APLICAR NORMALIZACION YA GENERADA
#
# NO vuelve a ejecutar la normalización.
#
# Toma:
#   1. pruebapy2.xlsx
#   2. archivo de resultados de la normalización
#
# Y genera:
#   pruebapy2_NORMALIZADA.xlsx
#
# SOLO modifica:
#   HOM
#   Nivel
#   UR
#
# TODAS LAS DEMAS COLUMNAS SE CONSERVAN.
# ==========================================================


# ==========================================================
# ARCHIVOS
# ==========================================================

ARCHIVO_BASE = "pruebapy2.xlsx"

# CAMBIA ESTE NOMBRE SI TU ARCHIVO DE RESULTADOS
# TIENE OTRO NOMBRE.
ARCHIVO_NORMALIZACION = "normalizacion_rh_v3_3_FINAL.xlsx"

ARCHIVO_SALIDA = "pruebapy2_NORMALIZADA.xlsx"

# Si "vacios" es la hoja principal, déjalo así.
HOJA_BASE = "vacios"

# Hoja creada por nuestro normalizador.
HOJA_APLICAR = "APLICAR"


# ==========================================================
# FUNCIONES
# ==========================================================

def buscar_columna(ws, nombre):

    for celda in ws[1]:

        if str(celda.value).strip().upper() == nombre.upper():
            return celda.column

    raise ValueError(
        f'No se encontró la columna "{nombre}" '
        f'en la hoja "{ws.title}".'
    )


def nivel_valido(valor):

    if valor is None:
        return False

    texto = str(valor).strip().upper()
    texto = texto.replace(" ", "")

    # Debe tener exactamente 3 caracteres
    if not re.fullmatch(r"[A-Z0-9]{3}", texto):
        return False

    letras = sum(
        caracter.isalpha()
        for caracter in texto
    )

    numeros = sum(
        caracter.isdigit()
        for caracter in texto
    )

    return letras == 2 and numeros == 1


def ur_valida(valor):

    if valor is None:
        return False

    texto = str(valor).strip()

    # Excel puede convertir 007 en 7.0
    if re.fullmatch(r"\d+\.0", texto):
        texto = texto[:-2]

    return bool(
        re.fullmatch(r"\d{3}", texto)
    )


def hom_vacio(valor):

    if valor is None:
        return True

    texto = str(valor).strip().upper()

    return texto in {
        "",
        "-",
        "--",
        "#N/D",
        "#N/A",
        "N/A",
        "NA",
        "NAN",
        "NONE",
        "NULL",
        "0",
        "0.0"
    }


# ==========================================================
# PROGRAMA PRINCIPAL
# ==========================================================

def main():

    print("=" * 65)
    print("       APLICAR NORMALIZACION YA GENERADA")
    print("=" * 65)

    # ------------------------------------------------------
    # COMPROBAR ARCHIVOS
    # ------------------------------------------------------

    if not os.path.exists(ARCHIVO_BASE):

        raise FileNotFoundError(
            f'No se encontró "{ARCHIVO_BASE}".'
        )

    if not os.path.exists(ARCHIVO_NORMALIZACION):

        raise FileNotFoundError(
            f'No se encontró "{ARCHIVO_NORMALIZACION}".'
        )


    # ------------------------------------------------------
    # ABRIR ARCHIVOS
    # ------------------------------------------------------

    print("\nAbriendo archivos...")

    wb_base = load_workbook(
        ARCHIVO_BASE
    )

    wb_normalizacion = load_workbook(
        ARCHIVO_NORMALIZACION,
        read_only=True,
        data_only=True
    )


    # ------------------------------------------------------
    # COMPROBAR HOJAS
    # ------------------------------------------------------

    if HOJA_BASE not in wb_base.sheetnames:

        raise ValueError(
            f'No existe la hoja "{HOJA_BASE}" '
            f'en {ARCHIVO_BASE}.'
        )

    if HOJA_APLICAR not in wb_normalizacion.sheetnames:

        raise ValueError(
            f'No existe la hoja "{HOJA_APLICAR}" '
            f'en {ARCHIVO_NORMALIZACION}.'
        )


    ws_base = wb_base[HOJA_BASE]

    ws_aplicar = wb_normalizacion[
        HOJA_APLICAR
    ]


    print(
        f"\nHoja principal: {HOJA_BASE}"
    )

    print(
        f"Hoja de cambios: {HOJA_APLICAR}"
    )


    # ======================================================
    # LOCALIZAR COLUMNAS EN LA BASE
    # ======================================================

    columna_hom = buscar_columna(
        ws_base,
        "HOM"
    )

    columna_nivel = buscar_columna(
        ws_base,
        "Nivel"
    )

    columna_ur = buscar_columna(
        ws_base,
        "UR"
    )


    # ======================================================
    # LOCALIZAR COLUMNAS EN APLICAR
    # ======================================================

    columna_fila = buscar_columna(
        ws_aplicar,
        "FILA_EXCEL"
    )

    columna_hom_nueva = buscar_columna(
        ws_aplicar,
        "HOM_NUEVA"
    )

    columna_nivel_nuevo = buscar_columna(
        ws_aplicar,
        "NIVEL_NUEVO"
    )

    columna_ur_nueva = buscar_columna(
        ws_aplicar,
        "UR_NUEVA"
    )


    # ======================================================
    # CONTADORES
    # ======================================================

    cambios_hom = 0
    cambios_nivel = 0
    cambios_ur = 0

    filas_procesadas = 0


    # ======================================================
    # APLICAR CAMBIOS
    # ======================================================

    print("\nAplicando resultados...")
    print("NO se vuelve a ejecutar la normalización.")
    print("Solo se aplican los valores ya encontrados.\n")


    for fila in ws_aplicar.iter_rows(
        min_row=2,
        values_only=True
    ):

        # --------------------------------------------------
        # FILA ORIGINAL DE EXCEL
        # --------------------------------------------------

        fila_excel = fila[
            columna_fila - 1
        ]

        if fila_excel is None:
            continue

        fila_excel = int(
            fila_excel
        )

        filas_procesadas += 1


        # ==================================================
        # HOM
        # ==================================================

        hom_nueva = fila[
            columna_hom_nueva - 1
        ]

        if (
            hom_nueva is not None
            and str(hom_nueva).strip() != ""
            and str(hom_nueva) != "   "
        ):

            celda_hom = ws_base.cell(
                fila_excel,
                columna_hom
            )

            # Solo sustituimos si HOM está faltante
            if hom_vacio(
                celda_hom.value
            ):

                celda_hom.value = (
                    str(hom_nueva)
                    .strip()
                    .upper()
                )

                cambios_hom += 1


        # ==================================================
        # NIVEL
        # ==================================================

        nivel_nuevo = fila[
            columna_nivel_nuevo - 1
        ]

        if (
            nivel_nuevo is not None
            and str(nivel_nuevo) != "   "
            and nivel_valido(
                nivel_nuevo
            )
        ):

            celda_nivel = ws_base.cell(
                fila_excel,
                columna_nivel
            )

            # Solo sustituimos si el Nivel actual
            # no es válido.
            if not nivel_valido(
                celda_nivel.value
            ):

                celda_nivel.value = (
                    str(nivel_nuevo)
                    .strip()
                    .upper()
                )

                cambios_nivel += 1


        # ==================================================
        # UR
        # ==================================================

        ur_nueva = fila[
            columna_ur_nueva - 1
        ]

        if (
            ur_nueva is not None
            and str(ur_nueva) != "   "
            and ur_valida(
                ur_nueva
            )
        ):

            celda_ur = ws_base.cell(
                fila_excel,
                columna_ur
            )

            # Solo sustituimos si UR actual
            # no es válida.
            if not ur_valida(
                celda_ur.value
            ):

                texto_ur = (
                    str(ur_nueva)
                    .strip()
                )

                # Recuperar ceros a la izquierda
                if (
                    texto_ur.isdigit()
                    and len(texto_ur) < 3
                ):

                    texto_ur = texto_ur.zfill(3)

                celda_ur.value = texto_ur

                cambios_ur += 1


    # ======================================================
    # GUARDAR
    # ======================================================

    print("\nGuardando copia normalizada...")

    wb_base.save(
        ARCHIVO_SALIDA
    )

    wb_base.close()
    wb_normalizacion.close()


    # ======================================================
    # RESULTADO
    # ======================================================

    print("\n")
    print("=" * 65)
    print("             PROCESO TERMINADO")
    print("=" * 65)

    print(
        f"Filas procesadas:   {filas_procesadas:,}"
    )

    print(
        f"HOM actualizadas:   {cambios_hom:,}"
    )

    print(
        f"Nivel actualizados: {cambios_nivel:,}"
    )

    print(
        f"UR actualizadas:    {cambios_ur:,}"
    )

    print(
        f"TOTAL CAMBIOS:      "
        f"{cambios_hom + cambios_nivel + cambios_ur:,}"
    )

    print()

    print(
        f"Archivo generado:"
    )

    print(
        ARCHIVO_SALIDA
    )

    print()

    print(
        "La base original NO fue sobrescrita."
    )

    print(
        "Solo se modificaron HOM, Nivel y UR."
    )

    print(
        "Las demás columnas permanecen intactas."
    )

    print("=" * 65)


# ==========================================================
# EJECUCIÓN
# ==========================================================

if __name__ == "__main__":

    try:

        main()

    except PermissionError:

        print(
            "\nERROR:"
        )

        print(
            "Cierra los archivos de Excel "
            "antes de ejecutar el programa."
        )

    except Exception as error:

        print(
            "\nERROR:"
        )

        print(
            error
        )