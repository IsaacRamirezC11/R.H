Option Explicit

'==========================================================
' MODIMPORTAR
'==========================================================
'
' IMPORTACION DE ARCHIVOS EXCEL
'
' REGLA:
'
' 1. Busca automaticamente la fila de encabezados.
' 2. Compara los encabezados del archivo externo
'    contra los encabezados reales de REGISTRAR.
' 3. SOLO copia encabezados que existan en ambos.
' 4. NO crea equivalencias.
' 5. NO convierte QUINCENA en QNA.
' 6. NO convierte CICLO en AÑO.
' 7. NO importa ID.
' 8. Usa RFC como identificador principal.
' 9. CURP se utiliza como apoyo.
' 10. QUINCENA + CICLO solamente se usan para
'     comparar si el registro externo es más reciente.
' 11. Los registros nuevos se mandan a REGISTRAR.
' 12. No modifica Access directamente.
' 13. Guarda el rango de la ultima importacion.
' 14. Permite limpiar SOLO esa ultima importacion.
'
'==========================================================


Private Const HOJA_REGISTRAR As String = "REGISTRAR"

Private Const TABLA_ACCESS As String = "MOVIMIENTOS"


'==========================================================
' MACRO PRINCIPAL
'==========================================================

Public Sub ImportarArchivoExterno()

    Dim fd As FileDialog
    Dim ruta As String
    Dim extension As String

    On Error GoTo ErrorHandler

    Set fd = Application.FileDialog( _
        msoFileDialogFilePicker)

    With fd

        .Title = "Seleccionar archivo para importar"

        .AllowMultiSelect = False

        .Filters.Clear

        .Filters.Add _
            "Archivos Excel", _
            "*.xlsx;*.xls;*.xlsm"

        .Filters.Add _
            "Archivos PDF", _
            "*.pdf"

        If .Show <> -1 Then Exit Sub

        ruta = .SelectedItems(1)

    End With

    extension = LCase$( _
        Mid$( _
            ruta, _
            InStrRev(ruta, ".") + 1))

    Select Case extension

        Case "xlsx", "xls", "xlsm"

            ImportarExcel ruta

        Case "pdf"

            MsgBox _
                "El archivo seleccionado es PDF." & vbCrLf & vbCrLf & _
                "La lectura automatica de PDF todavia no esta habilitada.", _
                vbInformation, _
                "IMPORTAR"

        Case Else

            MsgBox _
                "El formato seleccionado no es compatible.", _
                vbExclamation, _
                "IMPORTAR"

    End Select

    Exit Sub

ErrorHandler:

    MsgBox _
        "ERROR AL SELECCIONAR EL ARCHIVO." & vbCrLf & vbCrLf & _
        "Numero: " & Err.Number & vbCrLf & _
        "Descripcion: " & Err.Description, _
        vbCritical, _
        "IMPORTAR"

End Sub


'==========================================================
' IMPORTAR EXCEL
'==========================================================

Private Sub ImportarExcel(ByVal ruta As String)

    Dim wb As Workbook
    Dim wsOrigen As Worksheet
    Dim wsDestino As Worksheet

    Dim filaEncabezados As Long
    Dim ultimaFila As Long
    Dim ultimaColumna As Long

    Dim mapaOrigen As Object
    Dim mapaDestino As Object

    Dim fila As Long
    Dim filaDestino As Long

    Dim registrosAgregados As Long
    Dim registrosIgnorados As Long

    Dim rfc As String
    Dim curp As String

    Dim qnaExterna As Long
    Dim cicloExterno As Long

    Dim qnaAccess As Long
    Dim cicloAccess As Long

    Dim existe As Boolean

    On Error GoTo ErrorHandler

    Application.ScreenUpdating = False
    Application.EnableEvents = False
    Application.DisplayAlerts = False


    '======================================================
    ' ABRIR ARCHIVO
    '======================================================

    Set wb = Workbooks.Open( _
        Filename:=ruta, _
        UpdateLinks:=False, _
        ReadOnly:=True)

    If wb Is Nothing Then

        Err.Raise _
            vbObjectError + 2000, _
            "ImportarExcel", _
            "No se pudo abrir el archivo."

    End If


    '======================================================
    ' PRIMERA HOJA
    '======================================================

    Set wsOrigen = wb.Worksheets(1)


    '======================================================
    ' HOJA REGISTRAR
    '======================================================

    Set wsDestino = _
        ThisWorkbook.Worksheets( _
            HOJA_REGISTRAR)


    '======================================================
    ' OBTENER DIMENSIONES
    '======================================================

    ObtenerDimensiones _
        wsOrigen, _
        ultimaFila, _
        ultimaColumna


    If ultimaFila = 0 Or _
       ultimaColumna = 0 Then

        Err.Raise _
            vbObjectError + 2001, _
            "ImportarExcel", _
            "El archivo no contiene datos."

    End If


    '======================================================
    ' BUSCAR ENCABEZADOS
    '======================================================

    filaEncabezados = _
        BuscarFilaEncabezados( _
            wsOrigen, _
            ultimaFila, _
            ultimaColumna)


    If filaEncabezados = 0 Then

        Err.Raise _
            vbObjectError + 2002, _
            "ImportarExcel", _
            "No se encontro la fila de encabezados."

    End If


    '======================================================
    ' MAPA DEL ARCHIVO EXTERNO
    '======================================================

    Set mapaOrigen = _
        CrearMapaEncabezados( _
            wsOrigen, _
            filaEncabezados, _
            ultimaColumna)


    '======================================================
    ' MAPA DE REGISTRAR
    '======================================================

    Set mapaDestino = _
        CrearMapaEncabezadosHoja( _
            wsDestino)


    '======================================================
    ' RFC NECESARIO
    '======================================================

    If Not mapaOrigen.Exists("RFC") Then

        MsgBox _
            "El archivo no contiene el encabezado RFC." & vbCrLf & vbCrLf & _
            "No se puede realizar la importacion.", _
            vbExclamation, _
            "IMPORTAR"

        GoTo Salir

    End If


    If Not mapaDestino.Exists("RFC") Then

        MsgBox _
            "No se encontro RFC en la hoja REGISTRAR.", _
            vbCritical, _
            "IMPORTAR"

        GoTo Salir

    End If


    '======================================================
    ' PRIMERA FILA LIBRE
    '======================================================

    filaDestino = _
        PrimeraFilaLibre( _
            wsDestino, _
            mapaDestino)


    If filaDestino = 0 Then GoTo Salir


    '======================================================
    ' RECORRER REGISTROS
    '======================================================

    For fila = _
        filaEncabezados + 1 _
        To ultimaFila


        '--------------------------------------------------
        ' RFC
        '--------------------------------------------------

        rfc = _
            ObtenerValorCampo( _
                wsOrigen, _
                fila, _
                mapaOrigen, _
                "RFC")


        '--------------------------------------------------
        ' CURP
        '--------------------------------------------------

        curp = _
            ObtenerValorCampo( _
                wsOrigen, _
                fila, _
                mapaOrigen, _
                "CURP")


        '--------------------------------------------------
        ' SIN RFC NI CURP = IGNORAR
        '--------------------------------------------------

        If rfc = "" And curp = "" Then

            registrosIgnorados = _
                registrosIgnorados + 1

            GoTo SiguienteFila

        End If


        '==================================================
        ' QNA/CICLO
        '
        ' SOLO PARA COMPARAR RECENCIA.
        '
        ' NO SE COPIAN A REGISTRAR.
        '==================================================

        qnaExterna = _
            ObtenerNumeroCampo( _
                wsOrigen, _
                fila, _
                mapaOrigen, _
                "QUINCENA")


        cicloExterno = _
            ObtenerNumeroCampo( _
                wsOrigen, _
                fila, _
                mapaOrigen, _
                "CICLO")


        '==================================================
        ' BUSCAR EN ACCESS
        '==================================================

        existe = _
            BuscarRegistroAccess( _
                rfc, _
                curp, _
                qnaAccess, _
                cicloAccess)


        '==================================================
        ' NO EXISTE
        '==================================================

        If Not existe Then

            CopiarCamposCoincidentes _
                wsOrigen, _
                wsDestino, _
                fila, _
                filaDestino, _
                mapaOrigen, _
                mapaDestino

            filaDestino = _
                filaDestino + 1

            registrosAgregados = _
                registrosAgregados + 1


        '==================================================
        ' EXISTE PERO EL EXTERNO ES MAS RECIENTE
        '==================================================

        ElseIf QNAExternaEsMasReciente( _
                    cicloExterno, _
                    qnaExterna, _
                    cicloAccess, _
                    qnaAccess) Then

            CopiarCamposCoincidentes _
                wsOrigen, _
                wsDestino, _
                fila, _
                filaDestino, _
                mapaOrigen, _
                mapaDestino

            filaDestino = _
                filaDestino + 1

            registrosAgregados = _
                registrosAgregados + 1


        Else

            registrosIgnorados = _
                registrosIgnorados + 1

        End If


SiguienteFila:

    Next fila


    '======================================================
    ' GUARDAR RANGO DE LA ULTIMA IMPORTACION
    '======================================================

    If registrosAgregados > 0 Then

        GuardarRangoUltimaImportacion _
            wsDestino, _
            filaDestino - registrosAgregados, _
            filaDestino - 1

    End If


    '======================================================
    ' RESULTADO
    '======================================================

    MsgBox _
        "IMPORTACION TERMINADA." & vbCrLf & vbCrLf & _
        "Registros enviados a REGISTRAR: " & _
        registrosAgregados & vbCrLf & _
        "Registros ignorados: " & _
        registrosIgnorados & vbCrLf & vbCrLf & _
        "Los registros NO fueron insertados directamente en Access." & _
        vbCrLf & _
        "Revisalos antes de utilizar CREAR.", _
        vbInformation, _
        "IMPORTAR"


Salir:

    On Error Resume Next

    If Not wb Is Nothing Then

        wb.Close SaveChanges:=False

    End If

    Application.DisplayAlerts = True
    Application.EnableEvents = True
    Application.ScreenUpdating = True

    Exit Sub


ErrorHandler:

    MsgBox _
        "ERROR DURANTE LA IMPORTACION." & vbCrLf & vbCrLf & _
        "Numero: " & Err.Number & vbCrLf & _
        "Descripcion: " & Err.Description, _
        vbCritical, _
        "IMPORTAR"

    Resume Salir

End Sub


'==========================================================
' BUSCAR FILA DE ENCABEZADOS
'==========================================================

Private Function BuscarFilaEncabezados( _
    ByVal ws As Worksheet, _
    ByVal ultimaFila As Long, _
    ByVal ultimaColumna As Long) As Long

    Dim f As Long
    Dim c As Long

    Dim encabezado As String

    Dim tieneRFC As Boolean
    Dim coincidencias As Long


    For f = 1 To ultimaFila

        tieneRFC = False
        coincidencias = 0


        For c = 1 To ultimaColumna

            encabezado = _
                NormalizarEncabezado( _
                    TextoSeguro( _
                        ws.Cells(f, c).Value))


            Select Case encabezado

                Case "RFC"

                    tieneRFC = True
                    coincidencias = coincidencias + 1

                Case "HOM"

                    coincidencias = coincidencias + 1

                Case "CURP"

                    coincidencias = coincidencias + 1

                Case "PATERNO"

                    coincidencias = coincidencias + 1

                Case "MATERNO"

                    coincidencias = coincidencias + 1

                Case "NOMBRE"

                    coincidencias = coincidencias + 1

                Case "NIVEL"

                    coincidencias = coincidencias + 1

                Case "UR"

                    coincidencias = coincidencias + 1

            End Select

        Next c


        If tieneRFC And coincidencias >= 2 Then

            BuscarFilaEncabezados = f

            Exit Function

        End If

    Next f


    BuscarFilaEncabezados = 0

End Function


'==========================================================
' CREAR MAPA DE ENCABEZADOS DEL ARCHIVO
'==========================================================

Private Function CrearMapaEncabezados( _
    ByVal ws As Worksheet, _
    ByVal filaEncabezados As Long, _
    ByVal ultimaColumna As Long) As Object

    Dim mapa As Object

    Dim c As Long

    Dim encabezado As String


    Set mapa = _
        CreateObject( _
            "Scripting.Dictionary")


    mapa.CompareMode = vbTextCompare


    For c = 1 To ultimaColumna

        encabezado = _
            NormalizarEncabezado( _
                TextoSeguro( _
                    ws.Cells( _
                        filaEncabezados, _
                        c).Value))


        If encabezado <> "" Then

            If Not mapa.Exists(encabezado) Then

                mapa.Add _
                    encabezado, _
                    c

            End If

        End If

    Next c


    Set CrearMapaEncabezados = mapa

End Function


'==========================================================
' CREAR MAPA DE REGISTRAR
'==========================================================

Private Function CrearMapaEncabezadosHoja( _
    ByVal ws As Worksheet) As Object

    Dim mapa As Object

    Dim f As Long
    Dim c As Long

    Dim encabezado As String


    Set mapa = _
        CreateObject( _
            "Scripting.Dictionary")


    mapa.CompareMode = vbTextCompare


    For f = 1 To 20

        For c = 1 To 50

            encabezado = _
                NormalizarEncabezado( _
                    TextoSeguro( _
                        ws.Cells( _
                            f, c).Value))


            If encabezado <> "" Then

                If Not mapa.Exists(encabezado) Then

                    mapa.Add _
                        encabezado, _
                        c

                End If

            End If

        Next c

    Next f


    Set CrearMapaEncabezadosHoja = mapa

End Function


'==========================================================
' COPIAR SOLO ENCABEZADOS COINCIDENTES
'==========================================================

Private Sub CopiarCamposCoincidentes( _
    ByVal wsOrigen As Worksheet, _
    ByVal wsDestino As Worksheet, _
    ByVal filaOrigen As Long, _
    ByVal filaDestino As Long, _
    ByVal mapaOrigen As Object, _
    ByVal mapaDestino As Object)

    Dim encabezado As Variant

    Dim colOrigen As Long
    Dim colDestino As Long

    Dim valor As Variant


    For Each encabezado In mapaOrigen.Keys

        If mapaDestino.Exists( _
            CStr(encabezado)) Then

            colOrigen = _
                CLng( _
                    mapaOrigen( _
                        CStr(encabezado)))


            colDestino = _
                CLng( _
                    mapaDestino( _
                        CStr(encabezado)))


            '----------------------------------------------
            ' NO IMPORTAR ID
            '----------------------------------------------

            If UCase$( _
                CStr(encabezado)) <> "ID" Then


                valor = _
                    wsOrigen.Cells( _
                        filaOrigen, _
                        colOrigen).Value


                If Not IsError(valor) Then

                    wsDestino.Cells( _
                        filaDestino, _
                        colDestino).Value = _
                        valor

                End If

            End If

        End If

    Next encabezado

End Sub


'==========================================================
' BUSCAR REGISTRO EN ACCESS
'
' RFC = PRINCIPAL
' CURP = SEGUNDO CRITERIO
'==========================================================

Private Function BuscarRegistroAccess( _
    ByVal rfc As String, _
    ByVal curp As String, _
    ByRef qnaAccess As Long, _
    ByRef cicloAccess As Long) As Boolean

    Dim cn As Object
    Dim rs As Object

    Dim sql As String

    Dim q As Long
    Dim a As Long


    qnaAccess = 0
    cicloAccess = 0


    On Error GoTo ErrorHandler


    Set cn = AbrirConexionAccess()


    If cn Is Nothing Then

        Err.Raise _
            vbObjectError + 3000, _
            "BuscarRegistroAccess", _
            "No se pudo abrir la conexion con Access."

    End If


    If rfc <> "" Then

        sql = _
            "SELECT * FROM MOVIMIENTOS " & _
            "WHERE RFC='" & _
            Replace( _
                rfc, _
                "'", _
                "''") & "'"

    ElseIf curp <> "" Then

        sql = _
            "SELECT * FROM MOVIMIENTOS " & _
            "WHERE CURP='" & _
            Replace( _
                curp, _
                "'", _
                "''") & "'"

    Else

        GoTo Salir

    End If


    Set rs = cn.Execute(sql)


    If rs.EOF Then

        BuscarRegistroAccess = False

        GoTo Salir

    End If


    BuscarRegistroAccess = True


    '======================================================
    ' OBTENER EL MOVIMIENTO MAS RECIENTE
    '======================================================

    Do While Not rs.EOF

        q = _
            ObtenerNumeroRecordset( _
                rs, _
                "QNA")


        a = _
            ObtenerNumeroRecordset( _
                rs, _
                "AÑO")


        If QNAExternaEsMasReciente( _
                a, _
                q, _
                cicloAccess, _
                qnaAccess) Then

            cicloAccess = a
            qnaAccess = q

        End If


        rs.MoveNext

    Loop


Salir:

    On Error Resume Next

    If Not rs Is Nothing Then rs.Close

    If Not cn Is Nothing Then cn.Close

    Exit Function


ErrorHandler:

    Err.Raise _
        Err.Number, _
        "BuscarRegistroAccess", _
        Err.Description

End Function


'==========================================================
' COMPARAR RECENCIA
'
' SOLO PARA SABER SI EL ARCHIVO EXTERNO ES MAS RECIENTE.
'
' NO CREA EQUIVALENCIAS.
'==========================================================

Private Function QNAExternaEsMasReciente( _
    ByVal cicloExterno As Long, _
    ByVal qnaExterna As Long, _
    ByVal cicloAccess As Long, _
    ByVal qnaAccess As Long) As Boolean


    If cicloExterno > cicloAccess Then

        QNAExternaEsMasReciente = True

        Exit Function

    End If


    If cicloExterno < cicloAccess Then

        QNAExternaEsMasReciente = False

        Exit Function

    End If


    If qnaExterna > qnaAccess Then

        QNAExternaEsMasReciente = True

    Else

        QNAExternaEsMasReciente = False

    End If

End Function


'==========================================================
' PRIMERA FILA LIBRE
'==========================================================

Private Function PrimeraFilaLibre( _
    ByVal ws As Worksheet, _
    ByVal mapaDestino As Object) As Long

    Dim fila As Long
    Dim columnaRFC As Long


    If Not mapaDestino.Exists("RFC") Then

        MsgBox _
            "No se encontro RFC en REGISTRAR.", _
            vbCritical, _
            "IMPORTAR"

        PrimeraFilaLibre = 0

        Exit Function

    End If


    columnaRFC = _
        CLng( _
            mapaDestino("RFC"))


    fila = 9


    Do While _
        Trim$( _
            TextoSeguro( _
                ws.Cells( _
                    fila, _
                    columnaRFC).Value)) <> ""


        fila = fila + 1


        If fila > 5000 Then

            MsgBox _
                "No se encontro espacio libre en REGISTRAR.", _
                vbExclamation, _
                "IMPORTAR"

            PrimeraFilaLibre = 0

            Exit Function

        End If

    Loop


    PrimeraFilaLibre = fila

End Function


'==========================================================
' OBTENER VALOR
'==========================================================

Private Function ObtenerValorCampo( _
    ByVal ws As Worksheet, _
    ByVal fila As Long, _
    ByVal mapa As Object, _
    ByVal encabezado As String) As String

    Dim clave As String


    clave = _
        NormalizarEncabezado( _
            encabezado)


    If Not mapa.Exists(clave) Then

        ObtenerValorCampo = ""

        Exit Function

    End If


    ObtenerValorCampo = _
        TextoSeguro( _
            ws.Cells( _
                fila, _
                CLng(mapa(clave))).Value)

End Function


'==========================================================
' OBTENER NUMERO
'==========================================================

Private Function ObtenerNumeroCampo( _
    ByVal ws As Worksheet, _
    ByVal fila As Long, _
    ByVal mapa As Object, _
    ByVal encabezado As String) As Long

    Dim texto As String


    texto = _
        ObtenerValorCampo( _
            ws, _
            fila, _
            mapa, _
            encabezado)


    If texto = "" Then

        ObtenerNumeroCampo = 0

        Exit Function

    End If


    If IsNumeric(texto) Then

        ObtenerNumeroCampo = _
            CLng(texto)

    Else

        ObtenerNumeroCampo = _
            CLng(Val(texto))

    End If

End Function


'==========================================================
' OBTENER NUMERO DE RECORDSET
'==========================================================

Private Function ObtenerNumeroRecordset( _
    ByVal rs As Object, _
    ByVal campo As String) As Long

    On Error GoTo ErrorNumero


    If IsNull( _
        rs.Fields(campo).Value) Then

        ObtenerNumeroRecordset = 0

    Else

        ObtenerNumeroRecordset = _
            CLng( _
                Val( _
                    CStr( _
                        rs.Fields(campo).Value)))

    End If


    Exit Function


ErrorNumero:

    ObtenerNumeroRecordset = 0

End Function


'==========================================================
' OBTENER DIMENSIONES
'==========================================================

Private Sub ObtenerDimensiones( _
    ByVal ws As Worksheet, _
    ByRef ultimaFila As Long, _
    ByRef ultimaColumna As Long)

    Dim ultimaCelda As Range


    ultimaFila = 0
    ultimaColumna = 0


    On Error Resume Next


    Set ultimaCelda = _
        ws.Cells.SpecialCells( _
            xlCellTypeLastCell)


    On Error GoTo 0


    If ultimaCelda Is Nothing Then Exit Sub


    ultimaFila = ultimaCelda.Row

    ultimaColumna = ultimaCelda.Column

End Sub


'==========================================================
' NORMALIZAR ENCABEZADO
'
' IMPORTANTE:
'
' NO CREA EQUIVALENCIAS.
'
' Solo:
' - quita espacios al inicio/final
' - convierte a mayusculas
'
'==========================================================

Private Function NormalizarEncabezado( _
    ByVal texto As String) As String

    texto = Trim$(texto)

    texto = UCase$(texto)

    NormalizarEncabezado = texto

End Function


'==========================================================
' TEXTO SEGURO
'==========================================================

Private Function TextoSeguro( _
    ByVal valor As Variant) As String

    If IsError(valor) Then

        TextoSeguro = ""

    ElseIf IsNull(valor) Then

        TextoSeguro = ""

    Else

        TextoSeguro = _
            Trim$( _
                CStr(valor))

    End If

End Function


'==========================================================
' GUARDAR RANGO DE LA ULTIMA IMPORTACION
'==========================================================

Private Sub GuardarRangoUltimaImportacion( _
    ByVal ws As Worksheet, _
    ByVal primeraFila As Long, _
    ByVal ultimaFila As Long)

    Dim celdaInicio As Range
    Dim celdaFin As Range


    Set celdaInicio = _
        ws.Cells( _
            primeraFila, _
            1)


    Set celdaFin = _
        ws.Cells( _
            ultimaFila, _
            1)


    On Error Resume Next

    ThisWorkbook.Names( _
        "FilaInicioImportacion").Delete

    ThisWorkbook.Names( _
        "FilaFinImportacion").Delete

    On Error GoTo 0


    ThisWorkbook.Names.Add _
        Name:="FilaInicioImportacion", _
        RefersTo:="=" & _
        celdaInicio.Address( _
            External:=True)


    ThisWorkbook.Names.Add _
        Name:="FilaFinImportacion", _
        RefersTo:="=" & _
        celdaFin.Address( _
            External:=True)

End Sub


'==========================================================
' LIMPIAR SOLO LA ULTIMA IMPORTACION
'==========================================================

Public Sub LimpiarUltimaImportacion()

    Dim ws As Worksheet

    Dim primeraFila As Long
    Dim ultimaFila As Long

    Dim respuesta As VbMsgBoxResult


    On Error GoTo ErrorHandler


    Set ws = _
        ThisWorkbook.Worksheets( _
            HOJA_REGISTRAR)


    '======================================================
    ' COMPROBAR SI EXISTE UNA IMPORTACION
    '======================================================

    If Not ExisteNombre( _
        "FilaInicioImportacion") Or _
       Not ExisteNombre( _
        "FilaFinImportacion") Then


        MsgBox _
            "No hay una importacion registrada para limpiar.", _
            vbInformation, _
            "LIMPIAR"

        Exit Sub

    End If


    primeraFila = _
        ObtenerValorNombre( _
            "FilaInicioImportacion")


    ultimaFila = _
        ObtenerValorNombre( _
            "FilaFinImportacion")


    If primeraFila <= 0 Or _
       ultimaFila < primeraFila Then


        MsgBox _
            "No hay registros importados para limpiar.", _
            vbInformation, _
            "LIMPIAR"

        Exit Sub

    End If


    '======================================================
    ' CONFIRMACION
    '======================================================

    respuesta = MsgBox( _
        "Se eliminaran SOLO los registros de la ultima importacion." & _
        vbCrLf & vbCrLf & _
        "Filas: " & primeraFila & _
        " a " & ultimaFila & _
        vbCrLf & vbCrLf & _
        "Los registros anteriores NO seran eliminados." & _
        vbCrLf & vbCrLf & _
        "¿Deseas continuar?", _
        vbYesNo + vbQuestion + vbDefaultButton2, _
        "LIMPIAR ULTIMA IMPORTACION")


    If respuesta <> vbYes Then Exit Sub


    Application.ScreenUpdating = False


    '======================================================
    ' LIMPIAR CONTENIDO
    '
    ' NO BORRA FORMATO.
    ' NO BORRA DROPDOWNS.
    ' NO BORRA ESTRUCTURA.
    '======================================================

    ws.Range( _
        ws.Cells(primeraFila, 1), _
        ws.Cells(ultimaFila, 50)).ClearContents


    '======================================================
    ' BORRAR MARCADORES
    '======================================================

    BorrarNombreSeguro _
        "FilaInicioImportacion"


    BorrarNombreSeguro _
        "FilaFinImportacion"


    Application.ScreenUpdating = True


    MsgBox _
        "Los registros de la ultima importacion fueron limpiados." & _
        vbCrLf & vbCrLf & _
        "REGISTRAR esta listo para volver a importar o capturar manualmente.", _
        vbInformation, _
        "LIMPIAR"


    Exit Sub


ErrorHandler:

    Application.ScreenUpdating = True


    MsgBox _
        "ERROR AL LIMPIAR." & vbCrLf & vbCrLf & _
        "Numero: " & Err.Number & vbCrLf & _
        "Descripcion: " & Err.Description, _
        vbCritical, _
        "LIMPIAR"

End Sub


'==========================================================
' COMPROBAR SI EXISTE UN NOMBRE
'==========================================================

Private Function ExisteNombre( _
    ByVal nombre As String) As Boolean

    Dim n As Name


    On Error GoTo NoExiste


    Set n = _
        ThisWorkbook.Names(nombre)


    ExisteNombre = True


    Exit Function


NoExiste:

    ExisteNombre = False

End Function


'==========================================================
' OBTENER VALOR DE UN NOMBRE
'==========================================================

Private Function ObtenerValorNombre( _
    ByVal nombre As String) As Long

    Dim texto As String


    On Error GoTo ErrorValor


    texto = _
        ThisWorkbook.Names( _
            nombre).RefersTo


    texto = _
        Replace(texto, "=", "")


    texto = _
        Replace(texto, "'", "")


    ObtenerValorNombre = _
        CLng( _
            Val(texto))


    Exit Function


ErrorValor:

    ObtenerValorNombre = 0

End Function


'==========================================================
' BORRAR NOMBRE
'==========================================================

Private Sub BorrarNombreSeguro( _
    ByVal nombre As String)

    On Error Resume Next

    ThisWorkbook.Names(nombre).Delete

End Sub