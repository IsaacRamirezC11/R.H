Option Explicit

'==========================================================
' MODIMPORTAR
'==========================================================
'
' IMPORTACION DE ARCHIVOS EXCEL
'
' REGLA PRINCIPAL:
'
' SOLO SE COPIAN CAMPOS CUYO ENCABEZADO EXISTA
' EN NUESTRA HOJA REGISTRAR.
'
' NO SE CREAN EQUIVALENCIAS.
'
' Ejemplo:
'
' RFC       -> RFC       SI COINCIDE
' HOM       -> HOM       SI COINCIDE
' CURP      -> CURP      SI COINCIDE
'
' QUINCENA  -> QNA       NO SE COPIA
' CICLO     -> AÑO       NO SE COPIA
'
' QUINCENA + CICLO solamente se utilizan para
' determinar si el archivo externo corresponde
' a un movimiento más reciente.
'
'==========================================================


Private Const HOJA_REGISTRAR As String = "REGISTRAR"

Private Const FILA_INICIAL_BUSQUEDA As Long = 1

Private Const MAX_FILAS_BUSCAR_ENCABEZADO As Long = 100

Private Const MAX_COLUMNAS_BUSCAR_ENCABEZADO As Long = 150


'==========================================================
' MACRO PRINCIPAL
'==========================================================

Public Sub ImportarArchivoExterno()

    Dim fd As FileDialog

    Dim ruta As String

    Dim extension As String


    On Error GoTo ErrorHandler


    Set fd = Application.FileDialog( _
        msoFileDialogFilePicker)


    With fd

        .Title = "Seleccionar archivo para importar"

        .AllowMultiSelect = False

        .Filters.Clear

        .Filters.Add _
            "Archivos Excel", _
            "*.xlsx;*.xls;*.xlsm"

        .Filters.Add _
            "Archivos PDF", _
            "*.pdf"


        If .Show <> -1 Then

            Exit Sub

        End If


        ruta = .SelectedItems(1)

    End With


    extension = LCase$( _
        Mid$( _
            ruta, _
            InStrRev(ruta, ".") + 1))


    Select Case extension

        Case "xlsx", "xls", "xlsm"

            ImportarExcel ruta


        Case "pdf"

            MsgBox _
                "El archivo es PDF." & vbCrLf & vbCrLf & _
                "La lectura automatica de PDF " & _
                "todavia no esta habilitada.", _
                vbInformation, _
                "IMPORTAR"


        Case Else

            MsgBox _
                "El formato seleccionado no es compatible.", _
                vbExclamation, _
                "IMPORTAR"

    End Select


    Exit Sub


ErrorHandler:

    MsgBox _
        "ERROR AL SELECCIONAR EL ARCHIVO." & vbCrLf & vbCrLf & _
        "Numero: " & Err.Number & vbCrLf & _
        "Descripcion: " & Err.Description, _
        vbCritical, _
        "IMPORTAR"

End Sub


'==========================================================
' IMPORTAR EXCEL
'==========================================================

Private Sub ImportarExcel(ByVal ruta As String)

    Dim wb As Workbook

    Dim wsOrigen As Worksheet

    Dim wsDestino As Worksheet

    Dim filaEncabezados As Long

    Dim ultimaFila As Long

    Dim ultimaColumna As Long

    Dim mapaOrigen As Object

    Dim mapaDestino As Object

    Dim fila As Long

    Dim filaDestino As Long

    Dim registrosAgregados As Long

    Dim registrosIgnorados As Long

    Dim rfc As String

    Dim curp As String

    Dim qnaExterna As Long

    Dim cicloExterno As Long

    Dim qnaAccess As Long

    Dim cicloAccess As Long

    Dim existe As Boolean


    On Error GoTo ErrorHandler


    Application.ScreenUpdating = False

    Application.EnableEvents = False

    Application.DisplayAlerts = False


    '======================================================
    ' ABRIR ARCHIVO
    '======================================================

    Set wb = Workbooks.Open( _
        Filename:=ruta, _
        UpdateLinks:=False, _
        ReadOnly:=True)


    If wb Is Nothing Then

        Err.Raise _
            vbObjectError + 2000, _
            "ImportarExcel", _
            "No se pudo abrir el archivo."

    End If


    '======================================================
    ' PRIMERA HOJA
    '======================================================

    Set wsOrigen = wb.Worksheets(1)


    '======================================================
    ' HOJA REGISTRAR
    '======================================================

    Set wsDestino = _
        ThisWorkbook.Worksheets( _
            HOJA_REGISTRAR)


    '======================================================
    ' DIMENSIONES DEL ARCHIVO
    '======================================================

    ObtenerDimensiones _
        wsOrigen, _
        ultimaFila, _
        ultimaColumna


    If ultimaFila = 0 Or _
       ultimaColumna = 0 Then

        Err.Raise _
            vbObjectError + 2001, _
            "ImportarExcel", _
            "El archivo no contiene datos."

    End If


    '======================================================
    ' BUSCAR ENCABEZADOS
    '======================================================

    filaEncabezados = _
        BuscarFilaEncabezados( _
            wsOrigen, _
            ultimaFila, _
            ultimaColumna)


    If filaEncabezados = 0 Then

        Err.Raise _
            vbObjectError + 2002, _
            "ImportarExcel", _
            "No se encontro la fila de encabezados."

    End If


    '======================================================
    ' MAPA DE ENCABEZADOS DEL ARCHIVO
    '======================================================

    Set mapaOrigen = _
        CrearMapaEncabezados( _
            wsOrigen, _
            filaEncabezados, _
            ultimaColumna)


    '======================================================
    ' MAPA DE ENCABEZADOS DE REGISTRAR
    '======================================================

    Set mapaDestino = _
        CrearMapaEncabezadosHoja( _
            wsDestino)


    '======================================================
    ' RFC ES NECESARIO PARA LA IDENTIFICACION
    '======================================================

    If Not mapaOrigen.Exists("RFC") Then

        MsgBox _
            "El archivo no contiene el encabezado RFC." & _
            vbCrLf & vbCrLf & _
            "No se puede realizar la importacion.", _
            vbExclamation, _
            "IMPORTAR"

        GoTo Salir

    End If


    '======================================================
    ' PRIMERA FILA LIBRE EN REGISTRAR
    '======================================================

    filaDestino = _
        PrimeraFilaLibre( _
            wsDestino, _
            mapaDestino)


    If filaDestino = 0 Then GoTo Salir


    '======================================================
    ' RECORRER REGISTROS DEL EXCEL
    '======================================================

    For fila = _
        filaEncabezados + 1 _
        To ultimaFila


        rfc = ObtenerValorCampo( _
            wsOrigen, _
            fila, _
            mapaOrigen, _
            "RFC")


        curp = ObtenerValorCampo( _
            wsOrigen, _
            fila, _
            mapaOrigen, _
            "CURP")


        '--------------------------------------------------
        ' SI NO HAY RFC NI CURP, IGNORAR FILA
        '--------------------------------------------------

        If rfc = "" And curp = "" Then

            registrosIgnorados = _
                registrosIgnorados + 1

            GoTo SiguienteFila

        End If


        '==================================================
        ' QUINCENA Y CICLO
        '
        ' SOLO PARA COMPARAR RECENCIA.
        '
        ' NO SE COPIAN A QNA / AÑO.
        '==================================================

        qnaExterna = _
            ObtenerNumeroCampo( _
                wsOrigen, _
                fila, _
                mapaOrigen, _
                "QUINCENA")


        cicloExterno = _
            ObtenerNumeroCampo( _
                wsOrigen, _
                fila, _
                mapaOrigen, _
                "CICLO")


        '==================================================
        ' BUSCAR EN ACCESS
        '==================================================

        existe = _
            BuscarRegistroAccess( _
                rfc, _
                curp, _
                qnaAccess, _
                cicloAccess)


        '==================================================
        ' SI NO EXISTE
        '==================================================

        If Not existe Then

            CopiarCamposCoincidentes _
                wsOrigen, _
                wsDestino, _
                fila, _
                filaDestino, _
                mapaOrigen, _
                mapaDestino


            filaDestino = filaDestino + 1

            registrosAgregados = _
                registrosAgregados + 1


        '==================================================
        ' SI EXISTE, COMPARAR RECENCIA
        '==================================================

        ElseIf QNAExternaEsMasReciente( _
                    cicloExterno, _
                    qnaExterna, _
                    cicloAccess, _
                    qnaAccess) Then


            CopiarCamposCoincidentes _
                wsOrigen, _
                wsDestino, _
                fila, _
                filaDestino, _
                mapaOrigen, _
                mapaDestino


            filaDestino = filaDestino + 1

            registrosAgregados = _
                registrosAgregados + 1


        Else

            registrosIgnorados = _
                registrosIgnorados + 1

        End If


SiguienteFila:

    Next fila


    '======================================================
    ' RESULTADO
    '======================================================

    MsgBox _
        "IMPORTACION TERMINADA." & vbCrLf & vbCrLf & _
        "Registros enviados a REGISTRAR: " & _
        registrosAgregados & vbCrLf & _
        "Registros ignorados: " & _
        registrosIgnorados & vbCrLf & vbCrLf & _
        "Los registros NO fueron insertados directamente " & _
        "en Access." & vbCrLf & _
        "Revisalos antes de utilizar CREAR.", _
        vbInformation, _
        "IMPORTAR"


Salir:

    On Error Resume Next


    If Not wb Is Nothing Then

        wb.Close SaveChanges:=False

    End If


    Application.DisplayAlerts = True

    Application.EnableEvents = True

    Application.ScreenUpdating = True


    Exit Sub


ErrorHandler:

    MsgBox _
        "ERROR DURANTE LA IMPORTACION." & vbCrLf & vbCrLf & _
        "Numero: " & Err.Number & vbCrLf & _
        "Descripcion: " & Err.Description, _
        vbCritical, _
        "IMPORTAR"


    Resume Salir

End Sub


'==========================================================
' BUSCAR FILA DE ENCABEZADOS
'
' NO IMPORTA EN QUE FILA SE ENCUENTREN.
'
' Buscamos RFC + alguno de los campos principales.
'==========================================================

Private Function BuscarFilaEncabezados( _
    ByVal ws As Worksheet, _
    ByVal ultimaFila As Long, _
    ByVal ultimaColumna As Long) As Long


    Dim f As Long

    Dim c As Long

    Dim encabezado As String

    Dim tieneRFC As Boolean

    Dim cantidadCoincidencias As Long


    For f = 1 To ultimaFila


        tieneRFC = False

        cantidadCoincidencias = 0


        For c = 1 To ultimaColumna


            encabezado = _
                NormalizarEncabezado( _
                    TextoSeguro( _
                        ws.Cells(f, c).Value))


            Select Case encabezado


                Case "RFC"

                    tieneRFC = True

                    cantidadCoincidencias = _
                        cantidadCoincidencias + 1


                Case "HOM"

                    cantidadCoincidencias = _
                        cantidadCoincidencias + 1


                Case "CURP"

                    cantidadCoincidencias = _
                        cantidadCoincidencias + 1


                Case "PATERNO"

                    cantidadCoincidencias = _
                        cantidadCoincidencias + 1


                Case "MATERNO"

                    cantidadCoincidencias = _
                        cantidadCoincidencias + 1


                Case "NOMBRE"

                    cantidadCoincidencias = _
                        cantidadCoincidencias + 1


                Case "NIVEL"

                    cantidadCoincidencias = _
                        cantidadCoincidencias + 1


                Case "UR"

                    cantidadCoincidencias = _
                        cantidadCoincidencias + 1


            End Select


        Next c


        If tieneRFC And _
           cantidadCoincidencias >= 2 Then


            BuscarFilaEncabezados = f

            Exit Function

        End If


    Next f


    BuscarFilaEncabezados = 0

End Function


'==========================================================
' CREAR MAPA DE ENCABEZADOS DEL ARCHIVO
'==========================================================

Private Function CrearMapaEncabezados( _
    ByVal ws As Worksheet, _
    ByVal filaEncabezados As Long, _
    ByVal ultimaColumna As Long) As Object


    Dim mapa As Object

    Dim c As Long

    Dim encabezado As String


    Set mapa = _
        CreateObject( _
            "Scripting.Dictionary")


    mapa.CompareMode = vbTextCompare


    For c = 1 To ultimaColumna


        encabezado = _
            NormalizarEncabezado( _
                TextoSeguro( _
                    ws.Cells( _
                        filaEncabezados, _
                        c).Value))


        If encabezado <> "" Then


            If Not mapa.Exists(encabezado) Then

                mapa.Add _
                    encabezado, _
                    c

            End If


        End If


    Next c


    Set CrearMapaEncabezados = mapa

End Function


'==========================================================
' MAPA DE ENCABEZADOS DE REGISTRAR
'
' BUSCA LOS ENCABEZADOS EN LAS PRIMERAS 20 FILAS.
'==========================================================

Private Function CrearMapaEncabezadosHoja( _
    ByVal ws As Worksheet) As Object


    Dim mapa As Object

    Dim f As Long

    Dim c As Long

    Dim encabezado As String


    Set mapa = _
        CreateObject( _
            "Scripting.Dictionary")


    mapa.CompareMode = vbTextCompare


    For f = 1 To 20


        For c = 1 To 50


            encabezado = _
                NormalizarEncabezado( _
                    TextoSeguro( _
                        ws.Cells( _
                            f, c).Value))


            If encabezado <> "" Then


                If Not mapa.Exists(encabezado) Then

                    mapa.Add _
                        encabezado, _
                        c

                End If


            End If


        Next c


    Next f


    Set CrearMapaEncabezadosHoja = mapa

End Function


'==========================================================
' COPIAR SOLO ENCABEZADOS COINCIDENTES
'==========================================================

Private Sub CopiarCamposCoincidentes( _
    ByVal wsOrigen As Worksheet, _
    ByVal wsDestino As Worksheet, _
    ByVal filaOrigen As Long, _
    ByVal filaDestino As Long, _
    ByVal mapaOrigen As Object, _
    ByVal mapaDestino As Object)


    Dim encabezado As Variant

    Dim colOrigen As Long

    Dim colDestino As Long

    Dim valor As Variant


    For Each encabezado In mapaOrigen.Keys


        '==================================================
        ' SI EL ENCABEZADO NO EXISTE EN REGISTRAR,
        ' SE IGNORA.
        '==================================================

        If mapaDestino.Exists(CStr(encabezado)) Then


            colOrigen = _
                CLng(mapaOrigen(CStr(encabezado)))


            colDestino = _
                CLng(mapaDestino(CStr(encabezado)))


            '----------------------------------------------
            ' NUNCA IMPORTAR ID
            '----------------------------------------------

            If UCase$(CStr(encabezado)) <> "ID" Then


                valor = _
                    wsOrigen.Cells( _
                        filaOrigen, _
                        colOrigen).Value


                If Not IsError(valor) Then


                    wsDestino.Cells( _
                        filaDestino, _
                        colDestino).Value = _
                        valor


                End If


            End If


        End If


    Next encabezado

End Sub


'==========================================================
' BUSCAR REGISTRO EN ACCESS
'
' RFC PRINCIPAL
' CURP COMO SEGUNDO CRITERIO
'
' IMPORTANTE:
' Se utiliza la conexion existente del proyecto.
'==========================================================

Private Function BuscarRegistroAccess( _
    ByVal rfc As String, _
    ByVal curp As String, _
    ByRef qnaAccess As Long, _
    ByRef cicloAccess As Long) As Boolean


    Dim cn As Object

    Dim rs As Object

    Dim sql As String


    qnaAccess = 0

    cicloAccess = 0


    On Error GoTo ErrorHandler


    Set cn = AbrirConexionAccess()


    If cn Is Nothing Then

        Err.Raise _
            vbObjectError + 3000, _
            "BuscarRegistroAccess", _
            "No se pudo abrir la conexion con Access."

    End If


    '======================================================
    ' RFC
    '======================================================

    If rfc <> "" Then


        sql = _
            "SELECT * FROM MOVIMIENTOS " & _
            "WHERE RFC='" & _
            Replace(rfc, "'", "''") & "'"


    '======================================================
    ' CURP
    '======================================================

    ElseIf curp <> "" Then


        sql = _
            "SELECT * FROM MOVIMIENTOS " & _
            "WHERE CURP='" & _
            Replace(curp, "'", "''") & "'"


    Else

        GoTo Salir

    End If


    Set rs = cn.Execute(sql)


    If rs.EOF Then

        BuscarRegistroAccess = False

        GoTo Salir

    End If


    BuscarRegistroAccess = True


    '======================================================
    ' OBTENER ULTIMO QNA/AÑO EXISTENTE
    '
    ' ESTO SOLO ES PARA COMPARAR RECENCIA.
    ' NO ES UNA EQUIVALENCIA DE IMPORTACION.
    '======================================================

    Do While Not rs.EOF


        Dim q As Long

        Dim a As Long


        q = ObtenerNumeroRecordset( _
                rs, _
                "QNA")


        a = ObtenerNumeroRecordset( _
                rs, _
                "AÑO")


        If QNAExternaEsMasReciente( _
                a, _
                q, _
                cicloAccess, _
                qnaAccess) Then


            cicloAccess = a

            qnaAccess = q


        End If


        rs.MoveNext


    Loop


Salir:

    On Error Resume Next


    If Not rs Is Nothing Then rs.Close

    If Not cn Is Nothing Then cn.Close


    Exit Function


ErrorHandler:

    Err.Raise _
        Err.Number, _
        "BuscarRegistroAccess", _
        Err.Description

End Function


'==========================================================
' COMPARAR RECENCIA
'
' SOLO COMPARA:
'
' CICLO
' QUINCENA
'
' NO COPIA ESOS CAMPOS.
'==========================================================

Private Function QNAExternaEsMasReciente( _
    ByVal cicloExterno As Long, _
    ByVal qnaExterna As Long, _
    ByVal cicloAccess As Long, _
    ByVal qnaAccess As Long) As Boolean


    If cicloExterno > cicloAccess Then

        QNAExternaEsMasReciente = True

        Exit Function

    End If


    If cicloExterno < cicloAccess Then

        QNAExternaEsMasReciente = False

        Exit Function

    End If


    If qnaExterna > qnaAccess Then

        QNAExternaEsMasReciente = True

    Else

        QNAExternaEsMasReciente = False

    End If

End Function


'==========================================================
' PRIMERA FILA LIBRE
'
' BUSCA LA PRIMERA FILA SIN RFC.
'==========================================================

Private Function PrimeraFilaLibre( _
    ByVal ws As Worksheet, _
    ByVal mapaDestino As Object) As Long


    Dim fila As Long

    Dim columnaRFC As Long


    If Not mapaDestino.Exists("RFC") Then

        MsgBox _
            "No se encontro el encabezado RFC " & _
            "en la hoja REGISTRAR.", _
            vbCritical, _
            "IMPORTAR"


        PrimeraFilaLibre = 0

        Exit Function

    End If


    columnaRFC = _
        CLng(mapaDestino("RFC"))


    fila = 1


    Do While _
        Trim$( _
            TextoSeguro( _
                ws.Cells( _
                    fila, _
                    columnaRFC).Value)) <> ""


        fila = fila + 1


        If fila > 5000 Then

            MsgBox _
                "No se encontro espacio libre " & _
                "en REGISTRAR.", _
                vbExclamation, _
                "IMPORTAR"


            PrimeraFilaLibre = 0

            Exit Function

        End If


    Loop


    PrimeraFilaLibre = fila

End Function


'==========================================================
' OBTENER VALOR DE UN CAMPO
'==========================================================

Private Function ObtenerValorCampo( _
    ByVal ws As Worksheet, _
    ByVal fila As Long, _
    ByVal mapa As Object, _
    ByVal encabezado As String) As String


    If Not mapa.Exists( _
        NormalizarEncabezado(encabezado)) Then


        ObtenerValorCampo = ""

        Exit Function

    End If


    ObtenerValorCampo = _
        TextoSeguro( _
            ws.Cells( _
                fila, _
                CLng( _
                    mapa( _
                        NormalizarEncabezado( _
                            encabezado)))).Value)

End Function


'==========================================================
' OBTENER NUMERO DE CAMPO
'==========================================================

Private Function ObtenerNumeroCampo( _
    ByVal ws As Worksheet, _
    ByVal fila As Long, _
    ByVal mapa As Object, _
    ByVal encabezado As String) As Long


    Dim texto As String


    texto = _
        ObtenerValorCampo( _
            ws, _
            fila, _
            mapa, _
            encabezado)


    If texto = "" Then

        ObtenerNumeroCampo = 0

        Exit Function

    End If


    If IsNumeric(texto) Then

        ObtenerNumeroCampo = _
            CLng(texto)

    Else

        ObtenerNumeroCampo = _
            CLng(Val(texto))

    End If

End Function


'==========================================================
' OBTENER NUMERO DESDE RECORDSET
'==========================================================

Private Function ObtenerNumeroRecordset( _
    ByVal rs As Object, _
    ByVal campo As String) As Long


    On Error GoTo Salir


    If IsNull( _
        rs.Fields(campo).Value) Then

        ObtenerNumeroRecordset = 0

    Else

        ObtenerNumeroRecordset = _
            CLng( _
                Val( _
                    CStr( _
                        rs.Fields(campo).Value)))

    End If


    Exit Function


Salir:

    ObtenerNumeroRecordset = 0

End Function


'==========================================================
' OBTENER DIMENSIONES
'==========================================================

Private Sub ObtenerDimensiones( _
    ByVal ws As Worksheet, _
    ByRef ultimaFila As Long, _
    ByRef ultimaColumna As Long)


    Dim ultimaCelda As Range


    ultimaFila = 0

    ultimaColumna = 0


    On Error Resume Next


    Set ultimaCelda = _
        ws.Cells.SpecialCells( _
            xlCellTypeLastCell)


    On Error GoTo 0


    If ultimaCelda Is Nothing Then Exit Sub


    ultimaFila = ultimaCelda.Row

    ultimaColumna = ultimaCelda.Column

End Sub


'==========================================================
' NORMALIZAR ENCABEZADO
'
' NO CREA EQUIVALENCIAS.
'
' Solo elimina diferencias irrelevantes:
' mayusculas/minusculas y espacios extremos.
'
'==========================================================

Private Function NormalizarEncabezado( _
    ByVal texto As String) As String


    texto = Trim$(texto)

    texto = UCase$(texto)


    NormalizarEncabezado = texto

End Function


'==========================================================
' TEXTO SEGURO
'==========================================================

Private Function TextoSeguro( _
    ByVal valor As Variant) As String


    If IsError(valor) Then

        TextoSeguro = ""


    ElseIf IsNull(valor) Then

        TextoSeguro = ""


    Else

        TextoSeguro = _
            Trim$( _
                CStr(valor))

    End If

End Function