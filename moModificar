'========================================================
' VALOR SQL
'========================================================

Private Function ValorSQL( _
    ByVal valor As Variant) As String

    If IsError(valor) Or IsNull(valor) Then

        ValorSQL = "NULL"

        Exit Function

    End If


    If Trim$(CStr(valor)) = "" Then

        ValorSQL = "''"

        Exit Function

    End If


    ValorSQL = _
        "'" & _
        Replace(CStr(valor), "'", "''") & _
        "'"

End Function


'========================================================
' NORMALIZAR
'========================================================

Private Function NormalizarTexto( _
    ByVal texto As String) As String

    texto = UCase$(Trim$(texto))

    texto = Replace(texto, "Á", "A")
    texto = Replace(texto, "É", "E")
    texto = Replace(texto, "Í", "I")
    texto = Replace(texto, "Ó", "O")
    texto = Replace(texto, "Ú", "U")
    texto = Replace(texto, "Ü", "U")
    texto = Replace(texto, "Ñ", "N")

    texto = Replace(texto, " ", "")
    texto = Replace(texto, ".", "")
    texto = Replace(texto, "-", "")
    texto = Replace(texto, "_", "")
    texto = Replace(texto, "/", "")
    texto = Replace(texto, "\", "")
    texto = Replace(texto, "(", "")
    texto = Replace(texto, ")", "")
    texto = Replace(texto, ":", "")
    texto = Replace(texto, "'", "")

    NormalizarTexto = texto

End Function


'========================================================
' CONVERTIR FECHA
'========================================================

Private Function ConvertirFecha( _
    ByVal valor As Variant) As Variant

    Dim texto As String
    Dim p() As String

    Dim d As Integer
    Dim m As Integer
    Dim a As Integer


    On Error GoTo ErrorFecha


    If IsNull(valor) Or IsError(valor) Then

        ConvertirFecha = Empty
        Exit Function

    End If


    If IsDate(valor) Then

        ConvertirFecha = CDate(valor)
        Exit Function

    End If


    texto = Trim$(CStr(valor))


    If texto = "" Then

        ConvertirFecha = Empty
        Exit Function

    End If


    texto = Replace(texto, "-", "/")
    texto = Replace(texto, ".", "/")


    p = Split(texto, "/")


    If UBound(p) <> 2 Then

        ConvertirFecha = Empty
        Exit Function

    End If


    d = CInt(p(0))
    m = CInt(p(1))
    a = CInt(p(2))


    If a < 100 Then a = a + 2000


    ConvertirFecha = _
        DateSerial(a, m, d)


    Exit Function


ErrorFecha:

    ConvertirFecha = Empty

End Function


'========================================================
' TEXTO SEGURO
'========================================================

Private Function TextoSeguro( _
    ByVal valor As Variant) As String

    If IsError(valor) Then

        TextoSeguro = ""

    ElseIf IsNull(valor) Then

        TextoSeguro = ""

    Else

        TextoSeguro = Trim$(CStr(valor))

    End If

End Function