Option Explicit

'========================================================
' REGISTRAR NUEVOS REGISTROS
'
' FUNCIONAMIENTO:
'
' - NO ES NECESARIO SELECCIONAR UNA FILA.
' - REVISA TODAS LAS FILAS DESDE LA 9 HASTA LA 5000.
' - REGISTRA TODAS LAS FILAS QUE TENGAN RFC.
' - IGNORA FILAS VACIAS.
' - CONSERVA FORMULAS.
' - CONSERVA DROP-DOWNS / VALIDACIONES.
' - LIMPIA SOLO LAS CELDAS DE CAPTURA.
'
'========================================================


Private Const HOJA_REGISTRAR As String = "REGISTRAR"

Private Const TABLA_ACCESS As String = "AHORRO_SOLIDARIO"

Private Const FILA_ENCABEZADOS As Long = 8

Private Const FILA_INICIAL As Long = 9

Private Const FILA_FINAL As Long = 5000

Private Const ULTIMA_COLUMNA As Long = 38

Private Const COLUMNA_RFC As Long = 1

Private Const COLUMNA_REVISO As Long = 36


'========================================================
' MACRO PRINCIPAL
'========================================================

Public Sub RegistrarNuevoRegistro()

    Dim ws As Worksheet

    Dim cn As Object
    Dim rsSchema As Object

    Dim camposAccess As Object

    Dim fila As Long

    Dim registrosGuardados As Long

    Dim filasConDatos As Long

    Dim filasSinRFC As Long

    Dim errores As Long

    Dim nombreCampo As String

    Dim camposNoEncontrados As String

    Dim rfcRegistrado As String

    Dim resultado As Boolean

    Dim ultimaColumna As Long

    Dim respuesta As VbMsgBoxResult

    Dim listaRFC As String

    Dim sql As String

    Dim i As Long


    On Error GoTo ErrorHandler


    '====================================================
    ' HOJA REGISTRAR
    '====================================================

    Set ws = _
        ThisWorkbook.Worksheets( _
            HOJA_REGISTRAR)


    ultimaColumna = ULTIMA_COLUMNA


    '====================================================
    ' COMPROBAR SI HAY ALGO CAPTURADO
    '====================================================

    For fila = FILA_INICIAL To FILA_FINAL

        If FilaTieneDatosCapturados( _
            ws, _
            fila, _
            ultimaColumna) Then

            filasConDatos = _
                filasConDatos + 1

        End If

    Next fila


    If filasConDatos = 0 Then

        MsgBox _
            "NO HAY REGISTROS PARA GUARDAR." & _
            vbCrLf & vbCrLf & _
            "Captura al menos un registro antes de presionar REGISTRAR.", _
            vbExclamation, _
            "REGISTRAR"

        Exit Sub

    End If


    '====================================================
    ' CONECTAR CON ACCESS
    '====================================================

    Application.ScreenUpdating = False

    Application.EnableEvents = False

    Application.StatusBar = _
        "Conectando con Access..."


    Set cn = _
        AbrirConexionAccess()


    If cn Is Nothing Then

        MsgBox _
            "NO SE PUDO ESTABLECER LA CONEXIÓN CON ACCESS.", _
            vbCritical, _
            "ERROR DE CONEXIÓN"

        GoTo Salir

    End If


    '====================================================
    ' OBTENER CAMPOS REALES DE ACCESS
    '====================================================

    Set camposAccess = _
        CreateObject("Scripting.Dictionary")


    camposAccess.CompareMode = 1


    Set rsSchema = _
        cn.Execute( _
            "SELECT TOP 1 * FROM [" & _
            TABLA_ACCESS & "]")


    For i = 0 To rsSchema.Fields.Count - 1

        camposAccess( _
            rsSchema.Fields(i).Name) = True

    Next i


    rsSchema.Close

    Set rsSchema = Nothing


    '====================================================
    ' COMPROBAR CAMPOS DE EXCEL CONTRA ACCESS
    '====================================================

    camposNoEncontrados = ""


    For i = 1 To ultimaColumna

        nombreCampo = _
            Trim$( _
                CStr( _
                    ws.Cells( _
                        FILA_ENCABEZADOS, _
                        i).Value))


        If nombreCampo <> "" Then

            If Not camposAccess.Exists( _
                nombreCampo) Then

                If camposNoEncontrados <> "" Then

                    camposNoEncontrados = _
                        camposNoEncontrados & _
                        vbCrLf

                End If


                camposNoEncontrados = _
                    camposNoEncontrados & _
                    "• " & nombreCampo

            End If

        End If

    Next i


    '====================================================
    ' CAMPOS DESCONOCIDOS
    '====================================================

    If camposNoEncontrados <> "" Then

        MsgBox _
            "NO SE PUEDE REGISTRAR TODAVÍA." & _
            vbCrLf & vbCrLf & _
            "ESTOS CAMPOS DE EXCEL NO COINCIDEN CON ACCESS:" & _
            vbCrLf & vbCrLf & _
            camposNoEncontrados, _
            vbCritical, _
            "CAMPOS NO ENCONTRADOS"

        GoTo Salir

    End If


    '====================================================
    ' REGISTRAR TODAS LAS FILAS
    '====================================================

    registrosGuardados = 0

    filasSinRFC = 0

    errores = 0

    listaRFC = ""


    For fila = FILA_INICIAL To FILA_FINAL


        '------------------------------------------------
        ' ¿LA FILA TIENE DATOS?
        '------------------------------------------------

        If FilaTieneDatosCapturados( _
            ws, _
            fila, _
            ultimaColumna) Then


            '--------------------------------------------
            ' RFC OBLIGATORIO
            '--------------------------------------------

            If Trim$( _
                CStr( _
                    ws.Cells( _
                        fila, _
                        COLUMNA_RFC).Value)) = "" Then


                filasSinRFC = _
                    filasSinRFC + 1


            Else


                '----------------------------------------
                ' GUARDAR RFC
                '----------------------------------------

                rfcRegistrado = _
                    CStr( _
                        ws.Cells( _
                            fila, _
                            COLUMNA_RFC).Value)


                Application.StatusBar = _
                    "Registrando fila " & _
                    fila & _
                    " - RFC: " & _
                    rfcRegistrado


                '----------------------------------------
                ' CONVERTIR TEXTOS A MAYÚSCULAS
                '----------------------------------------

                ConvertirFilaAMayusculas _
                    ws, _
                    fila, _
                    ultimaColumna


                '----------------------------------------
                ' REGISTRAR FILA
                '----------------------------------------

                resultado = _
                    RegistrarFilaEnAccess( _
                        ws, _
                        cn, _
                        camposAccess, _
                        fila, _
                        ultimaColumna)


                If resultado Then


                    registrosGuardados = _
                        registrosGuardados + 1


                    '------------------------------------
                    ' GUARDAR RFC PARA MENSAJE
                    '------------------------------------

                    If listaRFC <> "" Then

                        listaRFC = _
                            listaRFC & vbCrLf

                    End If


                    listaRFC = _
                        listaRFC & _
                        "• " & _
                        rfcRegistrado


                    '------------------------------------
                    ' AGREGAR REVISO A LA LISTA
                    '------------------------------------

                    ActualizarRevisoDeFila _
                        ws, _
                        fila


                    '------------------------------------
                    ' LIMPIAR SOLO DATOS
                    '
                    ' LAS FORMULAS Y VALIDACIONES
                    ' SE CONSERVAN.
                    '------------------------------------

                    LimpiarFilaSinBorrarFormulas _
                        ws, _
                        fila, _
                        ultimaColumna


                Else

                    errores = _
                        errores + 1

                End If


            End If

        End If


        DoEvents


    Next fila


    '====================================================
    ' CERRAR ACCESS
    '====================================================

    cn.Close

    Set cn = Nothing


    '====================================================
    ' RESULTADO
    '====================================================

    Application.EnableEvents = True

    Application.ScreenUpdating = True

    Application.StatusBar = False


    If registrosGuardados > 0 Then


        Dim mensaje As String


        mensaje = _
            "REGISTROS GUARDADOS CORRECTAMENTE." & _
            vbCrLf & vbCrLf & _
            "Cantidad de registros: " & _
            registrosGuardados


        If filasSinRFC > 0 Then

            mensaje = _
                mensaje & _
                vbCrLf & vbCrLf & _
                "Filas ignoradas por no tener RFC: " & _
                filasSinRFC

        End If


        If errores > 0 Then

            mensaje = _
                mensaje & _
                vbCrLf & vbCrLf & _
                "Registros con error: " & _
                errores

        End If


        mensaje = _
            mensaje & _
            vbCrLf & vbCrLf & _
            "Las filas registradas fueron limpiadas." & _
            vbCrLf & _
            "Las fórmulas y DropDowns se conservaron."


        MsgBox _
            mensaje, _
            vbInformation, _
            "AHORRO SOLIDARIO"


    Else


        MsgBox _
            "NO SE GUARDÓ NINGÚN REGISTRO." & _
            vbCrLf & vbCrLf & _
            "Filas sin RFC: " & filasSinRFC & _
            vbCrLf & _
            "Errores: " & errores, _
            vbExclamation, _
            "REGISTRAR"


    End If


    Exit Sub


'========================================================
' SALIDA
'========================================================

Salir:

    On Error Resume Next


    If Not rsSchema Is Nothing Then

        If rsSchema.State <> 0 Then

            rsSchema.Close

        End If

    End If


    If Not cn Is Nothing Then

        If cn.State <> 0 Then

            cn.Close

        End If

    End If


    Set rsSchema = Nothing

    Set cn = Nothing

    Set camposAccess = Nothing


    Application.StatusBar = False

    Application.EnableEvents = True

    Application.ScreenUpdating = True


    Exit Sub


'========================================================
' ERROR
'========================================================

ErrorHandler:


    Application.EnableEvents = True

    Application.ScreenUpdating = True

    Application.StatusBar = False


    MsgBox _
        "NO SE PUDO COMPLETAR EL REGISTRO." & _
        vbCrLf & vbCrLf & _
        "ERROR " & Err.Number & ":" & _
        vbCrLf & _
        Err.Description, _
        vbCritical, _
        "ERROR AL REGISTRAR"


    Resume Salir


End Sub


'========================================================
' REGISTRAR UNA FILA EN ACCESS
'========================================================

Private Function RegistrarFilaEnAccess( _
    ByVal ws As Worksheet, _
    ByVal cn As Object, _
    ByVal camposAccess As Object, _
    ByVal fila As Long, _
    ByVal ultimaColumna As Long) As Boolean


    Dim campos As String
    Dim valores As String

    Dim nombreCampo As String
    Dim valor As Variant

    Dim sql As String

    Dim i As Long


    On Error GoTo ErrorFila


    campos = ""

    valores = ""


    '====================================================
    ' CONSTRUIR INSERT
    '====================================================

    For i = 1 To ultimaColumna


        nombreCampo = _
            Trim$( _
                CStr( _
                    ws.Cells( _
                        FILA_ENCABEZADOS, _
                        i).Value))


        If nombreCampo <> "" Then


            If camposAccess.Exists( _
                nombreCampo) Then


                '----------------------------------------
                ' CAMPO
                '----------------------------------------

                If campos <> "" Then

                    campos = _
                        campos & ", "

                End If


                campos = _
                    campos & _
                    "[" & _
                    nombreCampo & _
                    "]"


                '----------------------------------------
                ' VALOR
                '----------------------------------------

                If valores <> "" Then

                    valores = _
                        valores & ", "

                End If


                valor = _
                    ws.Cells( _
                        fila, _
                        i).Value


                valores = _
                    valores & _
                    ConvertirValorSQL(valor)


            End If

        End If


    Next i


    '====================================================
    ' CREAR SQL
    '====================================================

    sql = _
        "INSERT INTO [" & _
        TABLA_ACCESS & "] (" & _
        campos & _
        ") VALUES (" & _
        valores & _
        ")"


    '====================================================
    ' EJECUTAR
    '====================================================

    cn.Execute sql


    RegistrarFilaEnAccess = True

    Exit Function


ErrorFila:


    MsgBox _
        "NO SE PUDO REGISTRAR LA FILA " & _
        fila & "." & _
        vbCrLf & vbCrLf & _
        "RFC: " & _
        CStr( _
            ws.Cells( _
                fila, _
                COLUMNA_RFC).Value) & _
        vbCrLf & vbCrLf & _
        "ERROR " & Err.Number & ":" & _
        vbCrLf & _
        Err.Description, _
        vbCritical, _
        "ERROR EN FILA " & fila


    RegistrarFilaEnAccess = False


End Function


'========================================================
' COMPROBAR SI UNA FILA TIENE DATOS CAPTURADOS
'
' IMPORTANTE:
'
' NO CUENTA LAS FORMULAS COMO DATOS.
'
' De esta manera una fila que solamente tiene:
'
' B = formula
' Q = formula
' R = TODAY()
'
' NO se considera una fila capturada.
'
'========================================================

Private Function FilaTieneDatosCapturados( _
    ByVal ws As Worksheet, _
    ByVal fila As Long, _
    ByVal ultimaColumna As Long) As Boolean


    Dim i As Long

    Dim valor As Variant


    FilaTieneDatosCapturados = False


    For i = 1 To ultimaColumna


        '------------------------------------------------
        ' IGNORAR CELDAS CON FORMULA
        '------------------------------------------------

        If Not ws.Cells( _
            fila, _
            i).HasFormula Then


            valor = _
                ws.Cells( _
                    fila, _
                    i).Value


            If Not IsError(valor) Then


                If Trim$( _
                    CStr(valor)) <> "" Then


                    FilaTieneDatosCapturados = True


                    Exit Function


                End If


            End If


        End If


    Next i


End Function


'========================================================
' CONVERTIR FILA A MAYUSCULAS
'
' NO MODIFICA FORMULAS.
'========================================================

Private Sub ConvertirFilaAMayusculas( _
    ByVal ws As Worksheet, _
    ByVal fila As Long, _
    ByVal ultimaColumna As Long)


    Dim i As Long


    For i = 1 To ultimaColumna


        If Not ws.Cells( _
            fila, _
            i).HasFormula Then


            If Not IsError( _
                ws.Cells( _
                    fila, _
                    i).Value) Then


                If VarType( _
                    ws.Cells( _
                        fila, _
                        i).Value) = vbString Then


                    ws.Cells( _
                        fila, _
                        i).Value = _
                        UCase$( _
                            Trim$( _
                                CStr( _
                                    ws.Cells( _
                                        fila, _
                                        i).Value)))


                End If

            End If

        End If


    Next i


End Sub


'========================================================
' LIMPIAR FILA SIN BORRAR FORMULAS
'
' IMPORTANTE:
'
' ClearContents NO se utiliza sobre toda la fila.
'
' Solamente se limpian las celdas que:
'
' 1. NO tienen fórmula.
'
' 2. Son datos capturados.
'
' Las validaciones / DropDowns permanecen.
'
'========================================================

Private Sub LimpiarFilaSinBorrarFormulas( _
    ByVal ws As Worksheet, _
    ByVal fila As Long, _
    ByVal ultimaColumna As Long)


    Dim i As Long


    For i = 1 To ultimaColumna


        If Not ws.Cells( _
            fila, _
            i).HasFormula Then


            If Not IsError( _
                ws.Cells( _
                    fila, _
                    i).Value) Then


                If Trim$( _
                    CStr( _
                        ws.Cells( _
                            fila, _
                            i).Value)) <> "" Then


                    ws.Cells( _
                        fila, _
                        i).ClearContents


                End If


            End If


        End If


    Next i


End Sub


'========================================================
' ACTUALIZAR REVISO
'
' Toma el nombre capturado en AJ y lo agrega al
' desplegable existente.
'========================================================

Private Sub ActualizarRevisoDeFila( _
    ByVal ws As Worksheet, _
    ByVal fila As Long)


    Dim nombreReviso As String


    nombreReviso = _
        Trim$( _
            UCase$( _
                CStr( _
                    ws.Cells( _
                        fila, _
                        COLUMNA_REVISO).Value)))


    If nombreReviso <> "" Then

        ActualizarListaReviso _
            nombreReviso

    End If


End Sub


'========================================================
' ACTUALIZAR LISTA DE REVISO
'
' AGREGA AUTOMÁTICAMENTE UN NOMBRE NUEVO
' AL DESPLEGABLE EXISTENTE.
'========================================================

Private Sub ActualizarListaReviso( _
    ByVal nombreNuevo As String)


    Dim ws As Worksheet

    Dim celda As Range

    Dim formulaActual As String
    Dim listaActual As String
    Dim nuevaLista As String

    Dim nombres As Variant

    Dim i As Long

    Dim existe As Boolean


    On Error GoTo Salir


    nombreNuevo = _
        Trim$( _
            UCase$(nombreNuevo))


    If nombreNuevo = "" Then

        Exit Sub

    End If


    Set ws = _
        ThisWorkbook.Worksheets( _
            HOJA_REGISTRAR)


    '====================================================
    ' REVISO = AJ
    '====================================================

    Set celda = _
        ws.Range("AJ9")


    On Error Resume Next


    If celda.Validation.Type <> _
       xlValidateList Then


        On Error GoTo 0

        Exit Sub

    End If


    formulaActual = _
        celda.Validation.Formula1


    On Error GoTo Salir


    '====================================================
    ' SI LA LISTA VIENE DE UN RANGO, NO MODIFICAR
    '====================================================

    If Left$( _
        formulaActual, _
        1) = "=" Then


        Exit Sub

    End If


    listaActual = _
        formulaActual


    '====================================================
    ' SEPARAR NOMBRES
    '====================================================

    nombres = _
        Split( _
            listaActual, _
            ",")


    '====================================================
    ' COMPROBAR SI YA EXISTE
    '====================================================

    For i = _
        LBound(nombres) To _
        UBound(nombres)


        If Trim$( _
            UCase$( _
                CStr( _
                    nombres(i)))) = _
            nombreNuevo Then


            existe = True

            Exit For


        End If


    Next i


    If existe Then

        Exit Sub

    End If


    '====================================================
    ' AGREGAR NOMBRE
    '====================================================

    nuevaLista = _
        listaActual & _
        "," & _
        nombreNuevo


    '====================================================
    ' ACTUALIZAR DESPLEGABLE
    '====================================================

    For Each celda In _
        ws.Range("AJ9:AJ5000")


        With celda.Validation


            .Delete


            .Add _
                Type:=xlValidateList, _
                AlertStyle:=xlValidAlertStop, _
                Operator:=xlBetween, _
                Formula1:=nuevaLista


            .IgnoreBlank = True

            .InCellDropdown = True

            .ShowInput = True

            .ShowError = False


        End With


    Next celda


Salir:


End Sub


'========================================================
' CONVERTIR VALORES DE EXCEL A SQL
'========================================================

Private Function ConvertirValorSQL( _
    ByVal valor As Variant) As String


    '----------------------------------------------------
    ' ERROR
    '----------------------------------------------------

    If IsError(valor) Then

        ConvertirValorSQL = "NULL"

        Exit Function

    End If


    '----------------------------------------------------
    ' VACIO
    '----------------------------------------------------

    If IsEmpty(valor) Then

        ConvertirValorSQL = "NULL"

        Exit Function

    End If


    '----------------------------------------------------
    ' TEXTO VACIO
    '----------------------------------------------------

    If Trim$( _
        CStr(valor)) = "" Then


        ConvertirValorSQL = "NULL"

        Exit Function

    End If


    '----------------------------------------------------
    ' FECHA
    '----------------------------------------------------

    If IsDate(valor) Then


        ConvertirValorSQL = _
            "#" & _
            Format( _
                CDate(valor), _
                "yyyy\/mm\/dd") & _
            "#"


        Exit Function


    End If


    '----------------------------------------------------
    ' NUMERO
    '----------------------------------------------------

    If IsNumeric(valor) Then


        ConvertirValorSQL = _
            Replace( _
                CStr(valor), _
                ",", _
                ".")


        Exit Function


    End If


    '----------------------------------------------------
    ' TEXTO
    '----------------------------------------------------

    ConvertirValorSQL = _
        "'" & _
        Replace( _
            CStr(valor), _
            "'", _
            "''") & _
        "'"


End Function

