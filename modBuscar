Option Explicit

'========================================================
' NORMALIZAR IDENTIFICADORES
'========================================================

Public Function LimpiarIdentificador(ByVal valor As Variant) As String

    Dim texto As String

    If IsNull(valor) Or IsEmpty(valor) Then
        LimpiarIdentificador = ""
        Exit Function
    End If

    texto = CStr(valor)

    texto = Trim(texto)
    texto = Replace(texto, " ", "")
    texto = Replace(texto, """", "")
    texto = Replace(texto, "'", "")
    texto = Replace(texto, vbCr, "")
    texto = Replace(texto, vbLf, "")

    texto = UCase(texto)

    LimpiarIdentificador = texto

End Function


'========================================================
' BUSCAR PERSONA
'========================================================

Public Sub BuscarPersona()

    Dim cn As Object
    Dim rs As Object
    Dim ws As Worksheet

    Dim sql As String
    Dim condiciones As String

    Dim rfc As String
    Dim rfcCompleto As String
    Dim curp As String

    Dim cantidad As Long
    Dim inicio As Double
    Dim tiempo As Double

    On Error GoTo ErrorHandler

    inicio = Timer

    Set ws = ThisWorkbook.Worksheets("BUSCAR")


    '====================================================
    ' LEER CAMPOS
    '====================================================

    rfc = LimpiarIdentificador(ws.Range("F5").Value)

    rfcCompleto = LimpiarIdentificador(ws.Range("F6").Value)

    curp = LimpiarIdentificador(ws.Range("F7").Value)


    '====================================================
    ' CONVERTIR A MAYÚSCULAS EN EL FORMULARIO
    '====================================================

    Application.EnableEvents = False

    ws.Range("F5").Value = rfc
    ws.Range("F6").Value = rfcCompleto
    ws.Range("F7").Value = curp

    Application.EnableEvents = True


    '====================================================
    ' VALIDAR
    '====================================================

    If rfc = "" And rfcCompleto = "" And curp = "" Then

        MsgBox "INGRESA AL MENOS UNO DE LOS SIGUIENTES DATOS:" & _
               vbCrLf & vbCrLf & _
               "• RFC" & _
               vbCrLf & _
               "• RFC_COMPLETO" & _
               vbCrLf & _
               "• CURP", _
               vbExclamation, _
               "BUSCAR PERSONA"

        Exit Sub

    End If


    '====================================================
    ' LIMPIAR RESULTADOS ANTERIORES
    '====================================================

    LimpiarResultados


    '====================================================
    ' CONEXIÓN
    '====================================================

    Set cn = AbrirConexionAccess()

    If cn Is Nothing Then Exit Sub


    '====================================================
    ' CONSTRUIR CONDICIONES
    '====================================================

    condiciones = ""


    If rfc <> "" Then

        condiciones = condiciones & _
            "[RFC] = '" & Replace(rfc, "'", "''") & "'"

    End If


    If rfcCompleto <> "" Then

        If condiciones <> "" Then
            condiciones = condiciones & " OR "
        End If

        condiciones = condiciones & _
            "[RFC_COMPLETO] = '" & _
            Replace(rfcCompleto, "'", "''") & "'"

    End If


    If curp <> "" Then

        If condiciones <> "" Then
            condiciones = condiciones & " OR "
        End If

        condiciones = condiciones & _
            "[CURP] = '" & _
            Replace(curp, "'", "''") & "'"

    End If


    '====================================================
    ' CONSULTA
    '====================================================

    sql = "SELECT * FROM [AHORRO_SOLIDARIO] WHERE " & condiciones


    Set rs = CreateObject("ADODB.Recordset")

    rs.Open sql, cn, 1, 1


    '====================================================
    ' SIN RESULTADOS
    '====================================================

    If rs.EOF Then

        MsgBox "NO SE ENCONTRÓ NINGÚN REGISTRO." & _
               vbCrLf & vbCrLf & _
               "Verifica el RFC, RFC_COMPLETO o CURP.", _
               vbInformation, _
               "SIN RESULTADOS"

        GoTo Salir

    End If


    '====================================================
    ' ESCRIBIR RESULTADOS
    '====================================================

    cantidad = 0


    Do While Not rs.EOF

        cantidad = cantidad + 1

        EscribirRegistroEnBuscar ws, rs, cantidad

        rs.MoveNext

    Loop


    '====================================================
    ' TIEMPO
    '====================================================

    tiempo = Timer - inicio

    If tiempo < 0 Then
        tiempo = tiempo + 86400
    End If


    '====================================================
    ' RESULTADO
    '====================================================

    MsgBox "BÚSQUEDA COMPLETADA." & _
           vbCrLf & vbCrLf & _
           "Registros encontrados: " & cantidad & _
           vbCrLf & _
           "Tiempo: " & Format(tiempo, "0.00") & " segundos.", _
           vbInformation, _
           "BÚSQUEDA COMPLETADA"


Salir:

    On Error Resume Next

    If Not rs Is Nothing Then

        If rs.State <> 0 Then
            rs.Close
        End If

    End If

    If Not cn Is Nothing Then

        If cn.State <> 0 Then
            cn.Close
        End If

    End If

    Set rs = Nothing
    Set cn = Nothing

    Application.EnableEvents = True
    Application.ScreenUpdating = True

    Exit Sub


ErrorHandler:

    Application.EnableEvents = True
    Application.ScreenUpdating = True

    MsgBox "OCURRIÓ UN ERROR DURANTE LA BÚSQUEDA." & _
           vbCrLf & vbCrLf & _
           "Error " & Err.Number & ":" & _
           vbCrLf & _
           Err.Description, _
           vbCritical, _
           "ERROR DE BÚSQUEDA"

    Resume Salir

End Sub


'========================================================
' ESCRIBIR UN REGISTRO
'========================================================

Private Sub EscribirRegistroEnBuscar( _
    ByVal ws As Worksheet, _
    ByVal rs As Object, _
    ByVal numeroRegistro As Long)

    Dim campo As Object
    Dim nombreCampo As String
    Dim valor As Variant

    Dim fila1 As Long
    Dim fila2 As Long
    Dim fila3 As Long
    Dim fila4 As Long


    '====================================================
    ' CADA BLOQUE TIENE 20 FILAS
    '====================================================

    If numeroRegistro <= 20 Then
        fila1 = 10 + numeroRegistro
    Else
        fila1 = 0
    End If


    If numeroRegistro <= 20 Then
        fila2 = 34 + numeroRegistro
    Else
        fila2 = 0
    End If


    If numeroRegistro <= 20 Then
        fila3 = 58 + numeroRegistro
    Else
        fila3 = 0
    End If


    If numeroRegistro <= 20 Then
        fila4 = 82 + numeroRegistro
    Else
        fila4 = 0
    End If


    '====================================================
    ' RECORRER LOS CAMPOS DE ACCESS
    '====================================================

    For Each campo In rs.Fields

        nombreCampo = campo.Name


        If IsNull(campo.Value) Then
            valor = ""
        Else
            valor = campo.Value
        End If


        '-----------------------------------------------
        ' DATOS DE LA PERSONA
        '-----------------------------------------------

        Select Case nombreCampo

            Case "RFC"
                If fila1 > 0 Then ws.Cells(fila1, 2).Value = valor

            Case "RFC_COMPLETO"
                If fila1 > 0 Then ws.Cells(fila1, 3).Value = valor

            Case "HOM"
                If fila1 > 0 Then ws.Cells(fila1, 4).Value = valor

            Case "PATERNO"
                If fila1 > 0 Then ws.Cells(fila1, 5).Value = valor

            Case "MATERNO"
                If fila1 > 0 Then ws.Cells(fila1, 6).Value = valor

            Case "NOMBRE"
                If fila1 > 0 Then ws.Cells(fila1, 7).Value = valor

            Case "CURP"
                If fila1 > 0 Then ws.Cells(fila1, 8).Value = valor

            Case "NIVEL"
                If fila1 > 0 Then ws.Cells(fila1, 9).Value = valor

            Case "UR"
                If fila1 > 0 Then ws.Cells(fila1, 10).Value = valor

            Case "POR_MEDIO_DE"
                If fila1 > 0 Then ws.Cells(fila1, 11).Value = valor


            '-----------------------------------------------
            ' DATOS DEL AHORRO
            '-----------------------------------------------

            Case "SOLICITA_PORCENTAJE"
                If fila2 > 0 Then ws.Cells(fila2, 2).Value = valor

            Case "PORCENTAJE"
                If fila2 > 0 Then ws.Cells(fila2, 3).Value = valor

            Case "QNA"
                If fila2 > 0 Then ws.Cells(fila2, 4).Value = valor

            Case "AÑO"
                If fila2 > 0 Then ws.Cells(fila2, 5).Value = valor

            Case "C_B"
                If fila2 > 0 Then ws.Cells(fila2, 6).Value = valor

            Case "FECHA_SOLICITA_AHORRO_O_CUANDO_INGRESO"
                If fila2 > 0 Then _
                    EscribirFechaBuscar ws, fila2, 7, valor

            Case "FECHA_APLICAR_AHORRO"
                If fila2 > 0 Then _
                    EscribirFechaBuscar ws, fila2, 8, valor

            Case "FECHA_HOY"
                If fila2 > 0 Then _
                    EscribirFechaBuscar ws, fila2, 9, valor

            Case "RESULTADO_ANALISIS"
                If fila2 > 0 Then ws.Cells(fila2, 10).Value = valor

            Case "QNA_APLICACION"
                If fila2 > 0 Then ws.Cells(fila2, 11).Value = valor


            '-----------------------------------------------
            ' RÉGIMEN / APLICACIÓN
            '-----------------------------------------------

            Case "OBSERVACIONES"
                If fila3 > 0 Then ws.Cells(fila3, 2).Value = valor

            Case "REGIMEN_EN_SINAVID_ISSSTE"
                If fila3 > 0 Then ws.Cells(fila3, 3).Value = valor

            Case "REGIMEN_EN_SIRI_ES_EL_QUE_MAS_IMPORTANCIA_TIENE_PARA_APLIC"
                If fila3 > 0 Then ws.Cells(fila3, 4).Value = valor

            Case "DIA_EN_QUE_SE_TRABAJA_LA_SOLICITUD"
                If fila3 > 0 Then ws.Cells(fila3, 5).Value = valor

            Case "SARH_APLICACION_DE_AHORRO_SOLIDARIO"
                If fila3 > 0 Then ws.Cells(fila3, 6).Value = valor

            Case "ACTIVO_INACTIVO_EN_ISSSTE_PARA_DAR_ALTA_O_BAJA"
                If fila3 > 0 Then ws.Cells(fila3, 7).Value = valor

            Case "CURP'S_HISTORICAS_POR_SI_NO_SE_PUEDE_ACCEDER_A_SINAVID"
                If fila3 > 0 Then ws.Cells(fila3, 8).Value = valor

            Case "SOLICITUDES_POR_OFICIO"
                If fila3 > 0 Then ws.Cells(fila3, 9).Value = valor

            Case "OFICIO_FOLIO"
                If fila3 > 0 Then ws.Cells(fila3, 10).Value = valor

            Case "CORREO_ELECTRONICO"
                If fila3 > 0 Then ws.Cells(fila3, 11).Value = valor

            Case "DESCARGO_SAC"
                'No hay columna disponible en el diseño actual.
                'Se agregará al ajustar la tabla.


            '-----------------------------------------------
            ' CONTROL Y SEGUIMIENTO
            '-----------------------------------------------

            Case "AREA_DIRECCION"
                If fila4 > 0 Then ws.Cells(fila4, 2).Value = valor

            Case "CONTEO_OFICIOS"
                If fila4 > 0 Then ws.Cells(fila4, 3).Value = valor

            Case "MES_DE_CAPTURA"
                If fila4 > 0 Then ws.Cells(fila4, 4).Value = valor

            Case "ALTA_BAJA"
                If fila4 > 0 Then ws.Cells(fila4, 5).Value = valor

            Case "REVISO"
                If fila4 > 0 Then ws.Cells(fila4, 6).Value = valor

            Case "ESCANER_-_SEPARADO"
                If fila4 > 0 Then ws.Cells(fila4, 7).Value = valor

            Case "SEXO"
                If fila4 > 0 Then ws.Cells(fila4, 8).Value = valor

        End Select

    Next campo

End Sub


'========================================================
' ESCRIBIR FECHA EN BUSCAR
'
' IMPORTANTE:
' Access puede entregar:
'
' 1) Una fecha real
' 2) Texto DD/MM/YYYY
' 3) Un número serial de Excel
'
' Esta rutina evita que:
'
' 01/08/2026
'
' se convierta en:
'
' 08/01/2026
'
'========================================================

Private Sub EscribirFechaBuscar( _
    ByVal ws As Worksheet, _
    ByVal fila As Long, _
    ByVal columna As Long, _
    ByVal valor As Variant)

    Dim fechaReal As Variant

    If IsNull(valor) Or IsEmpty(valor) Then

        ws.Cells(fila, columna).ClearContents

        Exit Sub

    End If


    If Trim$(CStr(valor)) = "" Then

        ws.Cells(fila, columna).ClearContents

        Exit Sub

    End If


    fechaReal = ConvertirFechaBuscar(valor)


    If IsDate(fechaReal) Then

        ws.Cells(fila, columna).Value = CDate(fechaReal)

        ws.Cells(fila, columna).NumberFormat = "dd/mm/yyyy"

    Else

        ws.Cells(fila, columna).Value = valor

        ws.Cells(fila, columna).NumberFormat = "dd/mm/yyyy"

    End If

End Sub


'========================================================
' CONVERTIR FECHA PARA BUSCAR
'
' DD/MM/YYYY SE INTERPRETA SIEMPRE COMO:
'
' DIA / MES / AÑO
'
' TAMBIEN SOPORTA NUMEROS SERIAL DE EXCEL.
'========================================================

Private Function ConvertirFechaBuscar( _
    ByVal valor As Variant) As Variant

    Dim texto As String
    Dim partes As Variant

    Dim dia As Long
    Dim mes As Long
    Dim anio As Long

    Dim numeroSerial As Double


    On Error GoTo ErrorFecha


    '====================================================
    ' FECHA REAL
    '====================================================

    If VarType(valor) = vbDate Then

        ConvertirFechaBuscar = CDate(valor)

        Exit Function

    End If


    '====================================================
    ' TEXTO
    '====================================================

    texto = Trim$(CStr(valor))


    If texto = "" Then

        ConvertirFechaBuscar = ""

        Exit Function

    End If


    '====================================================
    ' SI ES UN NUMERO PURO
    '
    ' EJEMPLO:
    '
    ' 39129
    ' 46260
    '
    ' SE TRATA COMO SERIAL DE EXCEL.
    '====================================================

    If IsNumeric(texto) Then

        If InStr(1, texto, "/") = 0 And _
           InStr(1, texto, "-") = 0 Then

            numeroSerial = CDbl(texto)

            If numeroSerial > 0 And _
               numeroSerial < 1000000 Then

                ConvertirFechaBuscar = _
                    DateSerial(1899, 12, 30) + numeroSerial

                Exit Function

            End If

        End If

    End If


    '====================================================
    ' QUITAR HORA
    '====================================================

    If InStr(1, texto, " ") > 0 Then

        texto = _
            Left$( _
                texto, _
                InStr(1, texto, " ") - 1)

    End If


    If InStr(1, texto, "T") > 0 Then

        texto = _
            Left$( _
                texto, _
                InStr(1, texto, "T") - 1)

    End If


    '====================================================
    ' CAMBIAR GUIONES POR /
    '====================================================

    texto = Replace(texto, "-", "/")


    '====================================================
    ' SEPARAR
    '====================================================

    partes = Split(texto, "/")


    If UBound(partes) <> 2 Then

        GoTo ErrorFecha

    End If


    '====================================================
    ' YYYY/MM/DD
    '====================================================

    If Len(Trim$(partes(0))) = 4 Then

        anio = CLng(Trim$(partes(0)))

        mes = CLng(Trim$(partes(1)))

        dia = CLng(Trim$(partes(2)))


    Else

        '================================================
        ' DD/MM/YYYY
        '================================================

        dia = CLng(Trim$(partes(0)))

        mes = CLng(Trim$(partes(1)))

        anio = CLng(Trim$(partes(2)))

    End If


    '====================================================
    ' VALIDAR
    '====================================================

    If dia < 1 Or dia > 31 Then

        GoTo ErrorFecha

    End If


    If mes < 1 Or mes > 12 Then

        GoTo ErrorFecha

    End If


    If anio < 1900 Or anio > 2100 Then

        GoTo ErrorFecha

    End If


    '====================================================
    ' CREAR FECHA SIN CDate SOBRE EL TEXTO
    '====================================================

    ConvertirFechaBuscar = _
        DateSerial( _
            anio, _
            mes, _
            dia)


    Exit Function


ErrorFecha:

    ConvertirFechaBuscar = valor

End Function


'========================================================
' LIMPIAR RESULTADOS
'========================================================

Public Sub LimpiarResultados()

    Dim ws As Worksheet

    Set ws = ThisWorkbook.Worksheets("BUSCAR")

    Application.ScreenUpdating = False

    'Bloque 1
    ws.Range("B11:K30").ClearContents

    'Bloque 2
    ws.Range("B35:K54").ClearContents

    'Bloque 3
    ws.Range("B59:K78").ClearContents

    'Bloque 4
    ws.Range("B83:K102").ClearContents

    Application.ScreenUpdating = True

End Sub


'========================================================
' BOTÓN LIMPIAR
'========================================================

Public Sub LimpiarBusqueda()

    Dim ws As Worksheet

    On Error GoTo ErrorHandler

    Set ws = ThisWorkbook.Worksheets("BUSCAR")

    Application.ScreenUpdating = False
    Application.EnableEvents = False


    'Campos de búsqueda

    ws.Range("F5").ClearContents
    ws.Range("F6").ClearContents
    ws.Range("F7").ClearContents


    'Resultados

    LimpiarResultados


    'Regresar al RFC

    ws.Activate
    ws.Range("F5").Select


Salir:

    Application.EnableEvents = True
    Application.ScreenUpdating = True

    Exit Sub


ErrorHandler:

    MsgBox "NO SE PUDO LIMPIAR LA BÚSQUEDA." & _
           vbCrLf & vbCrLf & _
           "Error " & Err.Number & ":" & _
           vbCrLf & _
           Err.Description, _
           vbCritical, _
           "ERROR"

    Resume Salir

End Sub


