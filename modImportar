'========================================================
' NORMALIZAR TEXTO
'========================================================

Private Function NormalizarTexto( _
    ByVal texto As String) As String

    texto = _
        UCase(Trim(texto))

    texto = _
        Replace(texto, "Á", "A")

    texto = _
        Replace(texto, "É", "E")

    texto = _
        Replace(texto, "Í", "I")

    texto = _
        Replace(texto, "Ó", "O")

    texto = _
        Replace(texto, "Ú", "U")

    texto = _
        Replace(texto, "Ü", "U")

    texto = _
        Replace(texto, "Ñ", "N")

    texto = _
        Replace(texto, " ", "")

    texto = _
        Replace(texto, ".", "")

    texto = _
        Replace(texto, "-", "")

    texto = _
        Replace(texto, "_", "")

    texto = _
        Replace(texto, "/", "")

    texto = _
        Replace(texto, "\", "")

    texto = _
        Replace(texto, "(", "")

    texto = _
        Replace(texto, ")", "")

    texto = _
        Replace(texto, ":", "")

    NormalizarTexto = texto

End Function


'========================================================
' OBTENER FECHA EXTERNA
'========================================================

Private Function ObtenerFechaExterna( _
    ByVal ws As Worksheet, _
    ByVal fila As Long, _
    ByVal encabezados As Object) As Variant

    Dim i As Variant
    Dim campo As String
    Dim valor As Variant

    For Each i In encabezados.Keys

        campo = encabezados(i)

        If campo = "FECHA_HOY" Or _
           campo = "FECHA_SOLICITA_AHORRO_O_CUANDO_INGRESO" Or _
           campo = "FECHA_APLICAR_AHORRO" Then

            valor = ws.Cells(fila, i).Value

            If IsDate(valor) Then

                ObtenerFechaExterna = CDate(valor)

                Exit Function

            End If

        End If

    Next i

    ObtenerFechaExterna = Empty

End Function


'========================================================
' COMPARAR FECHAS
'========================================================

Private Function EsFechaMasReciente( _
    ByVal fechaNueva As Variant, _
    ByVal fechaAnterior As Variant) As Boolean

    If Not IsDate(fechaNueva) Then

        EsFechaMasReciente = False

        Exit Function

    End If

    If Not IsDate(fechaAnterior) Then

        EsFechaMasReciente = True

        Exit Function

    End If

    EsFechaMasReciente = _
        CDate(fechaNueva) > CDate(fechaAnterior)

End Function


'========================================================
' BUSCAR EN ACCESS
'
' Esta función utiliza la conexión que ya tenemos.
'========================================================

Private Function BuscarRegistroAccess( _
    ByVal rfc As String, _
    ByVal curp As String, _
    ByVal rfcCompleto As String, _
    ByRef fechaEncontrada As Variant) As Boolean

    Dim cn As Object
    Dim rs As Object

    Dim sql As String
    Dim condiciones As String

    On Error GoTo ErrorHandler

    Set cn = AbrirConexionAccess()

    If cn Is Nothing Then Exit Function

    condiciones = ""

    If rfc <> "" Then

        condiciones = _
            "[RFC]='" & _
            Replace(rfc, "'", "''") & _
            "'"

    ElseIf curp <> "" Then

        condiciones = _
            "[CURP]='" & _
            Replace(curp, "'", "''") & _
            "'"

    ElseIf rfcCompleto <> "" Then

        condiciones = _
            "[RFC_COMPLETO]='" & _
            Replace(rfcCompleto, "'", "''") & _
            "'"

    Else

        GoTo Salir

    End If

    sql = _
        "SELECT TOP 1 [FECHA_HOY], " & _
        "[FECHA_SOLICITA_AHORRO_O_CUANDO_INGRESO], " & _
        "[FECHA_APLICAR_AHORRO] " & _
        "FROM [AHORRO_SOLIDARIO] " & _
        "WHERE " & condiciones

    Set rs = cn.Execute(sql)

    If Not rs.EOF Then

        BuscarRegistroAccess = True

        If Not IsNull(rs.Fields("FECHA_HOY").Value) Then

            fechaEncontrada = _
                rs.Fields("FECHA_HOY").Value

        ElseIf Not IsNull( _
            rs.Fields( _
                "FECHA_SOLICITA_AHORRO_O_CUANDO_INGRESO" _
            ).Value _
        ) Then

            fechaEncontrada = _
                rs.Fields( _
                    "FECHA_SOLICITA_AHORRO_O_CUANDO_INGRESO" _
                ).Value

        ElseIf Not IsNull( _
            rs.Fields("FECHA_APLICAR_AHORRO").Value _
        ) Then

            fechaEncontrada = _
                rs.Fields("FECHA_APLICAR_AHORRO").Value

        End If

    End If

Salir:

    On Error Resume Next

    rs.Close
    cn.Close

    Set rs = Nothing
    Set cn = Nothing

    Exit Function

ErrorHandler:

    BuscarRegistroAccess = False

    Resume Salir

End Function


'========================================================
' SIGUIENTE FILA LIBRE DE REGISTRAR
'========================================================

Private Function SiguienteFilaRegistrar( _
    ByVal ws As Worksheet) As Long

    Dim fila As Long

    fila = 9

    Do While _
        Trim(CStr(ws.Cells(fila, 1).Value)) <> ""

        fila = fila + 1

        If fila > 5000 Then

            MsgBox _
                "NO HAY MÁS FILAS DISPONIBLES EN REGISTRAR.", _
                vbCritical, _
                "REGISTRAR"

            SiguienteFilaRegistrar = 0

            Exit Function

        End If

    Loop

    SiguienteFilaRegistrar = fila

End Function


'========================================================
' COPIAR REGISTRO A REGISTRAR
'========================================================

Private Sub CopiarRegistroARegistrar( _
    ByVal wsOrigen As Worksheet, _
    ByVal wsDestino As Worksheet, _
    ByVal filaOrigen As Long, _
    ByVal filaDestino As Long, _
    ByVal encabezados As Object)

    Dim i As Variant
    Dim campo As String
    Dim valor As Variant
    Dim columnaDestino As Long

    For Each i In encabezados.Keys

        campo = encabezados(i)

        If campo <> "RFC_COMPLETO" Then

            columnaDestino = _
                ColumnaPorEncabezado( _
                    wsDestino, _
                    campo _
                )

            If columnaDestino > 0 Then

                valor = _
                    wsOrigen.Cells( _
                        filaOrigen, _
                        i _
                    ).Value

                If Not IsError(valor) Then

                    wsDestino.Cells( _
                        filaDestino, _
                        columnaDestino _
                    ).Value = valor

                End If

            End If

        End If

    Next i

    '--------------------------------------------
    ' RFC_COMPLETO queda con su fórmula.
    '--------------------------------------------

    wsDestino.Cells( _
        filaDestino, _
        2 _
    ).Formula = _
        "=IF(OR(A" & filaDestino & _
        "="""",C" & filaDestino & _
        "=""""),"""",A" & filaDestino & _
        "&C" & filaDestino & ")"

    '--------------------------------------------
    ' FECHAS AUTOMÁTICAS
    '--------------------------------------------

    wsDestino.Cells( _
        filaDestino, _
        17 _
    ).Formula = _
        "=IF(P" & filaDestino & _
        "="""","""",P" & filaDestino & "+90)"

    wsDestino.Cells( _
        filaDestino, _
        18 _
    ).Formula = "=TODAY()"

    wsDestino.Cells( _
        filaDestino, _
        13 _
    ).NumberFormat = "00"

End Sub


'========================================================
' ENCONTRAR COLUMNA POR ENCABEZADO
'========================================================

Private Function ColumnaPorEncabezado( _
    ByVal ws As Worksheet, _
    ByVal nombreBuscado As String) As Long

    Dim c As Long
    Dim encabezado As String

    For c = 1 To 38

        encabezado = _
            NormalizarTexto( _
                CStr(ws.Cells(8, c).Value) _
            )

        If encabezado = _
            NormalizarTexto(nombreBuscado) Then

            ColumnaPorEncabezado = c

            Exit Function

        End If

    Next c

    ColumnaPorEncabezado = 0

End Function
