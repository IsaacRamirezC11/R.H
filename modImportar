Option Explicit

'========================================================
' MODIMPORTAR
'
' IMPORTA OTROS ARCHIVOS DE EXCEL
'
' - Busca encabezados aunque estén en otra fila.
' - Busca equivalencias de nombres.
' - Compara contra Access.
' - Si no existe, lo manda a REGISTRAR.
' - Si existe y el archivo externo es más reciente,
'   también lo manda a REGISTRAR.
'
' NO IMPORTA ID.
'
' RFC_COMPLETO SE CONSERVA COMO FÓRMULA.
'========================================================

Private Const HOJA_REGISTRAR As String = "REGISTRAR"
Private Const TABLA_ACCESS As String = "MOVIMIENTOS"
Private Const FILA_INICIO As Long = 9


'========================================================
' BOTÓN PRINCIPAL
'========================================================

Public Sub ImportarArchivoExterno()

    Dim fd As FileDialog
    Dim ruta As String
    Dim extension As String

    On Error GoTo ErrorHandler

    Set fd = Application.FileDialog(msoFileDialogFilePicker)

    With fd

        .Title = "Seleccionar archivo"

        .AllowMultiSelect = False

        .Filters.Clear

        .Filters.Add _
            "Archivos Excel", _
            "*.xlsx;*.xls;*.xlsm"

        .Filters.Add _
            "Archivos PDF", _
            "*.pdf"

        If .Show <> -1 Then Exit Sub

        ruta = .SelectedItems(1)

    End With


    extension = LCase$( _
        Mid$(ruta, InStrRev(ruta, ".") + 1))


    Select Case extension

        Case "xlsx", "xls", "xlsm"

            ImportarExcel ruta


        Case "pdf"

            MsgBox _
                "Seleccionaste un PDF." & vbCrLf & vbCrLf & _
                "La lectura automática de PDF todavía " & _
                "no está activada en esta versión." & vbCrLf & vbCrLf & _
                "La importación de Excel sí está lista.", _
                vbInformation, _
                "IMPORTAR PDF"


        Case Else

            MsgBox _
                "Tipo de archivo no compatible.", _
                vbExclamation, _
                "IMPORTAR"

    End Select

    Exit Sub


ErrorHandler:

    MsgBox _
        "ERROR AL SELECCIONAR EL ARCHIVO." & vbCrLf & vbCrLf & _
        Err.Number & " - " & Err.Description, _
        vbCritical, _
        "IMPORTAR"

End Sub


'========================================================
' IMPORTAR EXCEL
'========================================================

Private Sub ImportarExcel(ByVal ruta As String)

    Dim wb As Workbook
    Dim wsOrigen As Worksheet
    Dim wsDestino As Worksheet

    Dim ultimaFila As Long
    Dim ultimaColumna As Long

    Dim filaEncabezados As Long
    Dim fila As Long
    Dim filaDestino As Long

    Dim mapa As Object
    Dim equivalencias As Object

    Dim i As Long

    Dim rfc As String
    Dim curp As String
    Dim rfcCompleto As String

    Dim fechaNueva As Variant
    Dim fechaAccess As Variant

    Dim existe As Boolean

    Dim cargados As Long
    Dim ignorados As Long


    On Error GoTo ErrorHandler


    Application.ScreenUpdating = False
    Application.EnableEvents = False


    Set wsDestino = _
        ThisWorkbook.Worksheets(HOJA_REGISTRAR)


    '====================================================
    ' ABRIR ARCHIVO EXTERNO
    '====================================================

    Set wb = Workbooks.Open( _
        Filename:=ruta, _
        ReadOnly:=True)


    Set wsOrigen = wb.Worksheets(1)


    '====================================================
    ' BUSCAR ÚLTIMA FILA
    '====================================================

    ultimaFila = _
        wsOrigen.Cells.Find( _
            What:="*", _
            SearchOrder:=xlByRows, _
            SearchDirection:=xlPrevious).Row


    ultimaColumna = _
        wsOrigen.Cells.Find( _
            What:="*", _
            SearchOrder:=xlByColumns, _
            SearchDirection:=xlPrevious).Column


    '====================================================
    ' BUSCAR ENCABEZADOS
    '====================================================

    filaEncabezados = _
        BuscarFilaEncabezados( _
            wsOrigen, _
            ultimaFila, _
            ultimaColumna)


    If filaEncabezados = 0 Then

        MsgBox _
            "No se encontró una fila de encabezados compatible." & _
            vbCrLf & vbCrLf & _
            "Se necesita encontrar por lo menos RFC, CURP o NOMBRE.", _
            vbExclamation, _
            "IMPORTAR"

        GoTo Salir

    End If


    '====================================================
    ' CREAR EQUIVALENCIAS
    '====================================================

    Set equivalencias = CrearEquivalencias()

    Set mapa = _
        CreateObject("Scripting.Dictionary")

    mapa.CompareMode = vbTextCompare


    '====================================================
    ' LEER ENCABEZADOS DEL ARCHIVO
    '====================================================

    For i = 1 To ultimaColumna

        Dim encabezado As String

        encabezado = _
            NormalizarTexto( _
                TextoSeguro( _
                    wsOrigen.Cells( _
                        filaEncabezados, i).Value))


        If encabezado <> "" Then

            If equivalencias.Exists(encabezado) Then

                mapa(i) = equivalencias(encabezado)

            End If

        End If

    Next i


    If mapa.Count = 0 Then

        MsgBox _
            "No se encontraron encabezados equivalentes.", _
            vbExclamation, _
            "IMPORTAR"

        GoTo Salir

    End If


    '====================================================
    ' PRIMERA FILA LIBRE
    '====================================================

    filaDestino = _
        PrimeraFilaLibre(wsDestino)


    If filaDestino = 0 Then GoTo Salir


    '====================================================
    ' LEER REGISTROS
    '====================================================

    For fila = filaEncabezados + 1 To ultimaFila


        rfc = _
            ObtenerCampo( _
                wsOrigen, fila, mapa, "RFC")


        curp = _
            ObtenerCampo( _
                wsOrigen, fila, mapa, "CURP")


        rfcCompleto = _
            ObtenerCampo( _
                wsOrigen, fila, mapa, "RFC_COMPLETO")


        '------------------------------------------------
        ' SI NO TIENE IDENTIFICADOR, SE IGNORA
        '------------------------------------------------

        If rfc = "" And _
           curp = "" And _
           rfcCompleto = "" Then

            ignorados = ignorados + 1

            GoTo Siguiente

        End If


        fechaNueva = _
            ObtenerFechaCampo( _
                wsOrigen, _
                fila, _
                mapa, _
                "FECHA_SOLICITA_AHORRO_O_CUANDO_INGRESO")


        '------------------------------------------------
        ' BUSCAR EN ACCESS
        '------------------------------------------------

        fechaAccess = Empty

        existe = _
            BuscarEnAccess( _
                rfc, _
                curp, _
                rfcCompleto, _
                fechaAccess)


        '------------------------------------------------
        ' NO EXISTE
        '------------------------------------------------

        If Not existe Then

            CopiarRegistro _
                wsOrigen, _
                wsDestino, _
                fila, _
                filaDestino, _
                mapa

            filaDestino = filaDestino + 1

            cargados = cargados + 1


        '------------------------------------------------
        ' EXISTE PERO EL EXTERNO ES MÁS RECIENTE
        '------------------------------------------------

        ElseIf EsMasReciente( _
                    fechaNueva, _
                    fechaAccess) Then

            CopiarRegistro _
                wsOrigen, _
                wsDestino, _
                fila, _
                filaDestino, _
                mapa

            filaDestino = filaDestino + 1

            cargados = cargados + 1


        Else

            ignorados = ignorados + 1

        End If


Siguiente:

    Next fila


    MsgBox _
        "IMPORTACIÓN TERMINADA." & vbCrLf & vbCrLf & _
        "Registros enviados a REGISTRAR: " & cargados & vbCrLf & _
        "Registros ignorados: " & ignorados & vbCrLf & vbCrLf & _
        "Revisa los registros antes de utilizar CREAR.", _
        vbInformation, _
        "IMPORTAR"


Salir:

    On Error Resume Next

    If Not wb Is Nothing Then _
        wb.Close SaveChanges:=False

    Application.EnableEvents = True
    Application.ScreenUpdating = True

    Exit Sub


ErrorHandler:

    MsgBox _
        "ERROR DURANTE LA IMPORTACIÓN." & vbCrLf & vbCrLf & _
        Err.Number & " - " & Err.Description, _
        vbCritical, _
        "IMPORTAR"

    Resume Salir

End Sub


'========================================================
' BUSCAR FILA DE ENCABEZADOS
'========================================================

Private Function BuscarFilaEncabezados( _
    ByVal ws As Worksheet, _
    ByVal ultimaFila As Long, _
    ByVal ultimaColumna As Long) As Long

    Dim f As Long
    Dim c As Long

    Dim texto As String

    Dim tieneRFC As Boolean
    Dim tieneCURP As Boolean
    Dim tieneNombre As Boolean


    For f = 1 To ultimaFila

        tieneRFC = False
        tieneCURP = False
        tieneNombre = False


        For c = 1 To ultimaColumna

            texto = _
                NormalizarTexto( _
                    TextoSeguro( _
                        ws.Cells(f, c).Value))


            Select Case texto

                Case "RFC", _
                     "RFCFISCAL", _
                     "REGISTROFEDERALDECONTRIBUYENTES"

                    tieneRFC = True


                Case "CURP"

                    tieneCURP = True


                Case "NOMBRE", _
                     "NOMBRES", _
                     "NOMBRECOMPLETO"

                    tieneNombre = True

            End Select

        Next c


        If tieneRFC Or _
           tieneCURP Or _
           tieneNombre Then

            BuscarFilaEncabezados = f

            Exit Function

        End If

    Next f


    BuscarFilaEncabezados = 0

End Function


