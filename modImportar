'========================================================
' 6. NORMALIZAR TEXTO
'========================================================

Private Function NormalizarTexto( _
    ByVal texto As String) As String

    texto = UCase(Trim(texto))

    texto = Replace(texto, "Á", "A")
    texto = Replace(texto, "É", "E")
    texto = Replace(texto, "Í", "I")
    texto = Replace(texto, "Ó", "O")
    texto = Replace(texto, "Ú", "U")
    texto = Replace(texto, "Ü", "U")
    texto = Replace(texto, "Ñ", "N")

    texto = Replace(texto, " ", "")
    texto = Replace(texto, ".", "")
    texto = Replace(texto, "-", "")
    texto = Replace(texto, "_", "")
    texto = Replace(texto, "/", "")
    texto = Replace(texto, "\", "")
    texto = Replace(texto, "(", "")
    texto = Replace(texto, ")", "")
    texto = Replace(texto, ":", "")
    texto = Replace(texto, "'", "")

    NormalizarTexto = texto

End Function



'========================================================
' 7. TEXTO SEGURO
'========================================================

Private Function TextoSeguro( _
    ByVal valor As Variant) As String

    If IsError(valor) Then

        TextoSeguro = ""

    ElseIf IsNull(valor) Then

        TextoSeguro = ""

    Else

        TextoSeguro = Trim(CStr(valor))

    End If

End Function



'========================================================
' 8. OBTENER FECHA DE SOLICITUD
'========================================================

Private Function ObtenerFechaSolicitud( _
    ByVal ws As Worksheet, _
    ByVal fila As Long, _
    ByVal encabezados As Object) As Variant

    Dim i As Variant
    Dim campo As String
    Dim valor As Variant


    For Each i In encabezados.Keys

        campo = encabezados(i)


        If campo = _
            "FECHA_SOLICITA_AHORRO_O_CUANDO_INGRESO" Then


            valor = _
                ws.Cells( _
                    fila, _
                    i).Value


            ObtenerFechaSolicitud = _
                ConvertirFechaDMY(valor)


            Exit Function

        End If

    Next i


    ObtenerFechaSolicitud = Empty

End Function



'========================================================
' 9. CONVERTIR FECHA DD/MM/YYYY
'
' Access la guarda como Texto corto.
'========================================================

Private Function ConvertirFechaDMY( _
    ByVal valor As Variant) As Variant

    Dim texto As String
    Dim partes() As String

    Dim dia As Integer
    Dim mes As Integer
    Dim anio As Integer


    On Error GoTo ErrorFecha


    If IsError(valor) Or IsNull(valor) Then

        ConvertirFechaDMY = Empty

        Exit Function

    End If


    If IsDate(valor) And _
       VarType(valor) = vbDate Then

        ConvertirFechaDMY = CDate(valor)

        Exit Function

    End If


    texto = Trim(CStr(valor))


    If texto = "" Then

        ConvertirFechaDMY = Empty

        Exit Function

    End If


    texto = Replace(texto, "-", "/")
    texto = Replace(texto, ".", "/")


    partes = Split(texto, "/")


    If UBound(partes) <> 2 Then

        ConvertirFechaDMY = Empty

        Exit Function

    End If


    dia = CInt(partes(0))
    mes = CInt(partes(1))
    anio = CInt(partes(2))


    If anio < 100 Then

        anio = anio + 2000

    End If


    ConvertirFechaDMY = _
        DateSerial(anio, mes, dia)


    Exit Function


ErrorFecha:

    ConvertirFechaDMY = Empty

End Function



'========================================================
' 10. BUSCAR EN ACCESS
'
' IMPORTANTE:
' Se utiliza la función de conexión que YA TIENES.
'
' AbrirConexionAccess
'
' Si tu módulo de conexión tiene otro nombre,
' NO cambies este código todavía.
'========================================================

Private Function BuscarRegistroAccess( _
    ByVal rfc As String, _
    ByVal curp As String, _
    ByVal rfcCompleto As String, _
    ByRef fechaEncontrada As Variant) As Boolean


    Dim cn As Object
    Dim rs As Object

    Dim sql As String
    Dim condiciones As String

    Dim fechaActual As Variant
    Dim fechaMayor As Variant

    Dim encontro As Boolean


    On Error GoTo ErrorHandler


    Set cn = AbrirConexionAccess()


    If cn Is Nothing Then Exit Function


    condiciones = ""


    If rfc <> "" Then

        condiciones = _
            "[RFC]='" & _
            Replace(rfc, "'", "''") & _
            "'"

    End If


    If curp <> "" Then

        If condiciones <> "" Then _
            condiciones = condiciones & " OR "

        condiciones = condiciones & _
            "[CURP]='" & _
            Replace(curp, "'", "''") & _
            "'"

    End If


    If rfcCompleto <> "" Then

        If condiciones <> "" Then _
            condiciones = condiciones & " OR "

        condiciones = condiciones & _
            "[RFC_COMPLETO]='" & _
            Replace(rfcCompleto, "'", "''") & _
            "'"

    End If


    If condiciones = "" Then GoTo Salir


    sql = _
        "SELECT [FECHA_SOLICITA_AHORRO_O_CUANDO_INGRESO] " & _
        "FROM [AHORRO_SOLIDARIO] " & _
        "WHERE " & condiciones


    Set rs = cn.Execute(sql)


    fechaMayor = Empty
    encontro = False


    Do While Not rs.EOF

        encontro = True


        fechaActual = _
            ConvertirFechaDMY( _
                rs.Fields( _
                    "FECHA_SOLICITA_AHORRO_O_CUANDO_INGRESO" _
                ).Value)


        If Not IsEmpty(fechaActual) Then

            If IsEmpty(fechaMayor) Then

                fechaMayor = fechaActual

            ElseIf CDate(fechaActual) > _
                   CDate(fechaMayor) Then

                fechaMayor = fechaActual

            End If

        End If


        rs.MoveNext

    Loop


    BuscarRegistroAccess = encontro

    fechaEncontrada = fechaMayor


Salir:

    On Error Resume Next

    If Not rs Is Nothing Then rs.Close
    If Not cn Is Nothing Then cn.Close

    Set rs = Nothing
    Set cn = Nothing

    Exit Function


ErrorHandler:

    BuscarRegistroAccess = False
    fechaEncontrada = Empty

    Resume Salir

End Function



'========================================================
' 11. COMPARAR FECHAS
'========================================================

Private Function EsMasReciente( _
    ByVal fechaNueva As Variant, _
    ByVal fechaAnterior As Variant) As Boolean


    'Sin fecha externa no se considera más reciente.

    If IsEmpty(fechaNueva) Then

        EsMasReciente = False

        Exit Function

    End If


    If Not IsDate(fechaNueva) Then

        EsMasReciente = False

        Exit Function

    End If


    'Si Access no tiene fecha,
    'el registro externo sí se carga.

    If IsEmpty(fechaAnterior) Then

        EsMasReciente = True

        Exit Function

    End If


    If Not IsDate(fechaAnterior) Then

        EsMasReciente = True

        Exit Function

    End If


    EsMasReciente = _
        CDate(fechaNueva) > _
        CDate(fechaAnterior)

End Function



'========================================================
' 12. PRIMERA FILA LIBRE
'
' NO UTILIZA ActiveCell.
'========================================================

Private Function SiguienteFilaRegistrar( _
    ByVal ws As Worksheet) As Long

    Dim fila As Long


    fila = 9


    Do While _
        Trim(CStr( _
            ws.Cells(fila, 1).Value)) <> ""


        fila = fila + 1


        If fila > 5000 Then

            MsgBox _
                "No hay más filas disponibles.", _
                vbCritical, _
                "REGISTRAR"

            SiguienteFilaRegistrar = 0

            Exit Function

        End If

    Loop


    SiguienteFilaRegistrar = fila

End Function



'========================================================
' 13. BUSCAR ENCABEZADO EN REGISTRAR
'========================================================

Private Function ColumnaDestino( _
    ByVal ws As Worksheet, _
    ByVal nombreCampo As String) As Long

    Dim filaEncabezados As Long
    Dim c As Long

    Dim texto As String


    filaEncabezados = _
        BuscarEncabezadosRegistrar(ws)


    If filaEncabezados = 0 Then

        ColumnaDestino = 0

        Exit Function

    End If


    For c = 1 To ws.Columns.Count


        texto = _
            NormalizarTexto( _
                CStr( _
                    ws.Cells( _
                        filaEncabezados, _
                        c).Value))


        If texto = _
            NormalizarTexto(nombreCampo) Then

            ColumnaDestino = c

            Exit Function

        End If

    Next c


    ColumnaDestino = 0

End Function



'========================================================
' 14. BUSCAR ENCABEZADOS DE REGISTRAR
'========================================================

Private Function BuscarEncabezadosRegistrar( _
    ByVal ws As Worksheet) As Long

    Dim fila As Long
    Dim c As Long

    Dim texto As String

    Dim tieneRFC As Boolean
    Dim tieneCURP As Boolean
    Dim tieneHOM As Boolean


    For fila = 1 To 20

        tieneRFC = False
        tieneCURP = False
        tieneHOM = False


        For c = 1 To 50

            texto = _
                NormalizarTexto( _
                    CStr( _
                        ws.Cells( _
                            fila, _
                            c).Value))


            Select Case texto

                Case "RFC"

                    tieneRFC = True

                Case "CURP"

                    tieneCURP = True

                Case "HOM"

                    tieneHOM = True

            End Select

        Next c


        If tieneRFC And _
           tieneCURP And _
           tieneHOM Then

            BuscarEncabezadosRegistrar = fila

            Exit Function

        End If

    Next fila


    BuscarEncabezadosRegistrar = 0

End Function



'========================================================
' 15. COPIAR REGISTRO
'
' ID:
' NO SE COPIA.
'
' RFC_COMPLETO:
' SE GENERA CON FÓRMULA.
'========================================================

Private Sub CopiarRegistroARegistrar( _
    ByVal wsOrigen As Worksheet, _
    ByVal wsDestino As Worksheet, _
    ByVal filaOrigen As Long, _
    ByVal filaDestino As Long, _
    ByVal encabezados As Object)


    Dim i As Variant

    Dim campo As String
    Dim valor As Variant

    Dim colDestino As Long


    For Each i In encabezados.Keys


        campo = encabezados(i)


        '============================================
        ' EL ID NO EXISTE EN LAS EQUIVALENCIAS.
        ' POR LO TANTO NUNCA SE COPIA.
        '============================================


        '============================================
        ' RFC_COMPLETO SE CALCULA
        '============================================

        If campo <> "RFC_COMPLETO" Then


            colDestino = _
                ColumnaDestino( _
                    wsDestino, _
                    campo)


            If colDestino > 0 Then


                valor = _
                    wsOrigen.Cells( _
                        filaOrigen, _
                        i).Value


                If Not IsError(valor) Then


                    Select Case campo


                        Case "RFC", _
                             "HOM", _
                             "CURP", _
                             "QNA", _
                             "AÑO", _
                             "C_B"

                            wsDestino.Cells( _
                                filaDestino, _
                                colDestino).NumberFormat = "@"


                            wsDestino.Cells( _
                                filaDestino, _
                                colDestino).Value = _
                                    CStr(valor)


                        Case Else

                            wsDestino.Cells( _
                                filaDestino, _
                                colDestino).Value = _
                                    valor

                    End Select


                End If

            End If

        End If

    Next i


    '====================================================
    ' RFC_COMPLETO
    '
    ' A = RFC
    ' B = RFC_COMPLETO
    ' C = HOM
    '====================================================

    wsDestino.Cells( _
        filaDestino, _
        2).NumberFormat = "@"


    wsDestino.Cells( _
        filaDestino, _
        2).FormulaLocal = _
        "=SI(O(A" & filaDestino & _
        "="""";C" & filaDestino & _
        "="""");"""";A" & filaDestino & _
        "&C" & filaDestino & ")"


    '====================================================
    ' FECHA_APLICAR_AHORRO
    ' P = FECHA_SOLICITA
    ' Q = FECHA_APLICAR
    '====================================================

    wsDestino.Cells( _
        filaDestino, _
        17).FormulaLocal = _
        "=SI(P" & filaDestino & _
        "="""";"""";P" & filaDestino & _
        "+90)"


    '====================================================
    ' FECHA_HOY
    '====================================================

    wsDestino.Cells( _
        filaDestino, _
        18).FormulaLocal = _
        "=HOY()"


    '====================================================
    ' FORMATOS
    '====================================================

    wsDestino.Cells( _
        filaDestino, _
        13).NumberFormat = "@"


    wsDestino.Cells( _
        filaDestino, _
        16).NumberFormat = "dd/mm/yyyy"


    wsDestino.Cells( _
        filaDestino, _
        17).NumberFormat = "dd/mm/yyyy"


    wsDestino.Cells( _
        filaDestino, _
        18).NumberFormat = "dd/mm/yyyy"

End Sub



'========================================================
' 16. LIMPIAR REGISTRAR
'
' IMPORTANTE:
'
' NO BORRA VALIDACIONES NI DESPLEGABLES.
'
' ClearContents elimina valores y fórmulas,
' pero mantiene validaciones.
'
' Después se restauran las fórmulas de RFC_COMPLETO,
' FECHA_APLICAR y FECHA_HOY.
'========================================================

Public Sub LimpiarRegistrosRegistrar()

    Dim ws As Worksheet

    Dim ultimaCelda As Range
    Dim ultimaFila As Long

    Dim respuesta As VbMsgBoxResult

    Dim fila As Long


    On Error GoTo ErrorHandler


    Set ws = _
        ThisWorkbook.Worksheets("REGISTRAR")


    '====================================================
    ' CONFIRMAR
    '====================================================

    respuesta = MsgBox( _
        "¿ESTÁS SEGURO DE QUE QUIERES LIMPIAR REGISTRAR?" & _
        vbCrLf & vbCrLf & _
        "Se eliminarán los datos capturados o importados." & _
        vbCrLf & vbCrLf & _
        "Se conservarán encabezados, desplegables, " & _
        "validaciones y estructura.", _
        vbYesNo + vbQuestion + vbDefaultButton2, _
        "LIMPIAR REGISTRAR")


    If respuesta <> vbYes Then Exit Sub


    Application.ScreenUpdating = False
    Application.EnableEvents = False


    '====================================================
    ' BUSCAR ÚLTIMA FILA
    '====================================================

    Set ultimaCelda = _
        ws.Cells.Find( _
            What:="*", _
            After:=ws.Range("A1"), _
            LookIn:=xlFormulas, _
            LookAt:=xlPart, _
            SearchOrder:=xlByRows, _
            SearchDirection:=xlPrevious)


    If ultimaCelda Is Nothing Then

        ultimaFila = 9

    Else

        ultimaFila = _
            Application.Max( _
                9, _
                ultimaCelda.Row)

    End If


    '====================================================
    ' LIMPIAR DATOS
    '
    ' SE LIMPIAN TODAS LAS COLUMNAS EXISTENTES
    ' DESDE FILA 9.
    '
    ' NO SE BORRA FORMATO NI VALIDACIÓN.
    '====================================================

    ws.Range( _
        ws.Cells(9, 1), _
        ws.Cells(ultimaFila, _
            ws.UsedRange.Columns.Count)).ClearContents


    '====================================================
    ' RESTAURAR FÓRMULAS EN TODAS LAS FILAS UTILIZADAS
    '
    ' Así RFC_COMPLETO nunca se pierde.
    '====================================================

    For fila = 9 To ultimaFila


        '--------------------------------------------
        ' RFC_COMPLETO
        '--------------------------------------------

        ws.Cells( _
            fila, _
            2).FormulaLocal = _
            "=SI(O(A" & fila & _
            "="""";C" & fila & _
            "="""");"""";A" & fila & _
            "&C" & fila & ")"


        '--------------------------------------------
        ' FECHA_APLICAR_AHORRO
        '--------------------------------------------

        ws.Cells( _
            fila, _
            17).FormulaLocal = _
            "=SI(P" & fila & _
            "="""";"""";P" & fila & _
            "+90)"


        '--------------------------------------------
        ' FECHA_HOY
        '--------------------------------------------

        ws.Cells( _
            fila, _
            18).FormulaLocal = "=HOY()"


    Next fila


    '====================================================
    ' FORMATOS
    '====================================================

    ws.Range( _
        ws.Cells(9, 2), _
        ws.Cells(ultimaFila, 2)).NumberFormat = "@"


    ws.Range( _
        ws.Cells(9, 13), _
        ws.Cells(ultimaFila, 13)).NumberFormat = "@"


    ws.Range( _
        ws.Cells(9, 16), _
        ws.Cells(ultimaFila, 18)).NumberFormat = _
        "dd/mm/yyyy"


    Application.EnableEvents = True
    Application.ScreenUpdating = True


    MsgBox _
        "REGISTRAR FUE LIMPIADO CORRECTAMENTE." & _
        vbCrLf & vbCrLf & _
        "Puedes volver a capturar manualmente " & _
        "o importar otro archivo.", _
        vbInformation, _
        "LISTO"


    Exit Sub


ErrorHandler:

    Application.EnableEvents = True
    Application.ScreenUpdating = True


    MsgBox _
        "ERROR AL LIMPIAR REGISTRAR." & _
        vbCrLf & vbCrLf & _
        "Error " & Err.Number & ":" & _
        vbCrLf & _
        Err.Description, _
        vbCritical, _
        "ERROR"

End Sub
