Option Explicit

'========================================================
' MODIMPORTAR
'
' ARCHIVO EXTERNO
'     ↓
' EXCEL
'     ↓
' BUSCAR ENCABEZADOS EN CUALQUIER FILA
'     ↓
' EQUIVALENCIAS
'     ↓
' COMPARAR CON ACCESS
'     ↓
' NUEVO O MÁS RECIENTE
'     ↓
' REGISTRAR
'
' IMPORTANTE:
' - NO MODIFICA ACCESS
' - CARGA EN REGISTRAR PARA REVISIÓN MANUAL
' - NO DEPENDE DE LA CELDA SELECCIONADA
' - LA FECHA OFICIAL DE COMPARACIÓN ES:
'   FECHA_SOLICITA_AHORRO_O_CUANDO_INGRESO
'========================================================


'========================================================
' 1. BOTÓN CREAR / IMPORTAR
'========================================================

Public Sub ImportarArchivoExterno()

    Dim fd As FileDialog
    Dim archivo As String
    Dim extension As String

    On Error GoTo ErrorHandler

    Set fd = Application.FileDialog(msoFileDialogFilePicker)

    With fd

        .Title = "SELECCIONAR ARCHIVO PARA IMPORTAR"

        .AllowMultiSelect = False

        .Filters.Clear

        .Filters.Add _
            "Archivos de Excel", _
            "*.xlsx;*.xls;*.xlsm"

        .Filters.Add _
            "Archivos PDF", _
            "*.pdf"

        If .Show <> -1 Then Exit Sub

        archivo = .SelectedItems(1)

    End With

    extension = LCase$( _
        Mid$(archivo, InStrRev(archivo, ".") + 1) _
    )

    Select Case extension

        Case "xlsx", "xls", "xlsm"

            ImportarExcel archivo

        Case "pdf"

            MsgBox _
                "EL PDF FUE SELECCIONADO CORRECTAMENTE." & vbCrLf & vbCrLf & _
                "LA EXTRACCIÓN AUTOMÁTICA DE PDF/OCR SE IMPLEMENTARÁ " & _
                "EN LA SIGUIENTE ETAPA.", _
                vbInformation, _
                "IMPORTAR PDF"

        Case Else

            MsgBox _
                "TIPO DE ARCHIVO NO COMPATIBLE.", _
                vbExclamation, _
                "IMPORTAR"

    End Select

    Exit Sub

ErrorHandler:

    MsgBox _
        "NO SE PUDO SELECCIONAR EL ARCHIVO." & vbCrLf & vbCrLf & _
        "ERROR " & Err.Number & ":" & vbCrLf & _
        Err.Description, _
        vbCritical, _
        "ERROR"

End Sub


'========================================================
' 2. IMPORTAR EXCEL
'========================================================

Private Sub ImportarExcel(ByVal rutaArchivo As String)

    Dim wbOrigen As Workbook
    Dim wsOrigen As Worksheet
    Dim wsDestino As Worksheet

    Dim ultimaFila As Long
    Dim ultimaColumna As Long

    Dim filaEncabezados As Long
    Dim fila As Long
    Dim filaDestino As Long

    Dim encabezados As Object
    Dim equivalencias As Object

    Dim i As Long
    Dim encabezado As String
    Dim campoDestino As String

    Dim rfc As String
    Dim curp As String
    Dim rfcCompleto As String

    Dim encontradoAccess As Boolean

    Dim fechaExterna As Variant
    Dim fechaAccess As Variant

    Dim registrosCargados As Long
    Dim registrosIgnorados As Long

    On Error GoTo ErrorHandler

    Application.ScreenUpdating = False
    Application.EnableEvents = False

    Set wsDestino = _
        ThisWorkbook.Worksheets("REGISTRAR")

    '====================================================
    ' ABRIR ARCHIVO EXTERNO
    '====================================================

    Set wbOrigen = Workbooks.Open( _
        Filename:=rutaArchivo, _
        ReadOnly:=True _
    )

    Set wsOrigen = wbOrigen.Worksheets(1)

    '====================================================
    ' DETERMINAR DIMENSIONES
    '====================================================

    ultimaFila = wsOrigen.Cells( _
        wsOrigen.Rows.Count, 1 _
    ).End(xlUp).Row

    ultimaColumna = wsOrigen.Cells( _
        1, _
        wsOrigen.Columns.Count _
    ).End(xlToLeft).Column

    '====================================================
    ' BUSCAR FILA DE ENCABEZADOS
    '====================================================

    filaEncabezados = BuscarFilaEncabezados( _
        wsOrigen, _
        ultimaFila, _
        ultimaColumna _
    )

    If filaEncabezados = 0 Then

        MsgBox _
            "NO SE ENCONTRÓ LA FILA DE ENCABEZADOS.", _
            vbExclamation, _
            "IMPORTAR"

        GoTo Salir

    End If

    '====================================================
    ' EQUIVALENCIAS
    '====================================================

    Set equivalencias = CrearEquivalencias()

    Set encabezados = _
        CreateObject("Scripting.Dictionary")

    encabezados.CompareMode = 1

    '====================================================
    ' LEER ENCABEZADOS EXTERNOS
    '====================================================

    For i = 1 To ultimaColumna

        encabezado = NormalizarTexto( _
            CStr(wsOrigen.Cells( _
                filaEncabezados, i _
            ).Value) _
        )

        If encabezado <> "" Then

            If equivalencias.Exists(encabezado) Then

                encabezados(i) = _
                    equivalencias(encabezado)

            End If

        End If

    Next i

    If encabezados.Count = 0 Then

        MsgBox _
            "NO SE ENCONTRARON ENCABEZADOS COMPATIBLES " & _
            "CON REGISTRAR.", _
            vbExclamation, _
            "IMPORTAR"

        GoTo Salir

    End If

    '====================================================
    ' PRIMERA FILA LIBRE
    '
    ' NO IMPORTA QUÉ CELDA ESTÉ SELECCIONADA
    '====================================================

    filaDestino = SiguienteFilaRegistrar(wsDestino)

    If filaDestino = 0 Then GoTo Salir

    registrosCargados = 0
    registrosIgnorados = 0

    '====================================================
    ' RECORRER TODOS LOS REGISTROS
    '====================================================

    For fila = filaEncabezados + 1 To ultimaFila

        rfc = ""
        curp = ""
        rfcCompleto = ""

        '================================================
        ' IDENTIFICADORES
        '================================================

        For i = 1 To ultimaColumna

            If encabezados.Exists(i) Then

                campoDestino = encabezados(i)

                Select Case campoDestino

                    Case "RFC"

                        rfc = Trim(UCase(CStr( _
                            wsOrigen.Cells(fila, i).Value _
                        )))

                    Case "RFC_COMPLETO"

                        rfcCompleto = Trim(UCase(CStr( _
                            wsOrigen.Cells(fila, i).Value _
                        )))

                    Case "CURP"

                        curp = Trim(UCase(CStr( _
                            wsOrigen.Cells(fila, i).Value _
                        )))

                End Select

            End If

        Next i

        '================================================
        ' FILA VACÍA
        '================================================

        If rfc = "" And _
           curp = "" And _
           rfcCompleto = "" Then

            registrosIgnorados = _
                registrosIgnorados + 1

            GoTo SiguienteRegistro

        End If

        '================================================
        ' FECHA OFICIAL DEL ARCHIVO EXTERNO
        '
        ' ÚNICAMENTE:
        ' FECHA_SOLICITA_AHORRO_O_CUANDO_INGRESO
        '================================================

        fechaExterna = ObtenerFechaExterna( _
            wsOrigen, _
            fila, _
            encabezados _
        )

        '================================================
        ' BUSCAR EN ACCESS
        '================================================

        encontradoAccess = False
        fechaAccess = Empty

        '------------------------------------------------
        ' RFC
        '------------------------------------------------

        If rfc <> "" Then

            encontradoAccess = BuscarRegistroAccess( _
                rfc, _
                "", _
                "", _
                fechaAccess _
            )

        End If

        '------------------------------------------------
        ' CURP
        '------------------------------------------------

        If Not encontradoAccess And curp <> "" Then

            encontradoAccess = BuscarRegistroAccess( _
                "", _
                curp, _
                "", _
                fechaAccess _
            )

        End If

        '------------------------------------------------
        ' RFC COMPLETO
        '------------------------------------------------

        If Not encontradoAccess And rfcCompleto <> "" Then

            encontradoAccess = BuscarRegistroAccess( _
                "", _
                "", _
                rfcCompleto, _
                fechaAccess _
            )

        End If

        '================================================
        ' DECISIÓN
        '================================================

        If Not encontradoAccess Then

            '--------------------------------------------
            ' NO EXISTE EN ACCESS
            '--------------------------------------------

            CopiarRegistroARegistrar _
                wsOrigen, _
                wsDestino, _
                fila, _
                filaDestino, _
                encabezados

            registrosCargados = _
                registrosCargados + 1

            filaDestino = filaDestino + 1

        Else

            '--------------------------------------------
            ' EXISTE:
            ' COMPARAR FECHA DE SOLICITUD/INGRESO
            '--------------------------------------------

            If EsFechaMasReciente( _
                fechaExterna, _
                fechaAccess _
            ) Then

                CopiarRegistroARegistrar _
                    wsOrigen, _
                    wsDestino, _
                    fila, _
                    filaDestino, _
                    encabezados

                registrosCargados = _
                    registrosCargados + 1

                filaDestino = filaDestino + 1

            Else

                registrosIgnorados = _
                    registrosIgnorados + 1

            End If

        End If

SiguienteRegistro:

    Next fila

    '====================================================
    ' RESULTADO
    '====================================================

    MsgBox _
        "IMPORTACIÓN TERMINADA." & vbCrLf & vbCrLf & _
        "REGISTROS CARGADOS: " & registrosCargados & vbCrLf & _
        "REGISTROS NO CARGADOS: " & registrosIgnorados & vbCrLf & vbCrLf & _
        "LOS DATOS QUEDARON EN REGISTRAR PARA REVISIÓN MANUAL.", _
        vbInformation, _
        "IMPORTAR"

Salir:

    On Error Resume Next

    If Not wbOrigen Is Nothing Then

        wbOrigen.Close SaveChanges:=False

    End If

    Application.EnableEvents = True
    Application.ScreenUpdating = True

    Exit Sub

ErrorHandler:

    MsgBox _
        "ERROR DURANTE LA IMPORTACIÓN." & vbCrLf & vbCrLf & _
        "ERROR " & Err.Number & ":" & vbCrLf & _
        Err.Description, _
        vbCritical, _
        "ERROR DE IMPORTACIÓN"

    Resume Salir

End Sub


'========================================================
' 3. BUSCAR FILA DE ENCABEZADOS
'========================================================

Private Function BuscarFilaEncabezados( _
    ByVal ws As Worksheet, _
    ByVal ultimaFila As Long, _
    ByVal ultimaColumna As Long) As Long

    Dim fila As Long
    Dim columna As Long

    Dim texto As String

    Dim tieneRFC As Boolean
    Dim tieneCURP As Boolean
    Dim tieneHOM As Boolean

    For fila = 1 To WorksheetFunction.Min(ultimaFila, 100)

        tieneRFC = False
        tieneCURP = False
        tieneHOM = False

        For columna = 1 To ultimaColumna

            texto = NormalizarTexto( _
                CStr(ws.Cells(fila, columna).Value) _
            )

            Select Case texto

                Case "RFC", _
                     "RFCFISCAL", _
                     "REGISTROFEDERALDECONTRIBUYENTES"

                    tieneRFC = True

                Case "CURP"

                    tieneCURP = True

                Case "HOM", _
                     "HOMOCLAVE"

                    tieneHOM = True

            End Select

        Next columna

        If tieneRFC Or tieneCURP Or tieneHOM Then

            BuscarFilaEncabezados = fila
            Exit Function

        End If

    Next fila

    BuscarFilaEncabezados = 0

End Function


