Option Explicit

'==========================================================
' MODIMPORTAR
'==========================================================
'
' HOJA DESTINO:
'   REGISTRAR
'
' FILA DE ENCABEZADOS:
'   8
'
' PRIMERA FILA DE DATOS:
'   9
'
' IMPORTACION:
'
'   SE IMPORTAN TODOS LOS REGISTROS DEL ARCHIVO.
'
'   NO SE FILTRA POR TIPO DE MOVIMIENTO.
'
'
' EQUIVALENCIAS:
'
'   RFC            -> RFC
'   CURP           -> CURP
'   NIVEL SALARIAL -> NIVEL
'   U.R.           -> UR
'   NOMBRE         -> PATERNO / MATERNO / NOMBRE
'
'==========================================================


Private Const IMP_HOJA_REGISTRAR As String = "REGISTRAR"

Private Const IMP_FILA_ENCABEZADOS As Long = 8

Private Const IMP_FILA_INICIO As Long = 9

Private Const IMP_FILA_MAXIMA As Long = 5000


'==========================================================
' BOTON IMPORTAR
'==========================================================

Public Sub ImportarArchivoExterno()

    Dim fd As FileDialog
    Dim ruta As String
    Dim extension As String


    On Error GoTo ErrorHandler


    Set fd = _
        Application.FileDialog( _
            msoFileDialogFilePicker)


    With fd

        .Title = _
            "Seleccionar archivo para importar"

        .AllowMultiSelect = False

        .Filters.Clear

        .Filters.Add _
            "Archivos Excel", _
            "*.xlsx;*.xls;*.xlsm"


        If .Show <> -1 Then

            Exit Sub

        End If


        ruta = _
            .SelectedItems(1)


    End With


    extension = _
        LCase$( _
            Mid$( _
                ruta, _
                InStrRev(ruta, ".") + 1))


    If extension = "xlsx" Then

        Imp_ImportarExcel ruta


    ElseIf extension = "xls" Then

        Imp_ImportarExcel ruta


    ElseIf extension = "xlsm" Then

        Imp_ImportarExcel ruta


    Else

        MsgBox _
            "Selecciona un archivo Excel valido.", _
            vbExclamation, _
            "IMPORTAR"

    End If


    Exit Sub


ErrorHandler:

    Imp_MostrarError _
        "No se pudo seleccionar el archivo."

End Sub


'==========================================================
' MACRO ALTERNATIVA
'==========================================================

Public Sub ImportarNuevoIngreso()

    ImportarArchivoExterno

End Sub


'==========================================================
' IMPORTAR EXCEL
'==========================================================

Private Sub Imp_ImportarExcel( _
    ByVal ruta As String)


    Dim wb As Workbook

    Dim wsOrigen As Worksheet
    Dim wsDestino As Worksheet

    Dim ultimaFila As Long
    Dim ultimaColumna As Long

    Dim filaEncabezados As Long

    Dim mapa As Object

    Dim colNombre As Long
    Dim colRFC As Long
    Dim colCURP As Long
    Dim colMovimiento As Long
    Dim colNivel As Long
    Dim colUR As Long

    Dim datos As Variant

    Dim fila As Long
    Dim filaDestino As Long

    Dim cantidadFilas As Long

    Dim movimiento As String

    Dim rfc As String
    Dim curp As String
    Dim nivel As String
    Dim ur As String

    Dim nombreCompleto As String

    Dim paterno As String
    Dim materno As String
    Dim nombre As String

    Dim importados As Long
    Dim sinDatos As Long

    Dim filaInicialImportacion As Long
    Dim filaFinalImportacion As Long

    Dim calculoAnterior As XlCalculation


    On Error GoTo ErrorHandler


    '======================================================
    ' GUARDAR CONFIGURACION
    '======================================================

    calculoAnterior = _
        Application.Calculation


    Application.ScreenUpdating = False

    Application.EnableEvents = False

    Application.DisplayAlerts = False

    Application.Calculation = _
        xlCalculationManual


    Application.StatusBar = _
        "Abriendo archivo..."


    '======================================================
    ' ABRIR ARCHIVO
    '======================================================

    Set wb = _
        Workbooks.Open( _
            Filename:=ruta, _
            UpdateLinks:=False, _
            ReadOnly:=True)


    Set wsOrigen = _
        wb.Worksheets(1)


    Set wsDestino = _
        ThisWorkbook.Worksheets( _
            IMP_HOJA_REGISTRAR)


    '======================================================
    ' ENCONTRAR DIMENSIONES
    '======================================================

    Imp_ObtenerDimensiones _
        wsOrigen, _
        ultimaFila, _
        ultimaColumna


    If ultimaFila = 0 Then

        Err.Raise _
            vbObjectError + 7000, _
            "Imp_ImportarExcel", _
            "El archivo no contiene datos."

    End If


    '======================================================
    ' BUSCAR ENCABEZADOS
    '======================================================

    Application.StatusBar = _
        "Buscando encabezados..."


    filaEncabezados = _
        Imp_BuscarFilaEncabezados( _
            wsOrigen, _
            ultimaFila)


    If filaEncabezados = 0 Then

        MsgBox _
            "No se encontro la fila de encabezados." & _
            vbCrLf & vbCrLf & _
            "Se requieren:" & _
            vbCrLf & _
            "NOMBRE" & _
            vbCrLf & _
            "RFC" & _
            vbCrLf & _
            "CURP" & _
            vbCrLf & _
            "TIPO DE MOVIMIENTO" & _
            vbCrLf & _
            "NIVEL SALARIAL" & _
            vbCrLf & _
            "U.R.", _
            vbCritical, _
            "IMPORTAR"


        GoTo Salir

    End If


    '======================================================
    ' CREAR MAPA
    '======================================================

    Set mapa = _
        Imp_CrearMapa( _
            wsOrigen, _
            filaEncabezados, _
            ultimaColumna)


    '======================================================
    ' ENCONTRAR COLUMNAS
    '======================================================

    colNombre = _
        Imp_ColumnaMapa( _
            mapa, _
            "NOMBRE")


    colRFC = _
        Imp_ColumnaMapa( _
            mapa, _
            "RFC")


    colCURP = _
        Imp_ColumnaMapa( _
            mapa, _
            "CURP")


    colMovimiento = _
        Imp_ColumnaMapa( _
            mapa, _
            "TIPO DE MOVIMIENTO")


    colNivel = _
        Imp_ColumnaMapa( _
            mapa, _
            "NIVEL SALARIAL")


    colUR = _
        Imp_ColumnaMapa( _
            mapa, _
            "U.R.")


    '======================================================
    ' VALIDAR COLUMNAS
    '======================================================

    If colNombre = 0 Then

        MsgBox _
            "No se encontro el encabezado NOMBRE.", _
            vbCritical, _
            "IMPORTAR"

        GoTo Salir

    End If


    If colRFC = 0 Then

        MsgBox _
            "No se encontro el encabezado RFC.", _
            vbCritical, _
            "IMPORTAR"

        GoTo Salir

    End If


    If colCURP = 0 Then

        MsgBox _
            "No se encontro el encabezado CURP.", _
            vbCritical, _
            "IMPORTAR"

        GoTo Salir

    End If


    If colMovimiento = 0 Then

        MsgBox _
            "No se encontro el encabezado TIPO DE MOVIMIENTO.", _
            vbCritical, _
            "IMPORTAR"

        GoTo Salir

    End If


    If colNivel = 0 Then

        MsgBox _
            "No se encontro el encabezado NIVEL SALARIAL.", _
            vbCritical, _
            "IMPORTAR"

        GoTo Salir

    End If


    If colUR = 0 Then

        MsgBox _
            "No se encontro el encabezado U.R.", _
            vbCritical, _
            "IMPORTAR"

        GoTo Salir

    End If


    '======================================================
    ' ENCONTRAR PRIMERA FILA LIBRE
    '======================================================

    filaDestino = _
        Imp_PrimeraFilaLibre( _
            wsDestino)


    If filaDestino = 0 Then

        GoTo Salir

    End If


    filaInicialImportacion = _
        filaDestino


    '======================================================
    ' CARGAR EXCEL EN MEMORIA
    '======================================================

    Application.StatusBar = _
        "Cargando datos del Excel..."


    datos = _
        wsOrigen.Range( _
            wsOrigen.Cells( _
                filaEncabezados + 1, _
                1), _
            wsOrigen.Cells( _
                ultimaFila, _
                ultimaColumna)).Value2


    cantidadFilas = _
        UBound(datos, 1)


    '======================================================
    ' PROCESAR TODOS LOS REGISTROS
    '======================================================

    For fila = 1 To cantidadFilas


        '==================================================
        ' ACTUALIZAR PROGRESO
        '==================================================

        If fila Mod 250 = 0 Then

            Application.StatusBar = _
                "Procesando " & _
                Format( _
                    fila, _
                    "#,##0") & _
                " de " & _
                Format( _
                    cantidadFilas, _
                    "#,##0") & _
                " | Importados: " & _
                Format( _
                    importados, _
                    "#,##0")


            DoEvents

        End If


        '==================================================
        ' COMPROBAR LIMITE
        '==================================================

        If filaDestino > _
           IMP_FILA_MAXIMA Then


            MsgBox _
                "Se alcanzo la fila maxima permitida: " & _
                IMP_FILA_MAXIMA & _
                "." & vbCrLf & vbCrLf & _
                "Se importaron " & _
                importados & _
                " registros.", _
                vbExclamation, _
                "IMPORTAR"


            Exit For

        End If


        '==================================================
        ' LEER DATOS
        '==================================================

        rfc = _
            Imp_NormalizarTexto( _
                datos( _
                    fila, _
                    colRFC))


        curp = _
            Imp_NormalizarTexto( _
                datos( _
                    fila, _
                    colCURP))


        nivel = _
            Imp_NormalizarTexto( _
                datos( _
                    fila, _
                    colNivel))


        ur = _
            Imp_NormalizarTexto( _
                datos( _
                    fila, _
                    colUR))


        nombreCompleto = _
            Imp_NormalizarTexto( _
                datos( _
                    fila, _
                    colNombre))


        '==================================================
        ' VALIDAR IDENTIFICACION
        '
        ' SI NO TIENE RFC NI CURP:
        '
        ' NO SE IMPORTA.
        '
        '==================================================

        If rfc = "" And _
           curp = "" Then


            sinDatos = _
                sinDatos + 1


            GoTo SiguienteRegistro

        End If


        '==================================================
        ' SEPARAR NOMBRE
        '==================================================

        Imp_SepararNombre _
            nombreCompleto, _
            paterno, _
            materno, _
            nombre


        '==================================================
        ' ESCRIBIR RFC
        '==================================================

        Imp_EscribirCampo _
            wsDestino, _
            filaDestino, _
            "RFC", _
            rfc


        '==================================================
        ' ESCRIBIR PATERNO
        '==================================================

        Imp_EscribirCampo _
            wsDestino, _
            filaDestino, _
            "PATERNO", _
            paterno


        '==================================================
        ' ESCRIBIR MATERNO
        '==================================================

        Imp_EscribirCampo _
            wsDestino, _
            filaDestino, _
            "MATERNO", _
            materno


        '==================================================
        ' ESCRIBIR NOMBRE
        '==================================================

        Imp_EscribirCampo _
            wsDestino, _
            filaDestino, _
            "NOMBRE", _
            nombre


        '==================================================
        ' ESCRIBIR CURP
        '==================================================

        Imp_EscribirCampo _
            wsDestino, _
            filaDestino, _
            "CURP", _
            curp


        '==================================================
        ' ESCRIBIR NIVEL
        '==================================================

        Imp_EscribirCampo _
            wsDestino, _
            filaDestino, _
            "NIVEL", _
            nivel


        '==================================================
        ' ESCRIBIR UR
        '==================================================

        Imp_EscribirCampo _
            wsDestino, _
            filaDestino, _
            "UR", _
            ur


        '==================================================
        ' COPIAR FORMULAS
        '
        ' RFC_COMPLETO
        ' FECHA_APLICAR_AHORRO
        ' FECHA_HOY
        ' RESULTADO_ANALISIS
        '
        ' y cualquier otra formula existente.
        '==================================================

        Imp_CopiarFormulas _
            wsDestino, _
            filaDestino


        '==================================================
        ' CONTADOR
        '==================================================

        importados = _
            importados + 1


        filaDestino = _
            filaDestino + 1


SiguienteRegistro:

    Next fila


    '======================================================
    ' GUARDAR RANGO DE LA IMPORTACION
    '======================================================

    If importados > 0 Then


        filaFinalImportacion = _
            filaDestino - 1


        Imp_GuardarRango _
            filaInicialImportacion, _
            filaFinalImportacion


    End If


    '======================================================
    ' RECALCULAR
    '======================================================

    Application.Calculate


    '======================================================
    ' MOSTRAR RESULTADO
    '======================================================

    Imp_MostrarResultado _
        importados, _
        sinDatos


Salir:

    On Error Resume Next


    If Not wb Is Nothing Then

        wb.Close _
            SaveChanges:=False

    End If


    Application.StatusBar = False

    Application.Calculation = _
        calculoAnterior

    Application.DisplayAlerts = True

    Application.EnableEvents = True

    Application.ScreenUpdating = True


    Exit Sub


ErrorHandler:

    MsgBox _
        "ERROR DURANTE LA IMPORTACION." & _
        vbCrLf & vbCrLf & _
        "Numero: " & _
        Err.Number & _
        vbCrLf & _
        "Descripcion: " & _
        Err.Description & _
        vbCrLf & _
        "Fila: " & _
        fila, _
        vbCritical, _
        "IMPORTAR"


    Resume Salir

End Sub


'==========================================================
' BUSCAR FILA DE ENCABEZADOS
'==========================================================

Private Function Imp_BuscarFilaEncabezados( _
    ByVal ws As Worksheet, _
    ByVal ultimaFila As Long) As Long


    Dim fila As Long
    Dim limite As Long
    Dim coincidencias As Long


    limite = ultimaFila


    If limite > 100 Then

        limite = 100

    End If


    For fila = 1 To limite


        coincidencias = 0


        If Imp_BuscarColumna( _
            ws, _
            fila, _
            "NOMBRE") > 0 Then

            coincidencias = _
                coincidencias + 1

        End If


        If Imp_BuscarColumna( _
            ws, _
            fila, _
            "RFC") > 0 Then

            coincidencias = _
                coincidencias + 1

        End If


        If Imp_BuscarColumna( _
            ws, _
            fila, _
            "CURP") > 0 Then

            coincidencias = _
                coincidencias + 1

        End If


        If Imp_BuscarColumna( _
            ws, _
            fila, _
            "TIPO DE MOVIMIENTO") > 0 Then

            coincidencias = _
                coincidencias + 1

        End If


        If Imp_BuscarColumna( _
            ws, _
            fila, _
            "NIVEL SALARIAL") > 0 Then

            coincidencias = _
                coincidencias + 1

        End If


        If Imp_BuscarColumna( _
            ws, _
            fila, _
            "U.R.") > 0 Then

            coincidencias = _
                coincidencias + 1

        End If


        If coincidencias >= 5 Then

            Imp_BuscarFilaEncabezados = _
                fila

            Exit Function

        End If


    Next fila


    Imp_BuscarFilaEncabezados = 0

End Function


'==========================================================
' CREAR MAPA
'==========================================================

Private Function Imp_CrearMapa( _
    ByVal ws As Worksheet, _
    ByVal filaEncabezados As Long, _
    ByVal ultimaColumna As Long) As Object


    Dim mapa As Object

    Dim columna As Long
    Dim encabezado As String


    Set mapa = _
        CreateObject( _
            "Scripting.Dictionary")


    mapa.CompareMode = _
        vbTextCompare


    For columna = 1 To ultimaColumna


        encabezado = _
            Imp_NormalizarEncabezado( _
                Imp_TextoSeguro( _
                    ws.Cells( _
                        filaEncabezados, _
                        columna).Value2))


        If encabezado <> "" Then


            If Not mapa.Exists( _
                encabezado) Then


                mapa.Add _
                    encabezado, _
                    columna


            End If


        End If


    Next columna


    Set Imp_CrearMapa = _
        mapa

End Function


'==========================================================
' OBTENER COLUMNA DEL MAPA
'==========================================================

Private Function Imp_ColumnaMapa( _
    ByVal mapa As Object, _
    ByVal encabezado As String) As Long


    Dim clave As String


    clave = _
        Imp_NormalizarEncabezado( _
            encabezado)


    If mapa.Exists(clave) Then


        Imp_ColumnaMapa = _
            CLng( _
                mapa(clave))


    Else


        Imp_ColumnaMapa = 0


    End If


End Function


'==========================================================
' BUSCAR COLUMNA
'==========================================================

Private Function Imp_BuscarColumna( _
    ByVal ws As Worksheet, _
    ByVal fila As Long, _
    ByVal encabezadoBuscado As String) As Long


    Dim ultimaColumna As Long

    Dim columna As Long

    Dim actual As String
    Dim buscado As String


    ultimaColumna = _
        ws.Cells( _
            fila, _
            ws.Columns.Count).End( _
                xlToLeft).Column


    buscado = _
        Imp_NormalizarEncabezado( _
            encabezadoBuscado)


    For columna = 1 To ultimaColumna


        actual = _
            Imp_NormalizarEncabezado( _
                Imp_TextoSeguro( _
                    ws.Cells( _
                        fila, _
                        columna).Value2))


        If actual = buscado Then


            Imp_BuscarColumna = _
                columna


            Exit Function


        End If


    Next columna


    Imp_BuscarColumna = 0

End Function


'==========================================================
' PRIMERA FILA LIBRE
'==========================================================

Private Function Imp_PrimeraFilaLibre( _
    ByVal ws As Worksheet) As Long


    Dim columnaRFC As Long
    Dim fila As Long


    columnaRFC = _
        Imp_BuscarColumnaRegistrar( _
            ws, _
            "RFC")


    If columnaRFC = 0 Then


        MsgBox _
            "No se encontro la columna RFC en REGISTRAR.", _
            vbCritical, _
            "IMPORTAR"


        Imp_PrimeraFilaLibre = 0

        Exit Function


    End If


    fila = _
        IMP_FILA_INICIO


    Do While _
        Trim$( _
            Imp_TextoSeguro( _
                ws.Cells( _
                    fila, _
                    columnaRFC).Value2)) <> ""


        fila = fila + 1


        If fila > _
           IMP_FILA_MAXIMA Then


            MsgBox _
                "REGISTRAR esta lleno hasta la fila " & _
                IMP_FILA_MAXIMA & ".", _
                vbExclamation, _
                "IMPORTAR"


            Imp_PrimeraFilaLibre = 0

            Exit Function


        End If


    Loop


    Imp_PrimeraFilaLibre = _
        fila

End Function


'==========================================================
' BUSCAR COLUMNA EN REGISTRAR
'==========================================================

Private Function Imp_BuscarColumnaRegistrar( _
    ByVal ws As Worksheet, _
    ByVal encabezadoBuscado As String) As Long


    Dim columna As Long
    Dim encabezado As String


    For columna = 1 To 50


        encabezado = _
            Imp_NormalizarEncabezado( _
                Imp_TextoSeguro( _
                    ws.Cells( _
                        IMP_FILA_ENCABEZADOS, _
                        columna).Value2))


        If encabezado = _
           Imp_NormalizarEncabezado( _
               encabezadoBuscado) Then


            Imp_BuscarColumnaRegistrar = _
                columna


            Exit Function


        End If


    Next columna


    Imp_BuscarColumnaRegistrar = 0

End Function


'==========================================================
' ESCRIBIR CAMPO
'==========================================================

Private Sub Imp_EscribirCampo( _
    ByVal ws As Worksheet, _
    ByVal fila As Long, _
    ByVal encabezado As String, _
    ByVal valor As String)


    Dim columna As Long
    Dim celda As Range


    columna = _
        Imp_BuscarColumnaRegistrar( _
            ws, _
            encabezado)


    If columna = 0 Then

        Exit Sub

    End If


    Set celda = _
        ws.Cells( _
            fila, _
            columna)


    '======================================================
    ' NUNCA SOBRESCRIBIR FORMULAS
    '======================================================

    If celda.HasFormula Then

        Exit Sub

    End If


    celda.Value = _
        valor

End Sub


'==========================================================
' COPIAR FORMULAS
'==========================================================

Private Sub Imp_CopiarFormulas( _
    ByVal ws As Worksheet, _
    ByVal fila As Long)


    Dim columna As Long


    If fila <= IMP_FILA_INICIO Then

        Exit Sub

    End If


    For columna = 1 To 50


        If ws.Cells( _
            fila - 1, _
            columna).HasFormula Then


            ws.Cells( _
                fila, _
                columna).Formula = _
                ws.Cells( _
                    fila - 1, _
                    columna).Formula


        End If


    Next columna

End Sub


'==========================================================
' SEPARAR NOMBRE
'==========================================================

Private Sub Imp_SepararNombre( _
    ByVal nombreCompleto As String, _
    ByRef paterno As String, _
    ByRef materno As String, _
    ByRef nombre As String)


    Dim partes() As String

    Dim cantidad As Long
    Dim palabrasPaterno As Long
    Dim indiceNombre As Long


    paterno = ""
    materno = ""
    nombre = ""


    nombreCompleto = _
        Imp_LimpiarEspaciosImportar( _
            nombreCompleto)


    If nombreCompleto = "" Then

        Exit Sub

    End If


    partes = _
        Split( _
            nombreCompleto, _
            " ")


    cantidad = _
        UBound(partes) + 1


    If cantidad = 1 Then


        nombre = _
            partes(0)


        Exit Sub

    End If


    If cantidad = 2 Then


        paterno = _
            partes(0)


        nombre = _
            partes(1)


        Exit Sub

    End If


    palabrasPaterno = _
        Imp_PalabrasApellidoCompuesto( _
            partes)


    paterno = _
        Imp_UnirPartes( _
            partes, _
            0, _
            palabrasPaterno - 1)


    If palabrasPaterno < cantidad Then


        materno = _
            partes(palabrasPaterno)


        indiceNombre = _
            palabrasPaterno + 1


    Else


        indiceNombre = _
            palabrasPaterno


    End If


    If indiceNombre < cantidad Then


        nombre = _
            Imp_UnirPartes( _
                partes, _
                indiceNombre, _
                cantidad - 1)


    End If

End Sub


'==========================================================
' APELLIDO COMPUESTO
'==========================================================

Private Function Imp_PalabrasApellidoCompuesto( _
    ByRef partes() As String) As Long


    Dim primera As String
    Dim segunda As String


    primera = _
        UCase$( _
            partes(0))


    If UBound(partes) >= 1 Then


        segunda = _
            UCase$( _
                partes(1))


    Else


        segunda = ""

    End If


    If primera = "DE" Then


        If segunda = "LA" Then

            Imp_PalabrasApellidoCompuesto = 3

            Exit Function

        End If


        If segunda = "LAS" Then

            Imp_PalabrasApellidoCompuesto = 3

            Exit Function

        End If


        If segunda = "LOS" Then

            Imp_PalabrasApellidoCompuesto = 3

            Exit Function

        End If


        If segunda <> "" Then

            Imp_PalabrasApellidoCompuesto = 2

            Exit Function

        End If


    End If


    If primera = "DEL" Then


        If segunda <> "" Then

            Imp_PalabrasApellidoCompuesto = 2

            Exit Function

        End If


    End If


    Imp_PalabrasApellidoCompuesto = 1

End Function


'==========================================================
' UNIR PARTES
'==========================================================

Private Function Imp_UnirPartes( _
    ByRef partes() As String, _
    ByVal inicio As Long, _
    ByVal fin As Long) As String


    Dim i As Long
    Dim resultado As String


    resultado = ""


    If inicio > fin Then

        Imp_UnirPartes = ""

        Exit Function

    End If


    For i = inicio To fin


        If Trim$(partes(i)) <> "" Then


            If resultado <> "" Then

                resultado = _
                    resultado & " "

            End If


            resultado = _
                resultado & _
                partes(i)


        End If


    Next i


    Imp_UnirPartes = _
        Imp_LimpiarEspaciosImportar( _
            resultado)

End Function


'==========================================================
' LIMPIAR ESPACIOS
'==========================================================

Private Function Imp_LimpiarEspaciosImportar( _
    ByVal texto As String) As String


    texto = _
        Replace( _
            texto, _
            vbTab, _
            " ")


    texto = _
        Replace( _
            texto, _
            vbCr, _
            " ")


    texto = _
        Replace( _
            texto, _
            vbLf, _
            " ")


    Do While _
        InStr( _
            texto, _
            "  ") > 0


        texto = _
            Replace( _
                texto, _
                "  ", _
                " ")


    Loop


    Imp_LimpiarEspaciosImportar = _
        Trim$(texto)

End Function


'==========================================================
' NORMALIZAR TEXTO
'==========================================================

Private Function Imp_NormalizarTexto( _
    ByVal valor As Variant) As String


    Dim texto As String


    If IsError(valor) Then

        Imp_NormalizarTexto = ""

        Exit Function

    End If


    If IsNull(valor) Then

        Imp_NormalizarTexto = ""

        Exit Function

    End If


    texto = _
        CStr(valor)


    texto = _
        Imp_LimpiarEspaciosImportar( _
            texto)


    Imp_NormalizarTexto = _
        UCase$(texto)

End Function


'==========================================================
' NORMALIZAR ENCABEZADO
'
' Solo sirve para localizar encabezados.
'
' NO constituye una equivalencia de datos.
'
'==========================================================

Private Function Imp_NormalizarEncabezado( _
    ByVal texto As String) As String


    texto = _
        Trim$(texto)


    texto = _
        UCase$(texto)


    texto = _
        Replace( _
            texto, _
            ".", _
            "")


    texto = _
        Replace( _
            texto, _
            " ", _
            "")


    Imp_NormalizarEncabezado = _
        texto

End Function


'==========================================================
' TEXTO SEGURO
'==========================================================

Private Function Imp_TextoSeguro( _
    ByVal valor As Variant) As String


    If IsError(valor) Then


        Imp_TextoSeguro = ""


    ElseIf IsNull(valor) Then


        Imp_TextoSeguro = ""


    Else


        Imp_TextoSeguro = _
            Trim$( _
                CStr(valor))


    End If

End Function


'==========================================================
' DIMENSIONES DEL EXCEL
'==========================================================

Private Sub Imp_ObtenerDimensiones( _
    ByVal ws As Worksheet, _
    ByRef ultimaFila As Long, _
    ByRef ultimaColumna As Long)


    Dim ultimaCelda As Range


    ultimaFila = 0
    ultimaColumna = 0


    On Error Resume Next


    Set ultimaCelda = _
        ws.Cells.SpecialCells( _
            xlCellTypeLastCell)


    On Error GoTo 0


    If ultimaCelda Is Nothing Then

        Exit Sub

    End If


    ultimaFila = _
        ultimaCelda.Row


    ultimaColumna = _
        ultimaCelda.Column

End Sub


'==========================================================
' GUARDAR RANGO DE ULTIMA IMPORTACION
'==========================================================

Private Sub Imp_GuardarRango( _
    ByVal filaInicial As Long, _
    ByVal filaFinal As Long)


    Imp_BorrarNombre _
        "FilaInicioImportacion"


    Imp_BorrarNombre _
        "FilaFinImportacion"


    ThisWorkbook.Names.Add _
        Name:="FilaInicioImportacion", _
        RefersTo:="=" & filaInicial


    ThisWorkbook.Names.Add _
        Name:="FilaFinImportacion", _
        RefersTo:="=" & filaFinal

End Sub


'==========================================================
' LIMPIAR ULTIMA IMPORTACION
'
' NO BORRA FORMULAS.
' NO BORRA VALIDACIONES.
' NO BORRA DROPDOWNS.
' NO BORRA FORMATO.
'
'==========================================================

Public Sub LimpiarUltimaImportacion()


    Dim ws As Worksheet

    Dim filaInicial As Long
    Dim filaFinal As Long

    Dim fila As Long
    Dim columna As Long

    Dim respuesta As VbMsgBoxResult


    On Error GoTo ErrorHandler


    Set ws = _
        ThisWorkbook.Worksheets( _
            IMP_HOJA_REGISTRAR)


    If Not Imp_ExisteNombre( _
        "FilaInicioImportacion") Then


        MsgBox _
            "No existe una ultima importacion para limpiar.", _
            vbInformation, _
            "LIMPIAR"


        Exit Sub

    End If


    If Not Imp_ExisteNombre( _
        "FilaFinImportacion") Then


        MsgBox _
            "No existe una ultima importacion para limpiar.", _
            vbInformation, _
            "LIMPIAR"


        Exit Sub

    End If


    filaInicial = _
        Imp_ObtenerValorNombre( _
            "FilaInicioImportacion")


    filaFinal = _
        Imp_ObtenerValorNombre( _
            "FilaFinImportacion")


    If filaInicial < _
       IMP_FILA_INICIO Then

        Exit Sub

    End If


    If filaFinal < filaInicial Then

        Exit Sub

    End If


    respuesta = _
        MsgBox( _
            "Se limpiara la ultima importacion." & _
            vbCrLf & vbCrLf & _
            "Filas: " & _
            filaInicial & _
            " a " & _
            filaFinal & _
            vbCrLf & vbCrLf & _
            "Las formulas NO se borraran." & _
            vbCrLf & _
            "Los dropdowns NO se borraran." & _
            vbCrLf & _
            "El formato NO se borrara." & _
            vbCrLf & vbCrLf & _
            "¿Deseas continuar?", _
            vbYesNo + _
            vbQuestion + _
            vbDefaultButton2, _
            "LIMPIAR")


    If respuesta <> vbYes Then

        Exit Sub

    End If


    Application.ScreenUpdating = False

    Application.EnableEvents = False


    For fila = _
        filaInicial To _
        filaFinal


        For columna = 1 To 50


            If Not ws.Cells( _
                fila, _
                columna).HasFormula Then


                ws.Cells( _
                    fila, _
                    columna).ClearContents


            End If


        Next columna


    Next fila


    Imp_BorrarNombre _
        "FilaInicioImportacion"


    Imp_BorrarNombre _
        "FilaFinImportacion"


    Application.EnableEvents = True

    Application.ScreenUpdating = True


    MsgBox _
        "La ultima importacion fue limpiada." & _
        vbCrLf & vbCrLf & _
        "Las formulas, dropdowns y formato se conservaron.", _
        vbInformation, _
        "LIMPIAR"


    Exit Sub


ErrorHandler:


    Application.EnableEvents = True

    Application.ScreenUpdating = True


    MsgBox _
        "ERROR AL LIMPIAR." & _
        vbCrLf & vbCrLf & _
        "Numero: " & _
        Err.Number & _
        vbCrLf & _
        "Descripcion: " & _
        Err.Description, _
        vbCritical, _
        "LIMPIAR"

End Sub


'==========================================================
' EXISTE NOMBRE
'==========================================================

Private Function Imp_ExisteNombre( _
    ByVal nombre As String) As Boolean


    Dim objetoNombre As Name


    On Error GoTo NoExiste


    Set objetoNombre = _
        ThisWorkbook.Names( _
            nombre)


    Imp_ExisteNombre = True


    Exit Function


NoExiste:


    Imp_ExisteNombre = False

End Function


'==========================================================
' OBTENER VALOR DEL NOMBRE
'==========================================================

Private Function Imp_ObtenerValorNombre( _
    ByVal nombre As String) As Long


    Dim texto As String


    On Error GoTo ErrorValor


    texto = _
        ThisWorkbook.Names( _
            nombre).RefersTo


    texto = _
        Replace( _
            texto, _
            "=", _
            "")


    texto = _
        Replace( _
            texto, _
            "'", _
            "")


    Imp_ObtenerValorNombre = _
        CLng( _
            Val(texto))


    Exit Function


ErrorValor:


    Imp_ObtenerValorNombre = 0

End Function


'==========================================================
' BORRAR NOMBRE
'==========================================================

Private Sub Imp_BorrarNombre( _
    ByVal nombre As String)


    On Error Resume Next


    ThisWorkbook.Names( _
        nombre).Delete

End Sub


