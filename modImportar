' MOSTRAR RESULTADO
'==========================================================

Private Sub Imp_MostrarResultado( _
    ByVal importados As Long, _
    ByVal sinDatos As Long)


    Dim mensaje As String


    mensaje = _
        "IMPORTACION TERMINADA." & _
        vbCrLf & vbCrLf


    mensaje = _
        mensaje & _
        "Registros importados: " & _
        Format( _
            importados, _
            "#,##0") & _
        vbCrLf


    mensaje = _
        mensaje & _
        "Sin RFC ni CURP: " & _
        Format( _
            sinDatos, _
            "#,##0") & _
        vbCrLf & vbCrLf


    mensaje = _
        mensaje & _
        "Todos los registros con RFC o CURP fueron procesados."


    MsgBox _
        mensaje, _
        vbInformation, _
        "IMPORTAR"

End Sub


