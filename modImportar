Option Explicit

'========================================================
' IMPORTAR ARCHIVO EXTERNO
'
' Primera versión:
' - Excel XLSX/XLS
' - Busca encabezados aunque no estén en la fila 1
' - Compara contra Access
' - Si no existe o es más reciente:
'       lo carga en REGISTRAR
' - NO modifica Access
'
' PDF:
' se deja reservado para la segunda etapa.
'========================================================

Public Sub ImportarArchivoExterno()

    Dim fd As FileDialog
    Dim archivo As String
    Dim extension As String

    On Error GoTo ErrorHandler

    Set fd = Application.FileDialog(msoFileDialogFilePicker)

    With fd

        .Title = "SELECCIONAR ARCHIVO PARA IMPORTAR"

        .AllowMultiSelect = False

        .Filters.Clear

        .Filters.Add "Archivos de Excel", "*.xlsx;*.xls;*.xlsm"

        .Filters.Add "Archivos PDF", "*.pdf"

        If .Show <> -1 Then
            Exit Sub
        End If

        archivo = .SelectedItems(1)

    End With

    extension = LCase$(Mid$(archivo, InStrRev(archivo, ".") + 1))

    Select Case extension

        Case "xlsx", "xls", "xlsm"

            ImportarExcel archivo

        Case "pdf"

            MsgBox _
                "EL ARCHIVO PDF FUE SELECCIONADO CORRECTAMENTE." & _
                vbCrLf & vbCrLf & _
                "LA LECTURA AUTOMÁTICA DE PDF SE IMPLEMENTARÁ " & _
                "EN LA SIGUIENTE ETAPA.", _
                vbInformation, _
                "IMPORTAR PDF"

        Case Else

            MsgBox _
                "TIPO DE ARCHIVO NO COMPATIBLE.", _
                vbExclamation, _
                "IMPORTAR"

    End Select

    Exit Sub

ErrorHandler:

    MsgBox _
        "NO SE PUDO SELECCIONAR EL ARCHIVO." & _
        vbCrLf & vbCrLf & _
        "ERROR " & Err.Number & ":" & _
        vbCrLf & _
        Err.Description, _
        vbCritical, _
        "ERROR"

End Sub


'========================================================
' IMPORTAR EXCEL
'========================================================

Private Sub ImportarExcel(ByVal rutaArchivo As String)

    Dim wbOrigen As Workbook
    Dim wsOrigen As Worksheet
    Dim wsDestino As Worksheet

    Dim ultimaFila As Long
    Dim ultimaColumna As Long

    Dim filaEncabezados As Long
    Dim fila As Long

    Dim encabezados As Object
    Dim equivalencias As Object

    Dim i As Long
    Dim encabezado As String
    Dim campoDestino As String

    Dim filaDestino As Long

    Dim rfc As String
    Dim curp As String
    Dim rfcCompleto As String

    Dim encontradoAccess As Boolean
    Dim fechaExterna As Variant
    Dim fechaAccess As Variant

    On Error GoTo ErrorHandler

    Application.ScreenUpdating = False
    Application.EnableEvents = False

    Set wsDestino = _
        ThisWorkbook.Worksheets("REGISTRAR")

    '====================================================
    ' ABRIR ARCHIVO EXTERNO
    '====================================================

    Set wbOrigen = _
        Workbooks.Open( _
            Filename:=rutaArchivo, _
            ReadOnly:=True _
        )

    '====================================================
    ' TOMAR LA PRIMERA HOJA
    '====================================================

    Set wsOrigen = wbOrigen.Worksheets(1)

    '====================================================
    ' ENCONTRAR ÚLTIMA FILA / COLUMNA
    '====================================================

    ultimaFila = _
        wsOrigen.Cells( _
            wsOrigen.Rows.Count, _
            1 _
        ).End(xlUp).Row

    ultimaColumna = _
        wsOrigen.Cells( _
            1, _
            wsOrigen.Columns.Count _
        ).End(xlToLeft).Column


    '====================================================
    ' BUSCAR FILA DE ENCABEZADOS
    '====================================================

    filaEncabezados = _
        BuscarFilaEncabezados( _
            wsOrigen, _
            ultimaFila, _
            ultimaColumna _
        )

    If filaEncabezados = 0 Then

        MsgBox _
            "NO SE ENCONTRÓ LA FILA DE ENCABEZADOS.", _
            vbExclamation, _
            "IMPORTAR"

        GoTo Salir

    End If


    '====================================================
    ' CREAR EQUIVALENCIAS
    '====================================================

    Set equivalencias = CrearEquivalencias()

    Set encabezados = _
        CreateObject("Scripting.Dictionary")

    encabezados.CompareMode = 1


    '====================================================
    ' LEER ENCABEZADOS
    '====================================================

    For i = 1 To ultimaColumna

        encabezado = _
            NormalizarTexto( _
                CStr( _
                    wsOrigen.Cells( _
                        filaEncabezados, _
                        i _
                    ).Value _
                ) _
            )

        If encabezado <> "" Then

            If equivalencias.Exists(encabezado) Then

                encabezados.Add _
                    i, _
                    equivalencias(encabezado)

            End If

        End If

    Next i


    If encabezados.Count = 0 Then

        MsgBox _
            "NO SE ENCONTRARON ENCABEZADOS COMPATIBLES.", _
            vbExclamation, _
            "IMPORTAR"

        GoTo Salir

    End If


    '====================================================
    ' RECORRER TODOS LOS REGISTROS
    '====================================================

    For fila = filaEncabezados + 1 To ultimaFila

        rfc = ""
        curp = ""
        rfcCompleto = ""

        '--------------------------------------------
        ' OBTENER IDENTIFICADORES
        '--------------------------------------------

        For i = 1 To ultimaColumna

            If encabezados.Exists(i) Then

                campoDestino = _
                    encabezados(i)

                Select Case campoDestino

                    Case "RFC"

                        rfc = Trim( _
                            UCase( _
                                CStr( _
                                    wsOrigen.Cells( _
                                        fila, i _
                                    ).Value _
                                ) _
                            ) _
                        )

                    Case "RFC_COMPLETO"

                        rfcCompleto = Trim( _
                            UCase( _
                                CStr( _
                                    wsOrigen.Cells( _
                                        fila, i _
                                    ).Value _
                                ) _
                            ) _
                        )

                    Case "CURP"

                        curp = Trim( _
                            UCase( _
                                CStr( _
                                    wsOrigen.Cells( _
                                        fila, i _
                                    ).Value _
                                ) _
                            ) _
                        )

                End Select

            End If

        Next i


        '--------------------------------------------
        ' IGNORAR FILA VACÍA
        '--------------------------------------------

        If rfc = "" And _
           rfcCompleto = "" And _
           curp = "" Then

            GoTo SiguienteFila

        End If


        '================================================
        ' FECHA DEL ARCHIVO EXTERNO
        '================================================

        fechaExterna = _
            ObtenerFechaExterna( _
                wsOrigen, _
                fila, _
                encabezados _
            )


        '================================================
        ' COMPARAR CONTRA ACCESS
        '================================================

        encontradoAccess = False

        fechaAccess = Empty

        If rfc <> "" Then

            encontradoAccess = _
                BuscarRegistroAccess( _
                    rfc, _
                    "", _
                    "", _
                    fechaAccess _
                )

        End If

        If Not encontradoAccess And _
           curp <> "" Then

            encontradoAccess = _
                BuscarRegistroAccess( _
                    "", _
                    curp, _
                    "", _
                    fechaAccess _
                )

        End If

        If Not encontradoAccess And _
           rfcCompleto <> "" Then

            encontradoAccess = _
                BuscarRegistroAccess( _
                    "", _
                    "", _
                    rfcCompleto, _
                    fechaAccess _
                )

        End If


        '================================================
        ' DECIDIR SI SE CARGA EN REGISTRAR
        '================================================

        If Not encontradoAccess Then

            'Nuevo registro
            filaDestino = _
                SiguienteFilaRegistrar(wsDestino)

            CopiarRegistroARegistrar _
                wsOrigen, _
                wsDestino, _
                fila, _
                filaDestino, _
                encabezados

        Else

            '--------------------------------------------
            ' EXISTE
            '--------------------------------------------

            If EsFechaMasReciente( _
                fechaExterna, _
                fechaAccess _
            ) Then

                filaDestino = _
                    SiguienteFilaRegistrar(wsDestino)

                CopiarRegistroARegistrar _
                    wsOrigen, _
                    wsDestino, _
                    fila, _
                    filaDestino, _
                    encabezados

            End If

        End If


SiguienteFila:

    Next fila


    MsgBox _
        "IMPORTACIÓN TERMINADA." & _
        vbCrLf & vbCrLf & _
        "LOS REGISTROS NUEVOS O MÁS RECIENTES " & _
        "FUERON CARGADOS EN REGISTRAR PARA REVISIÓN.", _
        vbInformation, _
        "IMPORTAR"

Salir:

    On Error Resume Next

    If Not wbOrigen Is Nothing Then

        wbOrigen.Close SaveChanges:=False

    End If

    Application.EnableEvents = True
    Application.ScreenUpdating = True

    Exit Sub


ErrorHandler:

    MsgBox _
        "ERROR DURANTE LA IMPORTACIÓN." & _
        vbCrLf & vbCrLf & _
        "ERROR " & Err.Number & ":" & _
        vbCrLf & _
        Err.Description, _
        vbCritical, _
        "ERROR DE IMPORTACIÓN"

    Resume Salir

End Sub


'========================================================
' BUSCAR FILA DE ENCABEZADOS
'========================================================

Private Function BuscarFilaEncabezados( _
    ByVal ws As Worksheet, _
    ByVal ultimaFila As Long, _
    ByVal ultimaColumna As Long _
) As Long

    Dim fila As Long
    Dim columna As Long

    Dim texto As String

    Dim tieneRFC As Boolean
    Dim tieneCURP As Boolean
    Dim tieneHOM As Boolean

    For fila = 1 To _
        WorksheetFunction.Min( _
            ultimaFila, _
            50 _
        )

        tieneRFC = False
        tieneCURP = False
        tieneHOM = False

        For columna = 1 To ultimaColumna

            texto = _
                NormalizarTexto( _
                    CStr( _
                        ws.Cells( _
                            fila, _
                            columna _
                        ).Value _
                    ) _
                )

            Select Case texto

                Case "RFC", _
                     "RFCFISCAL", _
                     "REGISTROFEDERALDECONTRIBUYENTES"

                    tieneRFC = True

                Case "CURP"

                    tieneCURP = True

                Case "HOM", _
                     "HOMOCLAVE"

                    tieneHOM = True

            End Select

        Next columna

        If tieneRFC Or tieneCURP Or tieneHOM Then

            BuscarFilaEncabezados = fila

            Exit Function

        End If

    Next fila

    BuscarFilaEncabezados = 0

End Function


