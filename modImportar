'========================================================
' NORMALIZAR ENCABEZADOS
'========================================================

Private Function NormalizarTexto( _
    ByVal texto As String) As String

    texto = UCase$(Trim$(texto))

    texto = Replace(texto, "Á", "A")
    texto = Replace(texto, "É", "E")
    texto = Replace(texto, "Í", "I")
    texto = Replace(texto, "Ó", "O")
    texto = Replace(texto, "Ú", "U")
    texto = Replace(texto, "Ü", "U")
    texto = Replace(texto, "Ñ", "N")

    texto = Replace(texto, " ", "")
    texto = Replace(texto, ".", "")
    texto = Replace(texto, "-", "")
    texto = Replace(texto, "_", "")
    texto = Replace(texto, "/", "")
    texto = Replace(texto, "\", "")
    texto = Replace(texto, "(", "")
    texto = Replace(texto, ")", "")
    texto = Replace(texto, ":", "")
    texto = Replace(texto, "'", "")

    NormalizarTexto = texto

End Function


'========================================================
' OBTENER CAMPO
'========================================================

Private Function ObtenerCampo( _
    ByVal ws As Worksheet, _
    ByVal fila As Long, _
    ByVal mapa As Object, _
    ByVal campo As String) As String

    Dim i As Variant

    For Each i In mapa.Keys

        If mapa(i) = campo Then

            ObtenerCampo = _
                TextoSeguro( _
                    ws.Cells(fila, i).Value)

            Exit Function

        End If

    Next i

    ObtenerCampo = ""

End Function


'========================================================
' OBTENER FECHA
'========================================================

Private Function ObtenerFechaCampo( _
    ByVal ws As Worksheet, _
    ByVal fila As Long, _
    ByVal mapa As Object, _
    ByVal campo As String) As Variant

    Dim i As Variant

    For Each i In mapa.Keys

        If mapa(i) = campo Then

            ObtenerFechaCampo = _
                ConvertirFecha( _
                    ws.Cells(fila, i).Value)

            Exit Function

        End If

    Next i

    ObtenerFechaCampo = Empty

End Function


'========================================================
' BUSCAR EN ACCESS
'========================================================

Private Function BuscarEnAccess( _
    ByVal rfc As String, _
    ByVal curp As String, _
    ByVal rfcCompleto As String, _
    ByRef fechaAccess As Variant) As Boolean

    Dim cn As Object
    Dim rs As Object

    Dim sql As String
    Dim criterio As String

    Dim fecha As Variant
    Dim fechaMayor As Variant

    Dim encontro As Boolean


    On Error GoTo ErrorHandler


    Set cn = AbrirConexionAccess()


    If cn Is Nothing Then Exit Function


    criterio = ""


    If rfc <> "" Then

        criterio = _
            "[RFC]='" & _
            Replace(rfc, "'", "''") & "'"

    End If


    If curp <> "" Then

        If criterio <> "" Then _
            criterio = criterio & " OR "

        criterio = criterio & _
            "[CURP]='" & _
            Replace(curp, "'", "''") & "'"

    End If


    If rfcCompleto <> "" Then

        If criterio <> "" Then _
            criterio = criterio & " OR "

        criterio = criterio & _
            "[RFC_COMPLETO]='" & _
            Replace(rfcCompleto, "'", "''") & "'"

    End If


    If criterio = "" Then Exit Function


    sql = _
        "SELECT [FECHA_SOLICITA_AHORRO_O_CUANDO_INGRESO] " & _
        "FROM [" & TABLA_ACCESS & "] " & _
        "WHERE " & criterio


    Set rs = cn.Execute(sql)


    fechaMayor = Empty


    Do While Not rs.EOF

        encontro = True


        fecha = _
            ConvertirFecha( _
                rs.Fields( _
                    "FECHA_SOLICITA_AHORRO_O_CUANDO_INGRESO").Value)


        If Not IsEmpty(fecha) Then

            If IsEmpty(fechaMayor) Then

                fechaMayor = fecha

            ElseIf CDate(fecha) > _
                   CDate(fechaMayor) Then

                fechaMayor = fecha

            End If

        End If


        rs.MoveNext

    Loop


    BuscarEnAccess = encontro

    fechaAccess = fechaMayor


Salir:

    On Error Resume Next

    If Not rs Is Nothing Then rs.Close
    If Not cn Is Nothing Then cn.Close

    Exit Function


ErrorHandler:

    BuscarEnAccess = False
    fechaAccess = Empty

    Resume Salir

End Function


'========================================================
' COPIAR REGISTRO
'========================================================

Private Sub CopiarRegistro( _
    ByVal wsOrigen As Worksheet, _
    ByVal wsDestino As Worksheet, _
    ByVal filaOrigen As Long, _
    ByVal filaDestino As Long, _
    ByVal mapa As Object)

    Dim i As Variant

    Dim campo As String
    Dim colDestino As Long

    Dim valor As Variant


    For Each i In mapa.Keys

        campo = mapa(i)


        If campo <> "RFC_COMPLETO" Then


            colDestino = _
                ColumnaRegistrar( _
                    wsDestino, _
                    campo)


            If colDestino > 0 Then

                valor = _
                    wsOrigen.Cells( _
                        filaOrigen, i).Value


                If Not IsError(valor) Then

                    wsDestino.Cells( _
                        filaDestino, _
                        colDestino).Value = valor

                End If

            End If

        End If

    Next i


    '====================================================
    ' RFC_COMPLETO
    '====================================================

    wsDestino.Cells( _
        filaDestino, 2).FormulaLocal = _
        "=SI(O(A" & filaDestino & _
        "="""";C" & filaDestino & _
        "="""");"""";A" & filaDestino & _
        "&C" & filaDestino & ")"


    '====================================================
    ' FECHA_APLICAR
    '====================================================

    wsDestino.Cells( _
        filaDestino, 17).FormulaLocal = _
        "=SI(P" & filaDestino & _
        "="""";"""";P" & filaDestino & _
        "+90)"


    '====================================================
    ' FECHA_HOY
    '====================================================

    wsDestino.Cells( _
        filaDestino, 18).FormulaLocal = "=HOY()"

End Sub


'========================================================
' BUSCAR COLUMNA EN REGISTRAR
'========================================================

Private Function ColumnaRegistrar( _
    ByVal ws As Worksheet, _
    ByVal campo As String) As Long

    Dim f As Long
    Dim c As Long

    Dim texto As String


    For f = 1 To 20

        For c = 1 To 50

            texto = _
                NormalizarTexto( _
                    TextoSeguro( _
                        ws.Cells(f, c).Value))


            If texto = _
                NormalizarTexto(campo) Then

                ColumnaRegistrar = c

                Exit Function

            End If

        Next c

    Next f


    ColumnaRegistrar = 0

End Function


'========================================================
' PRIMERA FILA LIBRE
'========================================================

Private Function PrimeraFilaLibre( _
    ByVal ws As Worksheet) As Long

    Dim f As Long


    f = FILA_INICIO


    Do While Trim$( _
        CStr(ws.Cells(f, 1).Value)) <> ""


        f = f + 1


        If f > 5000 Then

            MsgBox _
                "No hay espacio disponible en REGISTRAR.", _
                vbCritical, _
                "IMPORTAR"

            PrimeraFilaLibre = 0

            Exit Function

        End If

    Loop


    PrimeraFilaLibre = f

End Function


'========================================================
' MÁS RECIENTE
'========================================================

Private Function EsMasReciente( _
    ByVal fechaNueva As Variant, _
    ByVal fechaAnterior As Variant) As Boolean


    If IsEmpty(fechaNueva) Then Exit Function


    If Not IsDate(fechaNueva) Then Exit Function


    If IsEmpty(fechaAnterior) Then

        EsMasReciente = True

        Exit Function

    End If


    If Not IsDate(fechaAnterior) Then

        EsMasReciente = True

        Exit Function

    End If


    EsMasReciente = _
        CDate(fechaNueva) > _
        CDate(fechaAnterior)

End Function


'========================================================
' CONVERTIR FECHA
'========================================================

Private Function ConvertirFecha( _
    ByVal valor As Variant) As Variant

    Dim texto As String
    Dim p() As String

    Dim d As Integer
    Dim m As Integer
    Dim a As Integer


    On Error GoTo ErrorFecha


    If IsNull(valor) Or IsError(valor) Then

        ConvertirFecha = Empty
        Exit Function

    End If


    If IsDate(valor) Then

        ConvertirFecha = CDate(valor)
        Exit Function

    End If


    texto = Trim$(CStr(valor))


    If texto = "" Then

        ConvertirFecha = Empty
        Exit Function

    End If


    texto = Replace(texto, "-", "/")
    texto = Replace(texto, ".", "/")


    p = Split(texto, "/")


    If UBound(p) <> 2 Then

        ConvertirFecha = Empty
        Exit Function

    End If


    d = CInt(p(0))
    m = CInt(p(1))
    a = CInt(p(2))


    If a < 100 Then a = a + 2000


    ConvertirFecha = _
        DateSerial(a, m, d)


    Exit Function


ErrorFecha:

    ConvertirFecha = Empty

End Function


'========================================================
' TEXTO SEGURO
'========================================================

Private Function TextoSeguro( _
    ByVal valor As Variant) As String

    If IsError(valor) Then

        TextoSeguro = ""

    ElseIf IsNull(valor) Then

        TextoSeguro = ""

    Else

        TextoSeguro = Trim$(CStr(valor))

    End If

End Function