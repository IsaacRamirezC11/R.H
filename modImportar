Option Explicit

'========================================================
' MODIMPORTAR
'
' IMPORTACIÓN:
' EXCEL EXTERNO → REGISTRAR
'
' IMPORTANTE:
' El ID es interno y NO se importa desde archivos externos.
'
' La fecha utilizada para comparar registros es:
'
' FECHA_SOLICITA_AHORRO_O_CUANDO_INGRESO
'
' Access conserva sus fechas como TEXTO CORTO.
'========================================================


'========================================================
' 1. BOTÓN IMPORTAR
'========================================================

Public Sub ImportarArchivoExterno()

    Dim fd As FileDialog
    Dim archivo As String
    Dim extension As String

    On Error GoTo ErrorHandler

    Set fd = Application.FileDialog(msoFileDialogFilePicker)

    With fd

        .Title = "SELECCIONAR ARCHIVO"

        .AllowMultiSelect = False

        .Filters.Clear

        .Filters.Add _
            "Archivos de Excel", _
            "*.xlsx;*.xls;*.xlsm"

        .Filters.Add _
            "Archivos PDF", _
            "*.pdf"

        If .Show <> -1 Then Exit Sub

        archivo = .SelectedItems(1)

    End With


    extension = LCase$( _
        Mid$(archivo, InStrRev(archivo, ".") + 1) _
    )


    Select Case extension

        Case "xlsx", "xls", "xlsm"

            ImportarExcel archivo


        Case "pdf"

            MsgBox _
                "El PDF fue seleccionado correctamente." & _
                vbCrLf & vbCrLf & _
                "La lectura automática de PDF todavía " & _
                "no está habilitada en esta versión.", _
                vbInformation, _
                "PDF"


        Case Else

            MsgBox _
                "Tipo de archivo no compatible.", _
                vbExclamation, _
                "IMPORTAR"

    End Select

    Exit Sub


ErrorHandler:

    MsgBox _
        "No se pudo iniciar la importación." & _
        vbCrLf & vbCrLf & _
        "Error " & Err.Number & ":" & _
        vbCrLf & _
        Err.Description, _
        vbCritical, _
        "ERROR"

End Sub



'========================================================
' 2. IMPORTAR EXCEL
'========================================================

Private Sub ImportarExcel(ByVal rutaArchivo As String)

    Dim wbOrigen As Workbook
    Dim wsOrigen As Worksheet
    Dim wsDestino As Worksheet

    Dim ultimaFila As Long
    Dim ultimaColumna As Long

    Dim filaEncabezados As Long
    Dim fila As Long
    Dim filaDestino As Long

    Dim encabezados As Object
    Dim equivalencias As Object

    Dim i As Long

    Dim encabezado As String
    Dim campoDestino As String

    Dim rfc As String
    Dim curp As String
    Dim rfcCompleto As String

    Dim existeAccess As Boolean

    Dim fechaExterna As Variant
    Dim fechaAccess As Variant

    Dim cargados As Long
    Dim ignorados As Long


    On Error GoTo ErrorHandler


    Application.ScreenUpdating = False
    Application.EnableEvents = False


    '====================================================
    ' REGISTRAR
    '====================================================

    Set wsDestino = _
        ThisWorkbook.Worksheets("REGISTRAR")


    '====================================================
    ' ABRIR EXCEL EXTERNO
    '====================================================

    Set wbOrigen = Workbooks.Open( _
        Filename:=rutaArchivo, _
        ReadOnly:=True)


    Set wsOrigen = wbOrigen.Worksheets(1)


    '====================================================
    ' DIMENSIONES
    '====================================================

    ObtenerDimensiones _
        wsOrigen, _
        ultimaFila, _
        ultimaColumna


    If ultimaFila = 0 Then

        MsgBox _
            "El archivo está vacío.", _
            vbExclamation, _
            "IMPORTAR"

        GoTo Salir

    End If


    '====================================================
    ' BUSCAR ENCABEZADOS
    '====================================================

    filaEncabezados = _
        BuscarFilaEncabezados( _
            wsOrigen, _
            ultimaFila, _
            ultimaColumna)


    If filaEncabezados = 0 Then

        MsgBox _
            "No pude encontrar los encabezados del archivo." & _
            vbCrLf & vbCrLf & _
            "Se necesita al menos RFC, CURP o NOMBRE.", _
            vbExclamation, _
            "IMPORTAR"

        GoTo Salir

    End If


    '====================================================
    ' EQUIVALENCIAS
    '====================================================

    Set equivalencias = CrearEquivalencias()

    Set encabezados = _
        CreateObject("Scripting.Dictionary")

    encabezados.CompareMode = 1


    '====================================================
    ' LEER ENCABEZADOS EXTERNOS
    '====================================================

    For i = 1 To ultimaColumna

        encabezado = _
            NormalizarTexto( _
                CStr( _
                    wsOrigen.Cells( _
                        filaEncabezados, _
                        i).Value))


        If encabezado <> "" Then

            If equivalencias.Exists(encabezado) Then

                encabezados(i) = _
                    equivalencias(encabezado)

            End If

        End If

    Next i


    If encabezados.Count = 0 Then

        MsgBox _
            "No se encontraron campos compatibles.", _
            vbExclamation, _
            "IMPORTAR"

        GoTo Salir

    End If


    '====================================================
    ' PRIMERA FILA LIBRE
    '====================================================

    filaDestino = _
        SiguienteFilaRegistrar(wsDestino)


    If filaDestino = 0 Then GoTo Salir


    '====================================================
    ' RECORRER REGISTROS
    '====================================================

    For fila = filaEncabezados + 1 To ultimaFila


        rfc = ""
        curp = ""
        rfcCompleto = ""


        '================================================
        ' OBTENER IDENTIFICADORES
        '================================================

        For i = 1 To ultimaColumna

            If encabezados.Exists(i) Then

                campoDestino = encabezados(i)


                Select Case campoDestino

                    Case "RFC"

                        rfc = _
                            TextoSeguro( _
                                wsOrigen.Cells( _
                                    fila, _
                                    i).Value)


                    Case "CURP"

                        curp = _
                            TextoSeguro( _
                                wsOrigen.Cells( _
                                    fila, _
                                    i).Value)


                    Case "RFC_COMPLETO"

                        rfcCompleto = _
                            TextoSeguro( _
                                wsOrigen.Cells( _
                                    fila, _
                                    i).Value)

                End Select

            End If

        Next i


        '================================================
        ' FILA SIN IDENTIFICADOR
        '================================================

        If rfc = "" And _
           curp = "" And _
           rfcCompleto = "" Then

            ignorados = ignorados + 1

            GoTo SiguienteRegistro

        End If


        '================================================
        ' FECHA DEL ARCHIVO EXTERNO
        '================================================

        fechaExterna = _
            ObtenerFechaSolicitud( _
                wsOrigen, _
                fila, _
                encabezados)


        '================================================
        ' BUSCAR EN ACCESS
        '================================================

        fechaAccess = Empty


        existeAccess = _
            BuscarRegistroAccess( _
                rfc, _
                curp, _
                rfcCompleto, _
                fechaAccess)


        '================================================
        ' NO EXISTE EN ACCESS
        '================================================

        If Not existeAccess Then

            CopiarRegistroARegistrar _
                wsOrigen, _
                wsDestino, _
                fila, _
                filaDestino, _
                encabezados


            cargados = cargados + 1

            filaDestino = filaDestino + 1


        '================================================
        ' EXISTE EN ACCESS
        '================================================

        Else

            If EsMasReciente( _
                fechaExterna, _
                fechaAccess) Then


                CopiarRegistroARegistrar _
                    wsOrigen, _
                    wsDestino, _
                    fila, _
                    filaDestino, _
                    encabezados


                cargados = cargados + 1

                filaDestino = filaDestino + 1


            Else

                ignorados = ignorados + 1

            End If

        End If


SiguienteRegistro:

    Next fila


    '====================================================
    ' RESULTADO
    '====================================================

    MsgBox _
        "IMPORTACIÓN TERMINADA." & _
        vbCrLf & vbCrLf & _
        "Registros cargados: " & cargados & _
        vbCrLf & _
        "Registros no cargados: " & ignorados & _
        vbCrLf & vbCrLf & _
        "Los registros quedaron en REGISTRAR " & _
        "para revisión manual.", _
        vbInformation, _
        "IMPORTACIÓN"


Salir:

    On Error Resume Next

    If Not wbOrigen Is Nothing Then

        wbOrigen.Close SaveChanges:=False

    End If

    Application.EnableEvents = True
    Application.ScreenUpdating = True

    Exit Sub


ErrorHandler:

    MsgBox _
        "ERROR DURANTE LA IMPORTACIÓN." & _
        vbCrLf & vbCrLf & _
        "Error " & Err.Number & ":" & _
        vbCrLf & _
        Err.Description, _
        vbCritical, _
        "ERROR DE IMPORTACIÓN"

    Resume Salir

End Sub



'========================================================
' 3. DIMENSIONES DEL ARCHIVO
'========================================================

Private Sub ObtenerDimensiones( _
    ByVal ws As Worksheet, _
    ByRef ultimaFila As Long, _
    ByRef ultimaColumna As Long)

    Dim celda As Range


    ultimaFila = 0
    ultimaColumna = 0


    Set celda = ws.Cells.Find( _
        What:="*", _
        After:=ws.Range("A1"), _
        LookIn:=xlFormulas, _
        LookAt:=xlPart, _
        SearchOrder:=xlByRows, _
        SearchDirection:=xlPrevious)


    If celda Is Nothing Then Exit Sub


    ultimaFila = celda.Row


    Set celda = ws.Cells.Find( _
        What:="*", _
        After:=ws.Range("A1"), _
        LookIn:=xlFormulas, _
        LookAt:=xlPart, _
        SearchOrder:=xlByColumns, _
        SearchDirection:=xlPrevious)


    If celda Is Nothing Then Exit Sub


    ultimaColumna = celda.Column

End Sub



'========================================================
' 4. BUSCAR FILA DE ENCABEZADOS
'========================================================

Private Function BuscarFilaEncabezados( _
    ByVal ws As Worksheet, _
    ByVal ultimaFila As Long, _
    ByVal ultimaColumna As Long) As Long

    Dim fila As Long
    Dim col As Long

    Dim texto As String

    Dim RFC As Boolean
    Dim CURP As Boolean
    Dim NOMBRE As Boolean


    For fila = 1 To ultimaFila

        RFC = False
        CURP = False
        NOMBRE = False


        For col = 1 To ultimaColumna

            texto = _
                NormalizarTexto( _
                    CStr( _
                        ws.Cells( _
                            fila, _
                            col).Value))


            Select Case texto

                Case "RFC", _
                     "RFCFISCAL", _
                     "REGISTROFEDERALDECONTRIBUYENTES"

                    RFC = True


                Case "CURP"

                    CURP = True


                Case "NOMBRE", _
                     "NOMBRES", _
                     "NOMBRECOMPLETO"

                    NOMBRE = True

            End Select

        Next col


        If RFC Or CURP Or NOMBRE Then

            BuscarFilaEncabezados = fila

            Exit Function

        End If

    Next fila


    BuscarFilaEncabezados = 0

End Function



