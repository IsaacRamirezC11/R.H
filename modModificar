Option Explicit

'==========================================================
' MODMODIFICAR
'==========================================================
'
' HOJA:
'   MODIFICAR
'
' TABLA ACCESS:
'   AHORRO_SOLIDARIO
'
' BUSQUEDA:
'   RFC
'   RFC_COMPLETO
'   CURP
'
' BUSQUEDA P:
'   C_B = P / P1 / P2 ... P10
'
'
' COLUMNAS:
'   A:AL = datos
'   AM = ID auxiliar de Access
'
' IMPORTANTE:
'
' - No se modifica la fila de encabezados.
' - No se copian encabezados como datos.
' - Los campos calculados no se toman de Access.
' - RFC_COMPLETO se calcula.
' - FECHA_APLICAR_AHORRO se calcula.
' - FECHA_HOY se calcula.
' - RESULTADO_ANALISIS se calcula.
' - Las formulas solamente se colocan en filas con resultados.
' - La busqueda NO modifica REGISTRAR.
'
'==========================================================


Private Const HOJA_MODIFICAR As String = "MODIFICAR"

Private Const TABLA_ACCESS As String = "AHORRO_SOLIDARIO"

Private Const FILA_ENCABEZADOS As Long = 8

Private Const FILA_INICIO As Long = 9

Private Const FILA_MAXIMA As Long = 5000

Private Const COLUMNA_INICIO As Long = 1

Private Const COLUMNA_FIN As Long = 38

' AM = 39
Private Const COLUMNA_ID_AUX As Long = 39


'==========================================================
' BUSCAR POR RFC / RFC_COMPLETO / CURP
'
' BUSCA EN ACCESS:
'   RFC
'   RFC + HOM
'   CURP
'
' IMPORTANTE:
'   NO UTILIZA Nz()
'   NO UTILIZA Trim() EN ACCESS
'   NO UTILIZA UCase() EN ACCESS
'
' RFC_COMPLETO NO ES UN CAMPO DE ACCESS.
' Se compara como:
'
' RFC + HOM
'
'==========================================================

Public Sub BuscarPorDatos()

    Dim ws As Worksheet

    Dim cn As Object
    Dim rs As Object

    Dim rfc As String
    Dim rfcCompleto As String
    Dim curp As String

    Dim condiciones As String
    Dim sql As String

    Dim cantidad As Long


    On Error GoTo ErrorHandler


    '======================================================
    ' HOJA MODIFICAR
    '======================================================

    Set ws = _
        ThisWorkbook.Worksheets( _
            HOJA_MODIFICAR)


    '======================================================
    ' OBTENER DATOS DE BUSQUEDA
    '======================================================

    rfc = _
        NormalizarTexto( _
            ws.Range("E3").Value)


    rfcCompleto = _
        NormalizarTexto( _
            ws.Range("E4").Value)


    curp = _
        NormalizarTexto( _
            ws.Range("E5").Value)


    '======================================================
    ' VALIDAR
    '======================================================

    If rfc = "" And _
       rfcCompleto = "" And _
       curp = "" Then


        MsgBox _
            "Ingresa al menos uno de los siguientes datos:" & _
            vbCrLf & vbCrLf & _
            "RFC" & _
            vbCrLf & _
            "RFC_COMPLETO" & _
            vbCrLf & _
            "CURP", _
            vbExclamation, _
            "BUSCAR"


        Exit Sub

    End If


    Application.ScreenUpdating = False

    Application.EnableEvents = False

    Application.StatusBar = _
        "Buscando registros..."


    '======================================================
    ' LIMPIAR RESULTADOS ANTERIORES
    '======================================================

    LimpiarResultados ws


    '======================================================
    ' CONEXION ACCESS
    '======================================================

    Set cn = _
        AbrirConexionAccess()


    If cn Is Nothing Then


        Err.Raise _
            vbObjectError + 4000, _
            "BuscarPorDatos", _
            "No se pudo abrir la conexión con Access."


    End If


    '======================================================
    ' CREAR CONDICIONES
    '======================================================

    condiciones = ""


    '======================================================
    ' BUSCAR POR RFC
    '
    ' Access:
    '
    ' RFC = texto exacto
    '
    '======================================================

    If rfc <> "" Then


        condiciones = _
            "[RFC]='" & _
            EscaparSQL(rfc) & "'"


    End If


    '======================================================
    ' BUSCAR POR RFC_COMPLETO
    '
    ' RFC_COMPLETO = RFC + HOM
    '
    ' Ejemplo:
    '
    ' RFC = CADJ850618
    ' HOM = UN2
    '
    ' RFC_COMPLETO:
    '
    ' CADJ850618UN2
    '
    '======================================================

    If rfcCompleto <> "" Then


        If condiciones <> "" Then

            condiciones = _
                condiciones & _
                " AND "

        End If


        condiciones = _
            condiciones & _
            "([RFC] & [HOM])='" & _
            EscaparSQL(rfcCompleto) & "'"


    End If


    '======================================================
    ' BUSCAR POR CURP
    '======================================================

    If curp <> "" Then


        If condiciones <> "" Then

            condiciones = _
                condiciones & _
                " AND "

        End If


        condiciones = _
            condiciones & _
            "[CURP]='" & _
            EscaparSQL(curp) & "'"


    End If


    '======================================================
    ' VALIDAR CONDICIONES
    '======================================================

    If condiciones = "" Then


        MsgBox _
            "No se pudo construir la búsqueda.", _
            vbExclamation, _
            "BUSCAR"


        GoTo Salir


    End If


    '======================================================
    ' CONSULTA
    '
    ' ORDEN:
    '
    ' AÑO más reciente
    ' QNA más reciente
    ' ID más reciente
    '
    '======================================================

    sql = _
        "SELECT * FROM [" & _
        TABLA_ACCESS & "] " & _
        "WHERE " & _
        condiciones & _
        " ORDER BY [AÑO] DESC, [QNA] DESC, [Id] DESC"


    '======================================================
    ' EJECUTAR
    '======================================================

    Set rs = _
        cn.Execute(sql)


    '======================================================
    ' ESCRIBIR RESULTADOS
    '======================================================

    cantidad = _
        EscribirResultados( _
            ws, _
            rs)


    '======================================================
    ' APLICAR FORMULAS
    '
    ' SOLO A LAS FILAS QUE REALMENTE ENCONTRAMOS.
    '======================================================

    If cantidad > 0 Then


        RellenarFormulasModificar _
            ws, _
            FILA_INICIO, _
            FILA_INICIO + cantidad - 1

        FormatearFechasModificar _
            ws, _
            FILA_INICIO, _
            FILA_INICIO + cantidad - 1


    End If


    Application.Calculate


    '======================================================
    ' RESULTADO
    '======================================================

    If cantidad = 0 Then


        MsgBox _
            "NO SE ENCONTRARON REGISTROS." & _
            vbCrLf & vbCrLf & _
            "Datos utilizados para la búsqueda:" & _
            vbCrLf & _
            "RFC: " & rfc & _
            vbCrLf & _
            "RFC_COMPLETO: " & rfcCompleto & _
            vbCrLf & _
            "CURP: " & curp, _
            vbInformation, _
            "BUSCAR"


    Else


        MsgBox _
            "BUSQUEDA COMPLETADA." & _
            vbCrLf & vbCrLf & _
            "Registros encontrados: " & _
            cantidad, _
            vbInformation, _
            "BUSCAR"


    End If


Salir:

    On Error Resume Next


    If Not rs Is Nothing Then

        rs.Close

    End If


    If Not cn Is Nothing Then

        cn.Close

    End If


    Application.StatusBar = False

    Application.EnableEvents = True

    Application.ScreenUpdating = True


    Exit Sub


ErrorHandler:

    Application.StatusBar = False

    Application.EnableEvents = True

    Application.ScreenUpdating = True


    MsgBox _
        "ERROR DURANTE LA BUSQUEDA." & _
        vbCrLf & vbCrLf & _
        "Numero: " & _
        Err.Number & _
        vbCrLf & _
        "Descripcion: " & _
        Err.Description & _
        vbCrLf & vbCrLf & _
        "SQL utilizado:" & _
        vbCrLf & _
        sql, _
        vbCritical, _
        "ERROR DE BUSQUEDA"


    Resume Salir

End Sub


'==========================================================
' BUSCAR P / P1 / P2 / ... / P10
'
' BUSCA DIRECTAMENTE EN C_B
'
' NO UTILIZA Nz()
' NO UTILIZA Trim()
' NO UTILIZA UCase()
'
' ORDEN:
'   AÑO DESC
'   QNA DESC
'   ID DESC
'==========================================================

Public Sub BuscarPendientes()

    Dim ws As Worksheet

    Dim cn As Object
    Dim rs As Object

    Dim sql As String

    Dim cantidad As Long


    On Error GoTo ErrorHandler


    Set ws = _
        ThisWorkbook.Worksheets( _
            HOJA_MODIFICAR)


    '======================================================
    ' PREPARAR EXCEL
    '======================================================

    Application.ScreenUpdating = False

    Application.EnableEvents = False

    Application.StatusBar = _
        "Buscando registros pendientes..."


    '======================================================
    ' LIMPIAR RESULTADOS ANTERIORES
    '======================================================

    LimpiarResultados ws


    '======================================================
    ' CONECTAR CON ACCESS
    '======================================================

    Set cn = _
        AbrirConexionAccess()


    If cn Is Nothing Then

        Err.Raise _
            vbObjectError + 4001, _
            "BuscarPendientes", _
            "No se pudo abrir la conexión con Access."

    End If


    '======================================================
    ' CONSULTA
    '
    ' IMPORTANTE:
    '
    ' No utilizamos Nz().
    ' C_B es texto corto.
    '======================================================

    sql = _
        "SELECT * FROM [" & _
        TABLA_ACCESS & "] " & _
        "WHERE [C_B]='P' " & _
        "OR [C_B]='P1' " & _
        "OR [C_B]='P2' " & _
        "OR [C_B]='P3' " & _
        "OR [C_B]='P4' " & _
        "OR [C_B]='P5' " & _
        "OR [C_B]='P6' " & _
        "OR [C_B]='P7' " & _
        "OR [C_B]='P8' " & _
        "OR [C_B]='P9' " & _
        "OR [C_B]='P10' " & _
        "ORDER BY [AÑO] DESC, [QNA] DESC, [Id] DESC"


    '======================================================
    ' EJECUTAR
    '======================================================

    Set rs = _
        cn.Execute(sql)


    '======================================================
    ' ESCRIBIR RESULTADOS
    '======================================================

    cantidad = _
        EscribirResultados( _
            ws, _
            rs)


    '======================================================
    ' APLICAR FORMULAS SOLO A LOS RESULTADOS
    '======================================================

    If cantidad > 0 Then

        RellenarFormulasModificar _
            ws, _
            FILA_INICIO, _
            FILA_INICIO + cantidad - 1

        FormatearFechasModificar _
            ws, _
            FILA_INICIO, _
            FILA_INICIO + cantidad - 1

    End If


    Application.Calculate


    '======================================================
    ' MENSAJE
    '======================================================

    If cantidad = 0 Then

        MsgBox _
            "NO SE ENCONTRARON REGISTROS PENDIENTES." & _
            vbCrLf & vbCrLf & _
            "Se buscaron:" & _
            vbCrLf & _
            "P" & _
            vbCrLf & _
            "P1 hasta P10", _
            vbInformation, _
            "P / PENDIENTES"

    Else

        MsgBox _
            "BUSQUEDA COMPLETADA." & _
            vbCrLf & vbCrLf & _
            "Registros encontrados: " & _
            cantidad, _
            vbInformation, _
            "P / PENDIENTES"

    End If


Salir:

    On Error Resume Next


    If Not rs Is Nothing Then

        rs.Close

    End If


    If Not cn Is Nothing Then

        cn.Close

    End If


    Application.StatusBar = False

    Application.EnableEvents = True

    Application.ScreenUpdating = True


    Exit Sub


ErrorHandler:

    Application.StatusBar = False

    Application.EnableEvents = True

    Application.ScreenUpdating = True


    MsgBox _
        "ERROR AL BUSCAR P / P1-P10." & _
        vbCrLf & vbCrLf & _
        "Numero: " & Err.Number & _
        vbCrLf & _
        "Descripcion: " & Err.Description & _
        vbCrLf & vbCrLf & _
        "SQL utilizado:" & vbCrLf & _
        sql, _
        vbCritical, _
        "ERROR"


    Resume Salir

End Sub


'==========================================================
' ESCRIBIR RESULTADOS
'
' IMPORTANTE:
'
' SOLO ESCRIBE EN FILAS DE DATOS.
'
' NUNCA ESCRIBE EN LA FILA 8.
'
' NO COPIA ENCABEZADOS.
'
' NO ESCRIBE CAMPOS CALCULADOS.
'==========================================================

Private Function EscribirResultados( _
    ByVal ws As Worksheet, _
    ByVal rs As Object) As Long

    Dim fila As Long
    Dim c As Long
    Dim campo As String
    Dim columna As Long
    Dim valor As Variant
    Dim cantidad As Long
    Dim fechaReal As Variant

    fila = FILA_INICIO

    If rs.EOF Then
        EscribirResultados = 0
        Exit Function
    End If

    Do While Not rs.EOF

        If fila > FILA_MAXIMA Then
            Exit Do
        End If

        '==================================================
        ' RECORRER CAMPOS DE ACCESS
        '==================================================

        For c = 0 To rs.Fields.Count - 1

            campo = Trim$(CStr(rs.Fields(c).Name))

            '================================================
            ' ID SE GUARDA SOLAMENTE EN AM
            '================================================

            If UCase$(campo) <> "ID" Then

                '================================================
                ' CAMPOS CALCULADOS NO SE IMPORTAN DESDE ACCESS
                '================================================

                If Not EsCampoCalculadoModificar(campo) Then

                    columna = BuscarColumna(ws, campo)

                    If columna > 0 Then

                        If IsNull(rs.Fields(c).Value) Then
                            valor = ""
                        Else
                            valor = rs.Fields(c).Value
                        End If

                        '============================================
                        ' CAMPOS DE FECHA
                        '
                        ' ACCESS LOS TIENE COMO TEXTO CORTO.
                        ' SE INTERPRETAN SIEMPRE COMO DD/MM/YYYY.
                        '============================================

                        If EsCampoFechaModificar(campo) Then

                            If EsValorVacioModificar(valor) Then

                                ws.Cells(fila, columna).ClearContents

                            Else

                                fechaReal = ConvertirFechaDMYModificar(valor)

                                If IsDate(fechaReal) Then

                                    ws.Cells(fila, columna).Value = CDate(fechaReal)

                                Else

                                    ws.Cells(fila, columna).Value = valor

                                End If

                                ws.Cells(fila, columna).NumberFormat = "dd/mm/yyyy"

                            End If

                        Else

                            If Not IsError(valor) Then

                                ws.Cells(fila, columna).Value = valor

                            End If

                        End If

                    End If

                End If

            End If

        Next c

        '==================================================
        ' GUARDAR ID DE ACCESS EN AM
        '==================================================

        On Error Resume Next

        If Not IsNull(rs.Fields("Id").Value) Then

            ws.Cells(fila, COLUMNA_ID_AUX).Value = rs.Fields("Id").Value

        Else

            ws.Cells(fila, COLUMNA_ID_AUX).ClearContents

        End If

        On Error GoTo 0

        cantidad = cantidad + 1
        fila = fila + 1

        rs.MoveNext

    Loop

    EscribirResultados = cantidad

End Function


'==========================================================
' ES CAMPO DE FECHA
'
' ACCESS MANTIENE ESTOS CAMPOS COMO TEXTO CORTO.
'==========================================================

Private Function EsCampoFechaModificar( _
    ByVal nombreCampo As String) As Boolean

    Select Case UCase$(Trim$(nombreCampo))

        Case "FECHA_SOLICITA_AHORRO_O_CUANDO_INGRESO"
            EsCampoFechaModificar = True

        Case "FECHA_APLICAR_AHORRO"
            EsCampoFechaModificar = True

        Case "FECHA_HOY"
            EsCampoFechaModificar = True

        Case Else
            EsCampoFechaModificar = False

    End Select

End Function


'==========================================================
' CONVERTIR FECHA DD/MM/YYYY
'
' EVITA QUE VBA INTERPRETE:
'
' 01/08/2026
'
' COMO:
'
' 08/01/2026
'
'
' TAMBIEN SOPORTA VALORES NUMERICOS DE FECHA DE EXCEL.
'==========================================================

Private Function ConvertirFechaDMYModificar( _
    ByVal valor As Variant) As Variant

    Dim texto As String
    Dim partes As Variant
    Dim dia As Long
    Dim mes As Long
    Dim anio As Long
    Dim numero As Double

    On Error GoTo ErrorFecha

    If VarType(valor) = vbDate Then

        ConvertirFechaDMYModificar = CDate(valor)
        Exit Function

    End If

    '======================================================
    ' SI ACCESS ENTREGA UN SERIAL NUMERICO
    '======================================================

    If IsNumeric(valor) Then

        numero = CDbl(valor)

        If numero >= 30000 And numero <= 100000 Then

            ConvertirFechaDMYModificar = _
                DateSerial(1899, 12, 30) + numero

            Exit Function

        End If

    End If

    texto = Trim$(CStr(valor))

    If texto = "" Then

        ConvertirFechaDMYModificar = ""
        Exit Function

    End If

    '======================================================
    ' QUITAR HORA
    '======================================================

    If InStr(1, texto, " ") > 0 Then
        texto = Left$(texto, InStr(1, texto, " ") - 1)
    End If

    If InStr(1, texto, "T") > 0 Then
        texto = Left$(texto, InStr(1, texto, "T") - 1)
    End If

    texto = Replace(texto, "-", "/")

    partes = Split(texto, "/")

    If UBound(partes) <> 2 Then
        GoTo ErrorFecha
    End If

    '======================================================
    ' YYYY/MM/DD
    '======================================================

    If Len(Trim$(partes(0))) = 4 Then

        anio = CLng(Trim$(partes(0)))
        mes = CLng(Trim$(partes(1)))
        dia = CLng(Trim$(partes(2)))

    Else

        '==================================================
        ' DD/MM/YYYY
        '==================================================

        dia = CLng(Trim$(partes(0)))
        mes = CLng(Trim$(partes(1)))
        anio = CLng(Trim$(partes(2)))

    End If

    If dia < 1 Or dia > 31 Then GoTo ErrorFecha
    If mes < 1 Or mes > 12 Then GoTo ErrorFecha
    If anio < 1900 Or anio > 2100 Then GoTo ErrorFecha

    '======================================================
    ' VALIDAR QUE NO SE AJUSTE AUTOMATICAMENTE UNA FECHA
    ' INVALIDA COMO 31/02/2026.
    '======================================================

    Dim fechaPrueba As Date

    fechaPrueba = DateSerial(anio, mes, dia)

    If Day(fechaPrueba) <> dia Or _
       Month(fechaPrueba) <> mes Or _
       Year(fechaPrueba) <> anio Then

        GoTo ErrorFecha

    End If

    ConvertirFechaDMYModificar = fechaPrueba

    Exit Function

ErrorFecha:

    ConvertirFechaDMYModificar = valor

End Function


'==========================================================
' APLICAR MODIFICACION
'
' ACTUALIZA TODOS LOS REGISTROS CARGADOS EN MODIFICAR.
'
' NO IMPORTA DONDE ESTE SELECCIONADA LA CELDA.
'
' FILAS:
'   9 hasta la ultima fila con RFC.
'
' Cada fila debe tener su ID de Access en AM.
'
'==========================================================

Public Sub AplicarModificacion()

    Dim ws As Worksheet
    Dim cn As Object
    Dim rs As Object
    Dim camposAccess As Object

    Dim ultimaFila As Long
    Dim fila As Long
    Dim c As Long

    Dim id As Variant
    Dim colRFC As Long

    Dim campo As String
    Dim claveCampo As String

    Dim valorExcel As Variant
    Dim valorAccess As Variant

    Dim listaCampos As String
    Dim sql As String

    Dim huboCambio As Boolean
    Dim encontradoAccess As Boolean

    Dim cantidadEncontrados As Long
    Dim cantidadModificados As Long
    Dim cantidadSinCambios As Long
    Dim cantidadSinID As Long
    Dim cantidadNoEncontrados As Long

    Dim respuesta As VbMsgBoxResult


    On Error GoTo ErrorHandler


    '======================================================
    ' HOJA
    '======================================================

    Set ws = _
        ThisWorkbook.Worksheets( _
            HOJA_MODIFICAR)


    '======================================================
    ' BUSCAR RFC POR ENCABEZADO
    '======================================================

    colRFC = _
        BuscarColumna( _
            ws, _
            "RFC")


    If colRFC = 0 Then

        MsgBox _
            "No se encontro la columna RFC.", _
            vbCritical, _
            "MODIFICAR"

        Exit Sub

    End If


    '======================================================
    ' ULTIMA FILA
    '======================================================

    ultimaFila = _
        ws.Cells( _
            ws.Rows.Count, _
            colRFC).End(xlUp).Row


    If ultimaFila < FILA_INICIO Then

        MsgBox _
            "NO HAY REGISTROS PARA MODIFICAR.", _
            vbExclamation, _
            "MODIFICAR"

        Exit Sub

    End If


    '======================================================
    ' CONTAR REGISTROS Y VALIDAR ID
    '======================================================

    For fila = _
        FILA_INICIO To _
        ultimaFila


        If Trim$( _
            CStr( _
                ws.Cells( _
                    fila, _
                    colRFC).Value)) <> "" Then


            cantidadEncontrados = _
                cantidadEncontrados + 1


            id = _
                ws.Cells( _
                    fila, _
                    COLUMNA_ID_AUX).Value


            If EsValorVacioModificar(id) Then

                cantidadSinID = _
                    cantidadSinID + 1

            End If


        End If


    Next fila


    If cantidadEncontrados = 0 Then

        MsgBox _
            "NO HAY REGISTROS PARA MODIFICAR.", _
            vbExclamation, _
            "MODIFICAR"

        Exit Sub

    End If


    If cantidadSinID > 0 Then

        MsgBox _
            "Hay " & _
            cantidadSinID & _
            " registro(s) sin ID de Access." & _
            vbCrLf & vbCrLf & _
            "Realiza nuevamente la búsqueda antes de modificar.", _
            vbExclamation, _
            "MODIFICAR"

        Exit Sub

    End If


    '======================================================
    ' CONFIRMAR
    '======================================================

    respuesta = _
        MsgBox( _
            "Se revisarán " & _
            cantidadEncontrados & _
            " registros." & _
            vbCrLf & vbCrLf & _
            "Solo se modificarán los registros" & _
            vbCrLf & _
            "que realmente tengan cambios." & _
            vbCrLf & vbCrLf & _
            "Al continuar, Excel quedará bloqueado" & _
            vbCrLf & _
            "hasta terminar el proceso." & _
            vbCrLf & vbCrLf & _
            "¿Deseas continuar?", _
            vbYesNo + _
            vbQuestion + _
            vbDefaultButton2, _
            "CONFIRMAR MODIFICACION")


    If respuesta <> vbYes Then

        Exit Sub

    End If


    '======================================================
    ' BLOQUEAR EXCEL DURANTE EL PROCESO
    '
    ' El usuario no podrá:
    ' - mover la selección
    ' - editar celdas
    ' - presionar otros botones
    '
    ' El proceso SI puede actualizar la barra de estado.
    '======================================================

    Application.EnableEvents = False

    Application.ScreenUpdating = True

    Application.Cursor = xlWait

    Application.Interactive = False

    Application.StatusBar = _
        "APLICANDO MODIFICACIONES... " & _
        "0 de " & cantidadEncontrados


    '======================================================
    ' CONEXION ACCESS
    '======================================================

    Set cn = _
        AbrirConexionAccess()


    If cn Is Nothing Then

        Err.Raise _
            vbObjectError + 4002, _
            "AplicarModificacion", _
            "No se pudo abrir la conexión con Access."

    End If


    '======================================================
    ' OBTENER LOS NOMBRES DE CAMPOS DE ACCESS UNA SOLA VEZ
    '
    ' Esto evita llamar CampoExisteEnAccess para cada celda
    ' y hace mucho mas rapido el proceso.
    '======================================================

    Set camposAccess = _
        CreateObject("Scripting.Dictionary")

    camposAccess.CompareMode = vbTextCompare


    Set rs = _
        cn.Execute( _
            "SELECT TOP 1 * FROM [" & _
            TABLA_ACCESS & "]")


    For c = 0 To rs.Fields.Count - 1

        camposAccess( _
            UCase$( _
                Trim$( _
                    CStr( _
                        rs.Fields(c).Name)))) = True

    Next c


    rs.Close
    Set rs = Nothing


    '======================================================
    ' RECORRER REGISTROS
    '======================================================

    For fila = _
        FILA_INICIO To _
        ultimaFila


        If Trim$( _
            CStr( _
                ws.Cells( _
                    fila, _
                    colRFC).Value)) <> "" Then


            id = _
                ws.Cells( _
                    fila, _
                    COLUMNA_ID_AUX).Value


            Application.StatusBar = _
                "APLICANDO MODIFICACIONES... " & _
                (fila - FILA_INICIO + 1) & _
                " de " & _
                cantidadEncontrados & _
                " | Fila " & fila


            DoEvents


            '================================================
            ' OBTENER REGISTRO ORIGINAL
            '================================================

            sql = _
                "SELECT * FROM [" & _
                TABLA_ACCESS & "] " & _
                "WHERE [Id]=" & _
                CLng(id)


            Set rs = _
                cn.Execute(sql)


            encontradoAccess = _
                Not rs.EOF


            If Not encontradoAccess Then

                cantidadNoEncontrados = _
                    cantidadNoEncontrados + 1

                rs.Close
                Set rs = Nothing

                GoTo SiguienteFila


            End If


            listaCampos = ""
            huboCambio = False


            '================================================
            ' COMPARAR A:AL CONTRA ACCESS
            '
            ' SOLO SE AGREGAN A SET LOS CAMPOS DIFERENTES.
            '================================================

            For c = _
                COLUMNA_INICIO To _
                COLUMNA_FIN


                campo = _
                    Trim$( _
                        CStr( _
                            ws.Cells( _
                                FILA_ENCABEZADOS, _
                                c).Value))


                If campo <> "" Then


                    If UCase$(campo) <> "ID" Then


                        If Not EsCampoCalculadoModificar( _
                            campo) Then


                            claveCampo = _
                                UCase$(campo)


                            '================================
                            ' EL CAMPO EXISTE EN ACCESS
                            '================================

                            If camposAccess.Exists( _
                                claveCampo) Then


                                valorExcel = _
                                    ws.Cells( _
                                        fila, _
                                        c).Value


                                valorAccess = _
                                    rs.Fields( _
                                        campo).Value


                                '============================
                                ' COMPARAR
                                '============================

                                If Not ValoresIgualesModificar( _
                                    valorExcel, _
                                    valorAccess) Then


                                    huboCambio = True


                                    If listaCampos <> "" Then

                                        listaCampos = _
                                            listaCampos & ","

                                    End If


                                    '========================
                                    ' VACIO = NULL
                                    '========================

                                    If EsValorVacioModificar( _
                                        valorExcel) Then


                                        listaCampos = _
                                            listaCampos & _
                                            "[" & campo & "]=Null"


                                    Else


                                        listaCampos = _
                                            listaCampos & _
                                            "[" & campo & "]=" & _
                                            ValorSQLModificar( _
                                                valorExcel, _
                                                campo)


                                    End If


                                End If


                            End If


                        End If


                    End If


                End If


            Next c


            rs.Close
            Set rs = Nothing


            '================================================
            ' ACTUALIZAR SOLO SI HUBO CAMBIOS
            '================================================

            If huboCambio And _
               listaCampos <> "" Then


                sql = _
                    "UPDATE [" & _
                    TABLA_ACCESS & "] " & _
                    "SET " & _
                    listaCampos & _
                    " WHERE [Id]=" & _
                    CLng(id)


                cn.Execute sql


                cantidadModificados = _
                    cantidadModificados + 1


            Else


                cantidadSinCambios = _
                    cantidadSinCambios + 1


            End If


        End If


SiguienteFila:

        DoEvents


    Next fila


    '======================================================
    ' RESTAURAR FORMULAS
    '
    ' SOLO DESPUES DE TERMINAR ACCESS.
    '======================================================

    Application.StatusBar = _
        "ACTUALIZANDO FORMULAS Y PREPARANDO RESULTADOS..."


    DoEvents


    If cantidadModificados > 0 Then

        RellenarFormulasModificar _
            ws, _
            FILA_INICIO, _
            ultimaFila

        FormatearFechasModificar _
            ws, _
            FILA_INICIO, _
            ultimaFila

    End If


    Application.Calculate


    Application.StatusBar = _
        "MODIFICACION COMPLETADA."


    DoEvents


    '======================================================
    ' RESULTADO
    '======================================================

    MsgBox _
        "MODIFICACION COMPLETADA." & _
        vbCrLf & vbCrLf & _
        "Registros revisados: " & _
        cantidadEncontrados & _
        vbCrLf & _
        "Registros modificados: " & _
        cantidadModificados & _
        vbCrLf & _
        "Sin cambios: " & _
        cantidadSinCambios & _
        IIf( _
            cantidadNoEncontrados > 0, _
            vbCrLf & _
            "No encontrados en Access: " & _
            cantidadNoEncontrados, _
            ""), _
        vbInformation, _
        "MODIFICAR"


Salir:

    On Error Resume Next


    If Not rs Is Nothing Then

        rs.Close

    End If


    If Not cn Is Nothing Then

        cn.Close

    End If


    Set rs = Nothing
    Set cn = Nothing
    Set camposAccess = Nothing


    Application.StatusBar = False

    Application.Interactive = True

    Application.Cursor = xlDefault

    Application.EnableEvents = True

    Application.ScreenUpdating = True


    Exit Sub


ErrorHandler:

    On Error Resume Next

    If Not rs Is Nothing Then

        rs.Close

    End If

    If Not cn Is Nothing Then

        cn.Close

    End If


    Application.StatusBar = False

    Application.Interactive = True

    Application.Cursor = xlDefault

    Application.EnableEvents = True

    Application.ScreenUpdating = True


    MsgBox _
        "ERROR AL APLICAR LA MODIFICACION." & _
        vbCrLf & vbCrLf & _
        "Fila: " & fila & _
        vbCrLf & _
        "Campo: " & campo & _
        vbCrLf & _
        "Numero: " & Err.Number & _
        vbCrLf & _
        "Descripcion: " & Err.Description, _
        vbCritical, _
        "ERROR DE MODIFICACION"


End Sub


'==========================================================
' CAMPOS CALCULADOS
'
' NO SE COMPARAN NI SE ACTUALIZAN EN ACCESS.
'==========================================================

Private Function EsCampoCalculadoModificar( _
    ByVal nombreCampo As String) As Boolean


    Select Case UCase$( _
        Trim$(nombreCampo))


        Case "RFC_COMPLETO"

            EsCampoCalculadoModificar = True


        Case "FECHA_APLICAR_AHORRO"

            EsCampoCalculadoModificar = True


        Case "FECHA_HOY"

            EsCampoCalculadoModificar = True


        Case "RESULTADO_ANALISIS"

            EsCampoCalculadoModificar = True


        Case Else

            EsCampoCalculadoModificar = False


    End Select

End Function


'==========================================================
' COMPROBAR SI UN VALOR ESTA VACIO
'==========================================================

Private Function EsValorVacioModificar( _
    ByVal valor As Variant) As Boolean


    If IsError(valor) Then

        EsValorVacioModificar = True
        Exit Function

    End If


    If IsNull(valor) Then

        EsValorVacioModificar = True
        Exit Function

    End If


    If IsEmpty(valor) Then

        EsValorVacioModificar = True
        Exit Function

    End If


    If Trim$(CStr(valor)) = "" Then

        EsValorVacioModificar = True
        Exit Function

    End If


    EsValorVacioModificar = False

End Function


'==========================================================
' COMPARAR VALOR DE EXCEL CONTRA ACCESS
'==========================================================

Private Function ValoresIgualesModificar( _
    ByVal valorExcel As Variant, _
    ByVal valorAccess As Variant) As Boolean


    Dim textoExcel As String
    Dim textoAccess As String


    '======================================================
    ' AMBOS VACIOS
    '======================================================

    If EsValorVacioModificar(valorExcel) And _
       EsValorVacioModificar(valorAccess) Then

        ValoresIgualesModificar = True

        Exit Function

    End If


    '======================================================
    ' UNO VACIO Y OTRO NO
    '======================================================

    If EsValorVacioModificar(valorExcel) Xor _
       EsValorVacioModificar(valorAccess) Then

        ValoresIgualesModificar = False

        Exit Function

    End If


    '======================================================
    ' FECHAS
    '======================================================

    If IsDate(valorAccess) And _
       IsDate(valorExcel) Then

        ValoresIgualesModificar = _
            (CDbl(CDate(valorExcel)) = _
             CDbl(CDate(valorAccess)))

        Exit Function

    End If


    '======================================================
    ' NUMEROS
    '======================================================

    If IsNumeric(valorAccess) And _
       IsNumeric(valorExcel) Then

        ValoresIgualesModificar = _
            (CDbl(valorExcel) = _
             CDbl(valorAccess))

        Exit Function

    End If


    '======================================================
    ' TEXTO
    '======================================================

    textoExcel = _
        UCase$( _
            Trim$( _
                CStr(valorExcel)))


    textoAccess = _
        UCase$( _
            Trim$( _
                CStr(valorAccess)))


    ValoresIgualesModificar = _
        (textoExcel = textoAccess)

End Function


'==========================================================
' CONVERTIR VALOR DE EXCEL A SQL
'==========================================================

Private Function ValorSQLModificar( _
    ByVal valor As Variant, _
    Optional ByVal nombreCampo As String = "") As String

    Dim fechaReal As Variant

    If IsError(valor) Then
        ValorSQLModificar = "Null"
        Exit Function
    End If

    If IsNull(valor) Then
        ValorSQLModificar = "Null"
        Exit Function
    End If

    If IsEmpty(valor) Then
        ValorSQLModificar = "Null"
        Exit Function
    End If

    If Trim$(CStr(valor)) = "" Then
        ValorSQLModificar = "Null"
        Exit Function
    End If

    '======================================================
    ' CAMPOS DE FECHA EN ACCESS = TEXTO CORTO
    '
    ' SE ENVIA:
    '     'DD/MM/YYYY'
    '
    ' NO SE USA #FECHA# PORQUE ACCESS LOS TIENE COMO TEXTO.
    '======================================================

    If EsCampoFechaModificar(nombreCampo) Then

        fechaReal = ConvertirFechaDMYModificar(valor)

        If IsDate(fechaReal) Then

            ValorSQLModificar = _
                "'" & _
                Format(CDate(fechaReal), "dd/mm/yyyy") & _
                "'"

        Else

            ValorSQLModificar = _
                "'" & _
                EscaparSQL(CStr(valor)) & _
                "'"

        End If

        Exit Function

    End If

    '======================================================
    ' RESTO DE FECHAS REALES DE ACCESS
    '======================================================

    If IsDate(valor) Then

        ValorSQLModificar = _
            "#" & _
            Format(CDate(valor), "yyyy\/mm\/dd") & _
            "#"

        Exit Function

    End If

    '======================================================
    ' NUMERO
    '======================================================

    If IsNumeric(valor) Then

        ValorSQLModificar = _
            Replace(CStr(valor), ",", ".")

        Exit Function

    End If

    '======================================================
    ' TEXTO
    '======================================================

    ValorSQLModificar = _
        "'" & _
        EscaparSQL(CStr(valor)) & _
        "'"

End Function


