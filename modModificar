'==========================================================
' RESTAURAR FORMULAS EN MODIFICAR
'
' P = FECHA_SOLICITA_AHORRO_O_CUANDO_INGRESO
' Q = FECHA_APLICAR_AHORRO
' R = FECHA_HOY
' S = RESULTADO_ANALISIS
'
'==========================================================

Private Sub RellenarFormulasModificar( _
    ByVal ws As Worksheet, _
    ByVal filaInicio As Long, _
    ByVal filaFinal As Long)

    Dim colRFC As Long
    Dim colHOM As Long
    Dim colRFCCompleto As Long

    Dim colFechaAplicar As Long
    Dim colFechaHoy As Long
    Dim colResultado As Long

    Dim f As Long


    On Error GoTo ErrorHandler


    '======================================================
    ' VALIDAR FILAS
    '======================================================

    If filaInicio < FILA_INICIO Then

        filaInicio = FILA_INICIO

    End If


    If filaFinal < filaInicio Then

        Exit Sub

    End If


    '======================================================
    ' BUSCAR COLUMNAS POR ENCABEZADO
    '======================================================

    colRFC = _
        BuscarColumna( _
            ws, _
            "RFC")


    colHOM = _
        BuscarColumna( _
            ws, _
            "HOM")


    colRFCCompleto = _
        BuscarColumna( _
            ws, _
            "RFC_COMPLETO")


    colFechaAplicar = _
        BuscarColumna( _
            ws, _
            "FECHA_APLICAR_AHORRO")


    colFechaHoy = _
        BuscarColumna( _
            ws, _
            "FECHA_HOY")


    colResultado = _
        BuscarColumna( _
            ws, _
            "RESULTADO_ANALISIS")


    '======================================================
    ' COLUMNAS FIJAS DE FECHAS
    '
    ' En MODIFICAR:
    '
    ' P = 16
    ' Q = 17
    ' R = 18
    ' S = 19
    '
    ' Usamos P directamente porque el encabezado real es:
    '
    ' FECHA_SOLICITA_AHORRO_O_CUANDO_INGRESO
    '======================================================

    If colFechaAplicar = 0 Then

        colFechaAplicar = 17

    End If


    If colFechaHoy = 0 Then

        colFechaHoy = 18

    End If


    If colResultado = 0 Then

        colResultado = 19

    End If


    '======================================================
    ' RFC_COMPLETO
    '
    ' RFC + HOM
    '======================================================

    If colRFCCompleto > 0 And _
       colRFC > 0 And _
       colHOM > 0 Then


        For f = filaInicio To filaFinal


            ws.Cells( _
                f, _
                colRFCCompleto).FormulaLocal = _
                "=SI(O(" & _
                ws.Cells(f, colRFC).Address(False, False) & _
                "=""""," & _
                ws.Cells(f, colHOM).Address(False, False) & _
                "=""""),""""," & _
                ws.Cells(f, colRFC).Address(False, False) & _
                "&" & _
                ws.Cells(f, colHOM).Address(False, False) & _
                ")"


        Next f


    End If


    '======================================================
    ' FECHA_APLICAR_AHORRO
    '
    ' P = FECHA_SOLICITA_AHORRO_O_CUANDO_INGRESO
    '
    ' Q = P + 90
    '
    ' Fórmula:
    '
    ' =SI(P9="","",P9+90)
    '======================================================

    For f = filaInicio To filaFinal


        ws.Cells( _
            f, _
            colFechaAplicar).FormulaLocal = _
            "=SI(P" & _
            f & _
            "="""","""",P" & _
            f & _
            "+90)"


    Next f


    '======================================================
    ' FECHA_HOY
    '
    ' R = HOY()
    '======================================================

    For f = filaInicio To filaFinal


        ws.Cells( _
            f, _
            colFechaHoy).FormulaLocal = _
            "=HOY()"


    Next f


    '======================================================
    ' RESULTADO_ANALISIS
    '
    ' S = SI(R>=Q,...)
    '======================================================

    For f = filaInicio To filaFinal


        ws.Cells( _
            f, _
            colResultado).FormulaLocal = _
            "=SI(R" & _
            f & _
            ">=Q" & _
            f & _
            ",""APLICAR AHORRO"",""AUN NO SE PUEDE APLICAR AHORRO"")"


    Next f


    Exit Sub


ErrorHandler:

    MsgBox _
        "ERROR AL APLICAR LAS FORMULAS." & _
        vbCrLf & vbCrLf & _
        "Numero: " & Err.Number & _
        vbCrLf & _
        "Descripcion: " & Err.Description, _
        vbCritical, _
        "ERROR DE FORMULAS"

End Sub


 '==========================================================
' FORMATEAR FECHAS EN EXCEL
'
' SOLO CAMBIA LA PRESENTACION.
' LAS FECHAS SIGUEN SIENDO FECHAS REALES EN EXCEL.
'==========================================================

Private Sub FormatearFechasModificar( _
    ByVal ws As Worksheet, _
    ByVal filaInicio As Long, _
    ByVal filaFinal As Long)

    Dim col As Long

    If filaFinal < filaInicio Then
        Exit Sub
    End If

    col = BuscarColumna(ws, "FECHA_SOLICITA_AHORRO_O_CUANDO_INGRESO")

    If col > 0 Then
        ws.Range( _
            ws.Cells(filaInicio, col), _
            ws.Cells(filaFinal, col)).NumberFormat = "dd/mm/yyyy"
    End If

    col = BuscarColumna(ws, "FECHA_APLICAR_AHORRO")

    If col > 0 Then
        ws.Range( _
            ws.Cells(filaInicio, col), _
            ws.Cells(filaFinal, col)).NumberFormat = "dd/mm/yyyy"
    End If

    col = BuscarColumna(ws, "FECHA_HOY")

    If col > 0 Then
        ws.Range( _
            ws.Cells(filaInicio, col), _
            ws.Cells(filaFinal, col)).NumberFormat = "dd/mm/yyyy"
    End If

End Sub


'==========================================================
' BUSCAR COLUMNA POR ENCABEZADO
'==========================================================

Private Function BuscarColumna( _
    ByVal ws As Worksheet, _
    ByVal nombreCampo As String) As Long


    Dim c As Long

    Dim ultimaColumna As Long

    Dim encabezado As String


    ultimaColumna = _
        ws.Cells( _
            FILA_ENCABEZADOS, _
            ws.Columns.Count).End( _
                xlToLeft).Column


    For c = _
        COLUMNA_INICIO To _
        ultimaColumna


        encabezado = _
            UCase$( _
                Trim$( _
                    CStr( _
                        ws.Cells( _
                            FILA_ENCABEZADOS, _
                            c).Value)))


        If encabezado = _
           UCase$( _
               Trim$( _
                   nombreCampo)) Then


            BuscarColumna = c

            Exit Function


        End If


    Next c


    BuscarColumna = 0


End Function


'==========================================================
' COMPROBAR CAMPO EN ACCESS
'==========================================================

Private Function CampoExisteEnAccess( _
    ByVal cn As Object, _
    ByVal tabla As String, _
    ByVal nombreCampo As String) As Boolean


    Dim rs As Object

    Dim sql As String


    On Error GoTo NoExiste


    sql = _
        "SELECT TOP 1 [" & _
        nombreCampo & "] " & _
        "FROM [" & _
        tabla & "]"


    Set rs = _
        cn.Execute(sql)


    CampoExisteEnAccess = True


    rs.Close

    Set rs = Nothing


    Exit Function


NoExiste:


    CampoExisteEnAccess = False


    On Error Resume Next


    If Not rs Is Nothing Then

        rs.Close

    End If


End Function


