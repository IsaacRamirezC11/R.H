Option Explicit

'==========================================================
' MODMODIFICAR
'==========================================================
'
' HOJA:
'   MODIFICAR
'
' TABLA ACCESS:
'   AHORRO_SOLIDARIO
'
' BUSQUEDA:
'   RFC
'   RFC_COMPLETO
'   CURP
'
' BUSQUEDA P:
'   C_B = P / P1 / P2 ... P10
'
'
' COLUMNAS:
'   A:AL = datos
'   AM = ID auxiliar de Access
'
' IMPORTANTE:
'
' - No se modifica la fila de encabezados.
' - No se copian encabezados como datos.
' - Los campos calculados no se toman de Access.
' - RFC_COMPLETO se calcula.
' - FECHA_APLICAR_AHORRO se calcula.
' - FECHA_HOY se calcula.
' - RESULTADO_ANALISIS se calcula.
' - Las formulas solamente se colocan en filas con resultados.
' - La busqueda NO modifica REGISTRAR.
'
'==========================================================


Private Const HOJA_MODIFICAR As String = "MODIFICAR"

Private Const TABLA_ACCESS As String = "AHORRO_SOLIDARIO"

Private Const FILA_ENCABEZADOS As Long = 8

Private Const FILA_INICIO As Long = 9

Private Const FILA_MAXIMA As Long = 5000

Private Const COLUMNA_INICIO As Long = 1

Private Const COLUMNA_FIN As Long = 38

' AM = 39
Private Const COLUMNA_ID_AUX As Long = 39


'==========================================================
' BUSCAR POR RFC / RFC_COMPLETO / CURP
'
' BUSCA EN ACCESS:
'   RFC
'   RFC + HOM
'   CURP
'
' IMPORTANTE:
'   NO UTILIZA Nz()
'   NO UTILIZA Trim() EN ACCESS
'   NO UTILIZA UCase() EN ACCESS
'
' RFC_COMPLETO NO ES UN CAMPO DE ACCESS.
' Se compara como:
'
' RFC + HOM
'
'==========================================================

Public Sub BuscarPorDatos()

    Dim ws As Worksheet

    Dim cn As Object
    Dim rs As Object

    Dim rfc As String
    Dim rfcCompleto As String
    Dim curp As String

    Dim condiciones As String
    Dim sql As String

    Dim cantidad As Long


    On Error GoTo ErrorHandler


    '======================================================
    ' HOJA MODIFICAR
    '======================================================

    Set ws = _
        ThisWorkbook.Worksheets( _
            HOJA_MODIFICAR)


    '======================================================
    ' OBTENER DATOS DE BUSQUEDA
    '======================================================

    rfc = _
        NormalizarTexto( _
            ws.Range("E3").Value)


    rfcCompleto = _
        NormalizarTexto( _
            ws.Range("E4").Value)


    curp = _
        NormalizarTexto( _
            ws.Range("E5").Value)


    '======================================================
    ' VALIDAR
    '======================================================

    If rfc = "" And _
       rfcCompleto = "" And _
       curp = "" Then


        MsgBox _
            "Ingresa al menos uno de los siguientes datos:" & _
            vbCrLf & vbCrLf & _
            "RFC" & _
            vbCrLf & _
            "RFC_COMPLETO" & _
            vbCrLf & _
            "CURP", _
            vbExclamation, _
            "BUSCAR"


        Exit Sub

    End If


    Application.ScreenUpdating = False

    Application.EnableEvents = False

    Application.StatusBar = _
        "Buscando registros..."


    '======================================================
    ' LIMPIAR RESULTADOS ANTERIORES
    '======================================================

    LimpiarResultados ws


    '======================================================
    ' CONEXION ACCESS
    '======================================================

    Set cn = _
        AbrirConexionAccess()


    If cn Is Nothing Then


        Err.Raise _
            vbObjectError + 4000, _
            "BuscarPorDatos", _
            "No se pudo abrir la conexión con Access."


    End If


    '======================================================
    ' CREAR CONDICIONES
    '======================================================

    condiciones = ""


    '======================================================
    ' BUSCAR POR RFC
    '
    ' Access:
    '
    ' RFC = texto exacto
    '
    '======================================================

    If rfc <> "" Then


        condiciones = _
            "[RFC]='" & _
            EscaparSQL(rfc) & "'"


    End If


    '======================================================
    ' BUSCAR POR RFC_COMPLETO
    '
    ' RFC_COMPLETO = RFC + HOM
    '
    ' Ejemplo:
    '
    ' RFC = CADJ850618
    ' HOM = UN2
    '
    ' RFC_COMPLETO:
    '
    ' CADJ850618UN2
    '
    '======================================================

    If rfcCompleto <> "" Then


        If condiciones <> "" Then

            condiciones = _
                condiciones & _
                " AND "

        End If


        condiciones = _
            condiciones & _
            "([RFC] & [HOM])='" & _
            EscaparSQL(rfcCompleto) & "'"


    End If


    '======================================================
    ' BUSCAR POR CURP
    '======================================================

    If curp <> "" Then


        If condiciones <> "" Then

            condiciones = _
                condiciones & _
                " AND "

        End If


        condiciones = _
            condiciones & _
            "[CURP]='" & _
            EscaparSQL(curp) & "'"


    End If


    '======================================================
    ' VALIDAR CONDICIONES
    '======================================================

    If condiciones = "" Then


        MsgBox _
            "No se pudo construir la búsqueda.", _
            vbExclamation, _
            "BUSCAR"


        GoTo Salir


    End If


    '======================================================
    ' CONSULTA
    '
    ' ORDEN:
    '
    ' AÑO más reciente
    ' QNA más reciente
    ' ID más reciente
    '
    '======================================================

    sql = _
        "SELECT * FROM [" & _
        TABLA_ACCESS & "] " & _
        "WHERE " & _
        condiciones & _
        " ORDER BY [AÑO] DESC, [QNA] DESC, [Id] DESC"


    '======================================================
    ' EJECUTAR
    '======================================================

    Set rs = _
        cn.Execute(sql)


    '======================================================
    ' ESCRIBIR RESULTADOS
    '======================================================

    cantidad = _
        EscribirResultados( _
            ws, _
            rs)


    '======================================================
    ' APLICAR FORMULAS
    '
    ' SOLO A LAS FILAS QUE REALMENTE ENCONTRAMOS.
    '======================================================

    If cantidad > 0 Then


        RellenarFormulasModificar _
            ws, _
            FILA_INICIO, _
            FILA_INICIO + cantidad - 1


    End If


    Application.Calculate


    '======================================================
    ' RESULTADO
    '======================================================

    If cantidad = 0 Then


        MsgBox _
            "NO SE ENCONTRARON REGISTROS." & _
            vbCrLf & vbCrLf & _
            "Datos utilizados para la búsqueda:" & _
            vbCrLf & _
            "RFC: " & rfc & _
            vbCrLf & _
            "RFC_COMPLETO: " & rfcCompleto & _
            vbCrLf & _
            "CURP: " & curp, _
            vbInformation, _
            "BUSCAR"


    Else


        MsgBox _
            "BUSQUEDA COMPLETADA." & _
            vbCrLf & vbCrLf & _
            "Registros encontrados: " & _
            cantidad, _
            vbInformation, _
            "BUSCAR"


    End If


Salir:

    On Error Resume Next


    If Not rs Is Nothing Then

        rs.Close

    End If


    If Not cn Is Nothing Then

        cn.Close

    End If


    Application.StatusBar = False

    Application.EnableEvents = True

    Application.ScreenUpdating = True


    Exit Sub


ErrorHandler:

    Application.StatusBar = False

    Application.EnableEvents = True

    Application.ScreenUpdating = True


    MsgBox _
        "ERROR DURANTE LA BUSQUEDA." & _
        vbCrLf & vbCrLf & _
        "Numero: " & _
        Err.Number & _
        vbCrLf & _
        "Descripcion: " & _
        Err.Description & _
        vbCrLf & vbCrLf & _
        "SQL utilizado:" & _
        vbCrLf & _
        sql, _
        vbCritical, _
        "ERROR DE BUSQUEDA"


    Resume Salir

End Sub


'==========================================================
' BUSCAR P / P1 / P2 / ... / P10
'
' BUSCA DIRECTAMENTE EN C_B
'
' NO UTILIZA Nz()
' NO UTILIZA Trim()
' NO UTILIZA UCase()
'
' ORDEN:
'   AÑO DESC
'   QNA DESC
'   ID DESC
'==========================================================

Public Sub BuscarPendientes()

    Dim ws As Worksheet

    Dim cn As Object
    Dim rs As Object

    Dim sql As String

    Dim cantidad As Long


    On Error GoTo ErrorHandler


    Set ws = _
        ThisWorkbook.Worksheets( _
            HOJA_MODIFICAR)


    '======================================================
    ' PREPARAR EXCEL
    '======================================================

    Application.ScreenUpdating = False

    Application.EnableEvents = False

    Application.StatusBar = _
        "Buscando registros pendientes..."


    '======================================================
    ' LIMPIAR RESULTADOS ANTERIORES
    '======================================================

    LimpiarResultados ws


    '======================================================
    ' CONECTAR CON ACCESS
    '======================================================

    Set cn = _
        AbrirConexionAccess()


    If cn Is Nothing Then

        Err.Raise _
            vbObjectError + 4001, _
            "BuscarPendientes", _
            "No se pudo abrir la conexión con Access."

    End If


    '======================================================
    ' CONSULTA
    '
    ' IMPORTANTE:
    '
    ' No utilizamos Nz().
    ' C_B es texto corto.
    '======================================================

    sql = _
        "SELECT * FROM [" & _
        TABLA_ACCESS & "] " & _
        "WHERE [C_B]='P' " & _
        "OR [C_B]='P1' " & _
        "OR [C_B]='P2' " & _
        "OR [C_B]='P3' " & _
        "OR [C_B]='P4' " & _
        "OR [C_B]='P5' " & _
        "OR [C_B]='P6' " & _
        "OR [C_B]='P7' " & _
        "OR [C_B]='P8' " & _
        "OR [C_B]='P9' " & _
        "OR [C_B]='P10' " & _
        "ORDER BY [AÑO] DESC, [QNA] DESC, [Id] DESC"


    '======================================================
    ' EJECUTAR
    '======================================================

    Set rs = _
        cn.Execute(sql)


    '======================================================
    ' ESCRIBIR RESULTADOS
    '======================================================

    cantidad = _
        EscribirResultados( _
            ws, _
            rs)


    '======================================================
    ' APLICAR FORMULAS SOLO A LOS RESULTADOS
    '======================================================

    If cantidad > 0 Then

        RellenarFormulasModificar _
            ws, _
            FILA_INICIO, _
            FILA_INICIO + cantidad - 1

    End If


    Application.Calculate


    '======================================================
    ' MENSAJE
    '======================================================

    If cantidad = 0 Then

        MsgBox _
            "NO SE ENCONTRARON REGISTROS PENDIENTES." & _
            vbCrLf & vbCrLf & _
            "Se buscaron:" & _
            vbCrLf & _
            "P" & _
            vbCrLf & _
            "P1 hasta P10", _
            vbInformation, _
            "P / PENDIENTES"

    Else

        MsgBox _
            "BUSQUEDA COMPLETADA." & _
            vbCrLf & vbCrLf & _
            "Registros encontrados: " & _
            cantidad, _
            vbInformation, _
            "P / PENDIENTES"

    End If


Salir:

    On Error Resume Next


    If Not rs Is Nothing Then

        rs.Close

    End If


    If Not cn Is Nothing Then

        cn.Close

    End If


    Application.StatusBar = False

    Application.EnableEvents = True

    Application.ScreenUpdating = True


    Exit Sub


ErrorHandler:

    Application.StatusBar = False

    Application.EnableEvents = True

    Application.ScreenUpdating = True


    MsgBox _
        "ERROR AL BUSCAR P / P1-P10." & _
        vbCrLf & vbCrLf & _
        "Numero: " & Err.Number & _
        vbCrLf & _
        "Descripcion: " & Err.Description & _
        vbCrLf & vbCrLf & _
        "SQL utilizado:" & vbCrLf & _
        sql, _
        vbCritical, _
        "ERROR"


    Resume Salir

End Sub


'==========================================================
' ESCRIBIR RESULTADOS
'
' IMPORTANTE:
'
' SOLO ESCRIBE EN FILAS DE DATOS.
'
' NUNCA ESCRIBE EN LA FILA 8.
'
' NO COPIA ENCABEZADOS.
'
' NO ESCRIBE CAMPOS CALCULADOS.
'==========================================================

Private Function EscribirResultados( _
    ByVal ws As Worksheet, _
    ByVal rs As Object) As Long


    Dim fila As Long

    Dim c As Long

    Dim campo As String

    Dim columna As Long

    Dim valor As Variant

    Dim cantidad As Long


    fila = FILA_INICIO


    If rs.EOF Then

        EscribirResultados = 0

        Exit Function

    End If


    Do While Not rs.EOF


        If fila > FILA_MAXIMA Then

            Exit Do

        End If


        '==================================================
        ' RECORRER CAMPOS DE ACCESS
        '==================================================

        For c = 0 To rs.Fields.Count - 1


            campo = _
                Trim$( _
                    CStr( _
                        rs.Fields(c).Name))


            '================================================
            ' ID
            '================================================

            If UCase$(campo) <> "ID" Then


                '================================================
                ' CAMPOS CALCULADOS
                '================================================

                If UCase$(campo) <> "RFC_COMPLETO" And _
                   UCase$(campo) <> "FECHA_APLICAR_AHORRO" And _
                   UCase$(campo) <> "FECHA_HOY" And _
                   UCase$(campo) <> "RESULTADO_ANALISIS" Then


                    '============================================
                    ' BUSCAR COLUMNA POR ENCABEZADO
                    '============================================

                    columna = _
                        BuscarColumna( _
                            ws, _
                            campo)


                    If columna > 0 Then


                        '========================================
                        ' OBTENER VALOR
                        '========================================

                        If IsNull( _
                            rs.Fields(c).Value) Then

                            valor = ""

                        Else

                            valor = _
                                rs.Fields(c).Value

                        End If


                        '========================================
                        ' ESCRIBIR
                        '========================================

                        If Not IsError(valor) Then

                            ws.Cells( _
                                fila, _
                                columna).Value = _
                                valor

                        End If


                    End If


                End If


            End If


        Next c


        '==================================================
        ' GUARDAR ID DE ACCESS EN AM
        '==================================================

        On Error Resume Next


        If Not IsNull( _
            rs.Fields("Id").Value) Then


            ws.Cells( _
                fila, _
                COLUMNA_ID_AUX).Value = _
                rs.Fields("Id").Value


        Else


            ws.Cells( _
                fila, _
                COLUMNA_ID_AUX).ClearContents


        End If


        On Error GoTo 0


        cantidad = _
            cantidad + 1


        fila = _
            fila + 1


        rs.MoveNext


    Loop


    EscribirResultados = cantidad


End Function

'==========================================================
' APLICAR MODIFICACION
'
' ACTUALIZA TODOS LOS REGISTROS CARGADOS EN MODIFICAR.
'
' NO IMPORTA DONDE ESTE SELECCIONADA LA CELDA.
'
' FILAS:
'   9 hasta la ultima fila con RFC.
'
' Cada fila debe tener su ID de Access en AM.
'
'==========================================================

Public Sub AplicarModificacion()

    Dim ws As Worksheet
    Dim cn As Object

    Dim ultimaFila As Long
    Dim fila As Long

    Dim id As Variant

    Dim sql As String
    Dim listaCampos As String

    Dim c As Long
    Dim campo As String
    Dim valor As Variant

    Dim cantidadEncontrados As Long
    Dim cantidadModificados As Long
    Dim cantidadSinID As Long

    Dim respuesta As VbMsgBoxResult


    On Error GoTo ErrorHandler


    '======================================================
    ' HOJA
    '======================================================

    Set ws = _
        ThisWorkbook.Worksheets( _
            HOJA_MODIFICAR)


    '======================================================
    ' BUSCAR ULTIMA FILA CON RFC
    '
    ' RFC está en F.
    '======================================================

    ultimaFila = _
        ws.Cells( _
            ws.Rows.Count, _
            "F").End(xlUp).Row


    '======================================================
    ' VALIDAR
    '======================================================

    If ultimaFila < FILA_INICIO Then

        MsgBox _
            "NO HAY REGISTROS PARA MODIFICAR.", _
            vbExclamation, _
            "MODIFICAR"

        Exit Sub

    End If


    '======================================================
    ' CONTAR REGISTROS CON ID
    '======================================================

    For fila = _
        FILA_INICIO To _
        ultimaFila


        If Trim$( _
            CStr( _
                ws.Cells( _
                    fila, _
                    6).Value)) <> "" Then


            cantidadEncontrados = _
                cantidadEncontrados + 1


            id = _
                ws.Cells( _
                    fila, _
                    COLUMNA_ID_AUX).Value


            If Trim$(CStr(id)) = "" Then

                cantidadSinID = _
                    cantidadSinID + 1

            End If


        End If


    Next fila


    '======================================================
    ' VALIDAR REGISTROS
    '======================================================

    If cantidadEncontrados = 0 Then

        MsgBox _
            "NO HAY REGISTROS PARA MODIFICAR.", _
            vbExclamation, _
            "MODIFICAR"

        Exit Sub

    End If


    If cantidadSinID > 0 Then

        MsgBox _
            "Hay " & _
            cantidadSinID & _
            " registro(s) sin ID de Access." & _
            vbCrLf & vbCrLf & _
            "Realiza nuevamente la búsqueda antes de modificar.", _
            vbExclamation, _
            "MODIFICAR"

        Exit Sub

    End If


    '======================================================
    ' CONFIRMAR
    '======================================================

    respuesta = _
        MsgBox( _
            "Se modificarán TODOS los registros cargados." & _
            vbCrLf & vbCrLf & _
            "Registros a modificar: " & _
            cantidadEncontrados & _
            vbCrLf & vbCrLf & _
            "¿Deseas continuar?", _
            vbYesNo + _
            vbQuestion + _
            vbDefaultButton2, _
            "CONFIRMAR MODIFICACION")


    If respuesta <> vbYes Then

        Exit Sub

    End If


    '======================================================
    ' PREPARAR EXCEL
    '======================================================

    Application.ScreenUpdating = False

    Application.EnableEvents = False

    Application.StatusBar = _
        "Aplicando modificaciones..."


    '======================================================
    ' CONEXION ACCESS
    '======================================================

    Set cn = _
        AbrirConexionAccess()


    If cn Is Nothing Then

        Err.Raise _
            vbObjectError + 4002, _
            "AplicarModificacion", _
            "No se pudo abrir la conexión con Access."

    End If


    '======================================================
    ' RECORRER TODOS LOS REGISTROS
    '======================================================

    For fila = _
        FILA_INICIO To _
        ultimaFila


        '==================================================
        ' SOLO PROCESAR FILAS QUE TENGAN RFC
        '==================================================

        If Trim$( _
            CStr( _
                ws.Cells( _
                    fila, _
                    6).Value)) <> "" Then


            '================================================
            ' ID DE ACCESS
            '================================================

            id = _
                ws.Cells( _
                    fila, _
                    COLUMNA_ID_AUX).Value


            '================================================
            ' CREAR LISTA SET
            '================================================

            listaCampos = ""


            '================================================
            ' RECORRER COLUMNAS A:AL
            '================================================

            For c = _
                COLUMNA_INICIO To _
                COLUMNA_FIN


                campo = _
                    Trim$( _
                        CStr( _
                            ws.Cells( _
                                FILA_ENCABEZADOS, _
                                c).Value))


                If campo <> "" Then


                    '========================================
                    ' NO MODIFICAR ID
                    '========================================

                    If UCase$(campo) <> "ID" Then


                        '====================================
                        ' NO MODIFICAR CAMPOS CALCULADOS
                        '====================================

                        If UCase$(campo) <> "RFC_COMPLETO" And _
                           UCase$(campo) <> "FECHA_APLICAR_AHORRO" And _
                           UCase$(campo) <> "FECHA_HOY" And _
                           UCase$(campo) <> "RESULTADO_ANALISIS" Then


                            '================================
                            ' VERIFICAR QUE EXISTA EN ACCESS
                            '================================

                            If CampoExisteEnAccess( _
                                cn, _
                                TABLA_ACCESS, _
                                campo) Then


                                valor = _
                                    ws.Cells( _
                                        fila, _
                                        c).Value


                                If listaCampos <> "" Then

                                    listaCampos = _
                                        listaCampos & ","

                                End If


                                '================================
                                ' CAMPO VACIO
                                '================================

                                If Trim$( _
                                    CStr(valor)) = "" Then


                                    listaCampos = _
                                        listaCampos & _
                                        "[" & campo & "]=Null"


                                Else


                                    '================================
                                    ' CAMPO CON VALOR
                                    '================================

                                    listaCampos = _
                                        listaCampos & _
                                        "[" & campo & "]='" & _
                                        EscaparSQL( _
                                            CStr(valor)) & _
                                        "'"


                                End If


                            End If


                        End If


                    End If


                End If


            Next c


            '================================================
            ' ACTUALIZAR ACCESS
            '================================================

            If listaCampos <> "" Then


                sql = _
                    "UPDATE [" & _
                    TABLA_ACCESS & "] " & _
                    "SET " & _
                    listaCampos & _
                    " WHERE [Id]=" & _
                    CLng(id)


                cn.Execute sql


                cantidadModificados = _
                    cantidadModificados + 1


            End If


        End If


        '==================================================
        ' ACTUALIZAR BARRA DE ESTADO
        '==================================================

        Application.StatusBar = _
            "Modificando registro " & _
            (fila - FILA_INICIO + 1) & _
            " de " & _
            cantidadEncontrados & "..."


    Next fila


    '======================================================
    ' RESTAURAR FORMULAS
    '======================================================

    If cantidadModificados > 0 Then


        RellenarFormulasModificar _
            ws, _
            FILA_INICIO, _
            ultimaFila


    End If


    Application.Calculate


    '======================================================
    ' MENSAJE FINAL
    '======================================================

    MsgBox _
        "MODIFICACION COMPLETADA." & _
        vbCrLf & vbCrLf & _
        "Registros encontrados: " & _
        cantidadEncontrados & _
        vbCrLf & _
        "Registros modificados: " & _
        cantidadModificados, _
        vbInformation, _
        "MODIFICAR"


Salir:

    On Error Resume Next


    If Not cn Is Nothing Then

        cn.Close

    End If


    Application.StatusBar = False

    Application.EnableEvents = True

    Application.ScreenUpdating = True


    Exit Sub


ErrorHandler:

    Application.StatusBar = False

    Application.EnableEvents = True

    Application.ScreenUpdating = True


    MsgBox _
        "ERROR AL APLICAR LAS MODIFICACIONES." & _
        vbCrLf & vbCrLf & _
        "Registro en fila: " & fila & _
        vbCrLf & _
        "Numero: " & Err.Number & _
        vbCrLf & _
        "Descripcion: " & Err.Description, _
        vbCritical, _
        "ERROR DE MODIFICACION"


    Resume Salir

End Sub


'==========================================================
' LIMPIAR MODIFICAR
'==========================================================

Public Sub LimpiarModificar()


    Dim ws As Worksheet

    Dim respuesta As VbMsgBoxResult


    On Error GoTo ErrorHandler


    Set ws = _
        ThisWorkbook.Worksheets( _
            HOJA_MODIFICAR)


    respuesta = _
        MsgBox( _
            "Se limpiarán los registros desde la fila 9." & _
            vbCrLf & vbCrLf & _
            "Las formulas se conservarán." & _
            vbCrLf & _
            "Los dropdowns se conservarán." & _
            vbCrLf & _
            "El formato se conservará." & _
            vbCrLf & vbCrLf & _
            "¿Deseas continuar?", _
            vbYesNo + _
            vbQuestion + _
            vbDefaultButton2, _
            "LIMPIAR MODIFICAR")


    If respuesta <> vbYes Then

        Exit Sub

    End If


    Application.ScreenUpdating = False

    Application.EnableEvents = False


    LimpiarResultados ws


    Application.Calculate


    Application.EnableEvents = True

    Application.ScreenUpdating = True


    MsgBox _
        "Los registros fueron limpiados." & _
        vbCrLf & vbCrLf & _
        "Las formulas permanecen listas.", _
        vbInformation, _
        "MODIFICAR"


    Exit Sub


ErrorHandler:


    Application.EnableEvents = True

    Application.ScreenUpdating = True


    MsgBox _
        "ERROR AL LIMPIAR MODIFICAR." & _
        vbCrLf & vbCrLf & _
        "Numero: " & Err.Number & _
        vbCrLf & _
        "Descripcion: " & Err.Description, _
        vbCritical, _
        "ERROR"


End Sub


'==========================================================
' LIMPIAR RESULTADOS
'
' IMPORTANTE:
'
' BORRA LOS DATOS DESDE LA FILA 9.
'
' NO BORRA:
' - ENCABEZADOS
' - FORMATO
' - DROPDOWNS
'
' LOS CAMPOS CALCULADOS SE LIMPIAN TAMBIEN.
' DESPUES SE PUEDEN VOLVER A GENERAR.
'==========================================================

Private Sub LimpiarResultados( _
    ByVal ws As Worksheet)


    Dim c As Long

    Dim encabezado As String


    '======================================================
    ' LIMPIAR TODAS LAS COLUMNAS DE DATOS
    '======================================================

    For c = _
        COLUMNA_INICIO To _
        COLUMNA_FIN


        encabezado = _
            UCase$( _
                Trim$( _
                    CStr( _
                        ws.Cells( _
                            FILA_ENCABEZADOS, _
                            c).Value)))


        '----------------------------------------------
        ' NO SE TOCA LA FILA 8.
        '----------------------------------------------

        ws.Range( _
            ws.Cells(FILA_INICIO, c), _
            ws.Cells(FILA_MAXIMA, c)).ClearContents


    Next c


    '======================================================
    ' LIMPIAR ID AUXILIAR
    '======================================================

    ws.Range( _
        ws.Cells(FILA_INICIO, COLUMNA_ID_AUX), _
        ws.Cells(FILA_MAXIMA, COLUMNA_ID_AUX)).ClearContents


End Sub

'==========================================================
' RESTAURAR FORMULAS EN MODIFICAR
'
' P = FECHA_SOLICITA_AHORRO_O_CUANDO_INGRESO
' Q = FECHA_APLICAR_AHORRO
' R = FECHA_HOY
' S = RESULTADO_ANALISIS
'
'==========================================================

Private Sub RellenarFormulasModificar( _
    ByVal ws As Worksheet, _
    ByVal filaInicio As Long, _
    ByVal filaFinal As Long)

    Dim colRFC As Long
    Dim colHOM As Long
    Dim colRFCCompleto As Long

    Dim colFechaAplicar As Long
    Dim colFechaHoy As Long
    Dim colResultado As Long

    Dim f As Long


    On Error GoTo ErrorHandler


    '======================================================
    ' VALIDAR FILAS
    '======================================================

    If filaInicio < FILA_INICIO Then

        filaInicio = FILA_INICIO

    End If


    If filaFinal < filaInicio Then

        Exit Sub

    End If


    '======================================================
    ' BUSCAR COLUMNAS POR ENCABEZADO
    '======================================================

    colRFC = _
        BuscarColumna( _
            ws, _
            "RFC")


    colHOM = _
        BuscarColumna( _
            ws, _
            "HOM")


    colRFCCompleto = _
        BuscarColumna( _
            ws, _
            "RFC_COMPLETO")


    colFechaAplicar = _
        BuscarColumna( _
            ws, _
            "FECHA_APLICAR_AHORRO")


    colFechaHoy = _
        BuscarColumna( _
            ws, _
            "FECHA_HOY")


    colResultado = _
        BuscarColumna( _
            ws, _
            "RESULTADO_ANALISIS")


    '======================================================
    ' COLUMNAS FIJAS DE FECHAS
    '
    ' En MODIFICAR:
    '
    ' P = 16
    ' Q = 17
    ' R = 18
    ' S = 19
    '
    ' Usamos P directamente porque el encabezado real es:
    '
    ' FECHA_SOLICITA_AHORRO_O_CUANDO_INGRESO
    '======================================================

    If colFechaAplicar = 0 Then

        colFechaAplicar = 17

    End If


    If colFechaHoy = 0 Then

        colFechaHoy = 18

    End If


    If colResultado = 0 Then

        colResultado = 19

    End If


    '======================================================
    ' RFC_COMPLETO
    '
    ' RFC + HOM
    '======================================================

    If colRFCCompleto > 0 And _
       colRFC > 0 And _
       colHOM > 0 Then


        For f = filaInicio To filaFinal


            ws.Cells( _
                f, _
                colRFCCompleto).FormulaLocal = _
                "=SI(O(" & _
                ws.Cells(f, colRFC).Address(False, False) & _
                "=""""," & _
                ws.Cells(f, colHOM).Address(False, False) & _
                "=""""),""""," & _
                ws.Cells(f, colRFC).Address(False, False) & _
                "&" & _
                ws.Cells(f, colHOM).Address(False, False) & _
                ")"


        Next f


    End If


    '======================================================
    ' FECHA_APLICAR_AHORRO
    '
    ' P = FECHA_SOLICITA_AHORRO_O_CUANDO_INGRESO
    '
    ' Q = P + 90
    '
    ' Fórmula:
    '
    ' =SI(P9="","",P9+90)
    '======================================================

    For f = filaInicio To filaFinal


        ws.Cells( _
            f, _
            colFechaAplicar).FormulaLocal = _
            "=SI(P" & _
            f & _
            "="""","""",P" & _
            f & _
            "+90)"


    Next f


    '======================================================
    ' FECHA_HOY
    '
    ' R = HOY()
    '======================================================

    For f = filaInicio To filaFinal


        ws.Cells( _
            f, _
            colFechaHoy).FormulaLocal = _
            "=HOY()"


    Next f


    '======================================================
    ' RESULTADO_ANALISIS
    '
    ' S = SI(R>=Q,...)
    '======================================================

    For f = filaInicio To filaFinal


        ws.Cells( _
            f, _
            colResultado).FormulaLocal = _
            "=SI(R" & _
            f & _
            ">=Q" & _
            f & _
            ",""APLICAR AHORRO"",""AUN NO SE PUEDE APLICAR AHORRO"")"


    Next f


    Exit Sub


ErrorHandler:

    MsgBox _
        "ERROR AL APLICAR LAS FORMULAS." & _
        vbCrLf & vbCrLf & _
        "Numero: " & Err.Number & _
        vbCrLf & _
        "Descripcion: " & Err.Description, _
        vbCritical, _
        "ERROR DE FORMULAS"

End Sub


'==========================================================
' BUSCAR COLUMNA POR ENCABEZADO
'==========================================================

Private Function BuscarColumna( _
    ByVal ws As Worksheet, _
    ByVal nombreCampo As String) As Long


    Dim c As Long

    Dim ultimaColumna As Long

    Dim encabezado As String


    ultimaColumna = _
        ws.Cells( _
            FILA_ENCABEZADOS, _
            ws.Columns.Count).End( _
                xlToLeft).Column


    For c = _
        COLUMNA_INICIO To _
        ultimaColumna


        encabezado = _
            UCase$( _
                Trim$( _
                    CStr( _
                        ws.Cells( _
                            FILA_ENCABEZADOS, _
                            c).Value)))


        If encabezado = _
           UCase$( _
               Trim$( _
                   nombreCampo)) Then


            BuscarColumna = c

            Exit Function


        End If


    Next c


    BuscarColumna = 0


End Function


'==========================================================
' COMPROBAR CAMPO EN ACCESS
'==========================================================

Private Function CampoExisteEnAccess( _
    ByVal cn As Object, _
    ByVal tabla As String, _
    ByVal nombreCampo As String) As Boolean


    Dim rs As Object

    Dim sql As String


    On Error GoTo NoExiste


    sql = _
        "SELECT TOP 1 [" & _
        nombreCampo & "] " & _
        "FROM [" & _
        tabla & "]"


    Set rs = _
        cn.Execute(sql)


    CampoExisteEnAccess = True


    rs.Close

    Set rs = Nothing


    Exit Function


NoExiste:


    CampoExisteEnAccess = False


    On Error Resume Next


    If Not rs Is Nothing Then

        rs.Close

    End If


End Function


'==========================================================
' CONVERTIR BUSQUEDAS A MAYUSCULAS
'==========================================================

Public Sub ConvertirBusquedasMayusculas()


    Dim ws As Worksheet


    On Error GoTo Salir


    Set ws = _
        ThisWorkbook.Worksheets( _
            HOJA_MODIFICAR)


    Application.EnableEvents = False


    ws.Range("E3").Value = _
        NormalizarTexto( _
            ws.Range("E3").Value)


    ws.Range("E4").Value = _
        NormalizarTexto( _
            ws.Range("E4").Value)


    ws.Range("E5").Value = _
        NormalizarTexto( _
            ws.Range("E5").Value)


Salir:


    Application.EnableEvents = True


End Sub


'==========================================================
' ESCAPAR TEXTO SQL
'==========================================================

Private Function EscaparSQL( _
    ByVal texto As String) As String


    EscaparSQL = _
        Replace( _
            texto, _
            "'", _
            "''")


End Function


'==========================================================
' NORMALIZAR TEXTO
'==========================================================

Private Function NormalizarTexto( _
    ByVal valor As Variant) As String


    If IsError(valor) Then


        NormalizarTexto = ""


    ElseIf IsNull(valor) Then


        NormalizarTexto = ""


    Else


        NormalizarTexto = _
            UCase$( _
                Trim$( _
                    CStr(valor)))


    End If


End Function


'==========================================================
' REACTIVAR EXCEL
'==========================================================

Public Sub ReactivarEventosModificar()


    Application.EnableEvents = True

    Application.ScreenUpdating = True

    Application.StatusBar = False

    Application.Calculation = _
        xlCalculationAutomatic


    MsgBox _
        "Excel fue reactivado correctamente.", _
        vbInformation, _
        "EXCEL"


End Sub


'==========================================================
' LIMPIAR CAMPOS DE BUSQUEDA
'
' E3 = RFC
' E4 = RFC_COMPLETO
' E5 = CURP
'
' SOLO LIMPIA LOS CAMPOS DE BUSQUEDA.
'==========================================================

Public Sub LimpiarCamposBusqueda()


    Dim ws As Worksheet


    On Error GoTo ErrorHandler


    Set ws = _
        ThisWorkbook.Worksheets( _
            HOJA_MODIFICAR)


    ws.Range("E3:E5").ClearContents


    Exit Sub


ErrorHandler:


    MsgBox _
        "ERROR AL LIMPIAR LOS CAMPOS DE BUSQUEDA." & _
        vbCrLf & vbCrLf & _
        "Numero: " & Err.Number & _
        vbCrLf & _
        "Descripcion: " & Err.Description, _
        vbCritical, _
        "LIMPIAR BUSQUEDA"


End Sub

