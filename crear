Option Compare Database
Option Explicit

Private Const TABLA As String = "AHORRO_SOLIDARIO"
Private Const FORMULARIO As String = "frmNuevoAhorro"


'==========================================================
' CREAR FORMULARIO PARA NUEVOS REGISTROS
'==========================================================

Public Sub CrearFormularioNuevoAhorro()

    On Error GoTo ErrorHandler

    Dim db As DAO.Database
    Dim td As DAO.TableDef
    Dim campo As DAO.Field

    Dim frm As Access.Form
    Dim ctl As Access.Control
    Dim etiqueta As Access.Control

    Dim nombreTemporal As String
    Dim nombreControl As String

    Dim x As Long
    Dim y As Long
    Dim contador As Long


    Set db = CurrentDb


    '------------------------------------------------------
    ' COMPROBAR QUE EXISTE LA TABLA
    '------------------------------------------------------

    Set td = db.TableDefs(TABLA)


    '------------------------------------------------------
    ' ELIMINAR FORMULARIO ANTERIOR
    '------------------------------------------------------

    On Error Resume Next

    DoCmd.Close acForm, FORMULARIO, acSaveNo
    DoCmd.DeleteObject acForm, FORMULARIO

    On Error GoTo ErrorHandler


    '------------------------------------------------------
    ' CREAR FORMULARIO
    '------------------------------------------------------

    Set frm = CreateForm

    nombreTemporal = frm.Name


    '------------------------------------------------------
    ' PROPIEDADES DEL FORMULARIO
    '------------------------------------------------------

    frm.Caption = "AHORRO SOLIDARIO - Nuevo registro"

    ' Formulario vinculado a la tabla
    frm.RecordSource = TABLA

    frm.DefaultView = 0

    frm.ViewsAllowed = 1

    frm.NavigationButtons = False

    frm.RecordSelectors = False

    frm.DividingLines = False

    frm.AutoCenter = True

    frm.AutoResize = False

    frm.Width = 12500

    frm.ScrollBars = 2

    '------------------------------------------------------
    ' MUY IMPORTANTE:
    '
    ' DataEntry = True hace que Access muestre solamente
    ' un registro NUEVO.
    '
    ' No aparecerán los registros existentes.
    '------------------------------------------------------

    frm.DataEntry = True


    '======================================================
    ' ENCABEZADO
    '======================================================

    Set etiqueta = CreateControl( _
        nombreTemporal, _
        acLabel, _
        acDetail, _
        , , _
        500, _
        300, _
        10500, _
        500)

    etiqueta.Caption = "NUEVO REGISTRO - AHORRO SOLIDARIO"

    etiqueta.FontSize = 18

    etiqueta.FontWeight = 700


    Set etiqueta = CreateControl( _
        nombreTemporal, _
        acLabel, _
        acDetail, _
        , , _
        500, _
        850, _
        10500, _
        350)

    etiqueta.Caption = _
        "Capture la información y presione GUARDAR para crear el registro."

    etiqueta.FontSize = 10


    '======================================================
    ' BOTÓN GUARDAR
    '======================================================

    Set ctl = CreateControl( _
        nombreTemporal, _
        acCommandButton, _
        acDetail, _
        , , _
        8500, _
        1250, _
        1500, _
        500)

    ctl.Name = "cmdGuardar"

    ctl.Caption = "GUARDAR"

    ctl.OnClick = "=GuardarNuevoAhorro()"


    '======================================================
    ' BOTÓN LIMPIAR
    '======================================================

    Set ctl = CreateControl( _
        nombreTemporal, _
        acCommandButton, _
        acDetail, _
        , , _
        10100, _
        1250, _
        1500, _
        500)

    ctl.Name = "cmdLimpiar"

    ctl.Caption = "LIMPIAR"

    ctl.OnClick = "=LimpiarNuevoAhorro()"


    '======================================================
    ' MENSAJE
    '======================================================

    Set etiqueta = CreateControl( _
        nombreTemporal, _
        acLabel, _
        acDetail, _
        , , _
        500, _
        1350, _
        7000, _
        350)

    etiqueta.Name = "lblEstado"

    etiqueta.Caption = "Formulario listo para capturar un nuevo registro."

    etiqueta.FontSize = 9


    '======================================================
    ' CREAR TODOS LOS CAMPOS DE LA TABLA
    '======================================================

    x = 500

    y = 2000

    contador = 0


    For Each campo In td.Fields


        '--------------------------------------------------
        ' COLUMNA
        '--------------------------------------------------

        If contador Mod 2 = 0 Then

            x = 500

        Else

            x = 6100

        End If


        '--------------------------------------------------
        ' FILA
        '--------------------------------------------------

        If contador > 0 And contador Mod 2 = 0 Then

            y = y + 700

        End If


        '--------------------------------------------------
        ' ETIQUETA
        '--------------------------------------------------

        Set etiqueta = CreateControl( _
            nombreTemporal, _
            acLabel, _
            acDetail, _
            , , _
            x, _
            y, _
            2200, _
            350)

        etiqueta.Caption = campo.Name

        etiqueta.FontSize = 8

        etiqueta.FontWeight = 700


        '--------------------------------------------------
        ' CAJA DE TEXTO
        '--------------------------------------------------

        nombreControl = "txtNuevo" & CStr(contador)


        Set ctl = CreateControl( _
            nombreTemporal, _
            acTextBox, _
            acDetail, _
            , , _
            x + 2300, _
            y - 40, _
            3000, _
            420)


        ctl.Name = nombreControl


        '--------------------------------------------------
        ' VINCULAR AL CAMPO REAL
        '--------------------------------------------------

        ctl.ControlSource = "[" & campo.Name & "]"


        ctl.FontSize = 9


        '--------------------------------------------------
        ' AUTONUMÉRICOS
        '
        ' Si el campo es Autonumérico, Access lo genera.
        ' No debe poder escribir el usuario.
        '--------------------------------------------------

        If (campo.Attributes And dbAutoIncrField) <> 0 Then

            ctl.Locked = True

            ctl.Enabled = False

        End If


        contador = contador + 1


    Next campo


    '======================================================
    ' ALTURA
    '======================================================

    frm.Section(acDetail).Height = y + 1000


    '======================================================
    ' GUARDAR FORMULARIO
    '======================================================

    DoCmd.Save acForm, nombreTemporal

    DoCmd.Close acForm, nombreTemporal, acSaveYes


    '======================================================
    ' RENOMBRAR
    '======================================================

    DoCmd.Rename FORMULARIO, acForm, nombreTemporal


    '======================================================
    ' ABRIR
    '======================================================

    DoCmd.OpenForm FORMULARIO, acNormal


    MsgBox _
        "Formulario creado correctamente." & vbCrLf & vbCrLf & _
        "Está listo para capturar nuevos registros.", _
        vbInformation, _
        "AHORRO SOLIDARIO"


    Exit Sub


'==========================================================
' ERROR
'==========================================================

ErrorHandler:

    MsgBox _
        "NO SE PUDO CREAR EL FORMULARIO." & vbCrLf & vbCrLf & _
        "Error: " & Err.Number & vbCrLf & _
        "Descripción: " & Err.Description, _
        vbCritical, _
        "AHORRO SOLIDARIO"

End Sub



'==========================================================
' GUARDAR NUEVO REGISTRO
'==========================================================

Public Function GuardarNuevoAhorro() As Boolean

    On Error GoTo ErrorHandler

    Dim frm As Form

    Set frm = Forms(FORMULARIO)


    '------------------------------------------------------
    ' VALIDAR RFC_COMPLETO
    '------------------------------------------------------

    If Trim(Nz(frm.Controls("RFC_COMPLETO").Value, "")) = "" Then

        MsgBox _
            "El campo RFC_COMPLETO es obligatorio.", _
            vbExclamation, _
            "AHORRO SOLIDARIO"

        frm.Controls("RFC_COMPLETO").SetFocus

        Exit Function

    End If


    '------------------------------------------------------
    ' VALIDAR CURP
    '------------------------------------------------------

    If Trim(Nz(frm.Controls("CURP").Value, "")) = "" Then

        MsgBox _
            "El campo CURP es obligatorio.", _
            vbExclamation, _
            "AHORRO SOLIDARIO"

        frm.Controls("CURP").SetFocus

        Exit Function

    End If


    '------------------------------------------------------
    ' COMPROBAR RFC DUPLICADO
    '------------------------------------------------------

    If DCount( _
        "*", _
        TABLA, _
        "[RFC_COMPLETO] = '" & _
        Replace(frm.Controls("RFC_COMPLETO").Value, "'", "''") & "'" _
        ) > 0 Then

        MsgBox _
            "Ya existe un registro con ese RFC_COMPLETO." & _
            vbCrLf & vbCrLf & _
            "No se creó el registro.", _
            vbExclamation, _
            "AHORRO SOLIDARIO"

        frm.Controls("RFC_COMPLETO").SetFocus

        Exit Function

    End If


    '------------------------------------------------------
    ' GUARDAR REGISTRO
    '------------------------------------------------------

    If frm.Dirty Then

        DoCmd.RunCommand acCmdSaveRecord

    End If


    '------------------------------------------------------
    ' MENSAJE
    '------------------------------------------------------

    MsgBox _
        "REGISTRO GUARDADO CORRECTAMENTE." & vbCrLf & vbCrLf & _
        "El formulario está listo para capturar otro registro.", _
        vbInformation, _
        "AHORRO SOLIDARIO"


    GuardarNuevoAhorro = True

    Exit Function


ErrorHandler:

    MsgBox _
        "NO SE PUDO GUARDAR EL REGISTRO." & vbCrLf & vbCrLf & _
        "Error: " & Err.Number & vbCrLf & _
        "Descripción: " & Err.Description, _
        vbCritical, _
        "AHORRO SOLIDARIO"

End Function



'==========================================================
' LIMPIAR FORMULARIO
'==========================================================

Public Function LimpiarNuevoAhorro() As Boolean

    On Error GoTo ErrorHandler

    Dim frm As Form

    Set frm = Forms(FORMULARIO)


    '------------------------------------------------------
    ' Si hay cambios sin guardar, preguntar
    '------------------------------------------------------

    If frm.Dirty Then

        If MsgBox( _
            "Hay información capturada." & vbCrLf & vbCrLf & _
            "¿Deseas borrar la captura actual?", _
            vbQuestion + vbYesNo, _
            "AHORRO SOLIDARIO") = vbNo Then

            Exit Function

        End If

        frm.Undo

    End If


    '------------------------------------------------------
    ' Ir a un registro nuevo
    '------------------------------------------------------

    DoCmd.GoToRecord , , acNewRec


    frm.Controls("lblEstado").Caption = _
        "Formulario listo para capturar un nuevo registro."


    LimpiarNuevoAhorro = True

    Exit Function


ErrorHandler:

    MsgBox _
        "NO SE PUDO LIMPIAR EL FORMULARIO." & vbCrLf & vbCrLf & _
        "Error: " & Err.Number & vbCrLf & _
        "Descripción: " & Err.Description, _
        vbCritical, _
        "AHORRO SOLIDARIO"

End Function



'==========================================================
' COMPROBAR SI EXISTE FORMULARIO
'==========================================================

Private Function ExisteFormulario(ByVal nombre As String) As Boolean

    Dim objeto As AccessObject

    ExisteFormulario = False

    For Each objeto In CurrentProject.AllForms

        If objeto.Name = nombre Then

            ExisteFormulario = True

            Exit Function

        End If

    Next objeto

End Function